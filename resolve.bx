// ============================================================================
// resolve.bx — the file-reading half, shared by every program that generates.
//
// **This exists because two programs did it separately and diverged within an hour.** The generator
// resolved component imports and emitted the runtime types; the checker did neither, so it reported
// `unknown type StarCmd` and `unknown block Badge` on components that generate perfectly. Both
// complaints were about the checker.
//
// `star.bx` reads no files — that is what keeps the generator's core testable and free of effects.
// Everything that touches the disk is here, so there is one implementation of "what a component's
// source actually is" rather than one per program.
// ============================================================================
use "star.bx";
use "std/files.bx";
use "std/string.bx";
use "std/os.bx";

// Every component a document imports, generated beside its own source, with what it declares.
//
// `written` decides whether the children's `.bx` and `.css` files are produced. The generator wants
// them; the checker does not — it only needs to know each child's props so a call can be built in the
// callee's order. Same walk either way, because a checker that resolved imports differently from the
// generator would pass documents the generator refuses.
// Could this import name a package? **A dependency name is letters, digits and `_`** — the compiler's
// own rule, since the name becomes the first segment of every import that reaches it. So a first
// segment carrying a dot, or an empty one from a leading slash, cannot be a package however it is
// spelled.
//
// Used for one thing only: deciding whether a FAILED import is worth blaming the compiler for.
// `./Card.sbmx` and `sub/Card.sbmx` are paths, were always paths, and a reader who mistyped one is not
// helped by being told about `burxt where`.
pure function star_looks_packaged(target: String) -> Bool {
    let mutable cut: Int = 0;
    while cut < len(target) && byte_at(target, cut) != 47 {
        cut += 1;
    }
    if cut == 0 || cut >= len(target) {
        return false;
    }
    let mutable i: Int = 0;
    while i < cut {
        let c: Int = byte_at(target, i);
        if !((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
            return false;
        }
        i += 1;
    }
    return true;
}

// **`touches commands, input` is here because resolving an import means ASKING THE COMPILER**, and that
// is a deliberate widening of a published name rather than a leak. `use "mylib/Card.sbmx"` names a
// package, and where a package sits on disk is derived from its source — under `.burxt/packages` beside
// a key made from url and tag for a git dependency, and nowhere near it for a path dependency. star
// re-deriving that would be a second implementation of somebody else's rule, on the path every build
// takes; `tools/surface.bx` already carries one such re-derivation and it cannot see path dependencies
// at all. So this shells out to `burxt where` and the effect says so.
//
// Nothing about a GENERATED component changes: star is a build-time dependency, and no component emits
// `use "star/star.bx"`. The widening reaches build tooling and stops there.
public function star_resolve(path: String, source: String, written: Bool) -> [StarKnown] touches files, commands, input {
    let mutable known: [StarKnown] = [];
    let here: String = star_directory_of(path);
    let imports: String = star_imports_of(star_section(source, "bx"));
    let mutable at: Int = 0;
    while at < len(imports) {
        let stop: Int = star_end_of_line(imports, at, len(imports));
        let line: String = substring(imports, at, stop - at);
        let target: String = star_quoted_path(line);
        if star_ends_with(target, ".sbmx") {
            // **The package is asked about FIRST, because that is the compiler's own precedence.** The
            // generated component carries this import onward, so if star resolved a name one way and the
            // compiler resolved it the other, a document would generate and then refuse to build — and
            // the message would be about a file nobody wrote. `burxt where` exits non-zero with EMPTY
            // stdout when the name is not a dependency, which is what makes "fall back to a path" safe
            // to decide on: there is nothing to misread.
            let asked: Capture = os_capture_status("burxt where " + file_quote(target));
            let answer: String = string_trim(asked.output);
            let packaged: Bool = asked.code == 0 && len(answer) > 0;
            let mutable child_path: String = here + target;
            // Where its generated `.bx` goes, and the stem the parent will import it by. A package
            // component is generated into the CONSUMER's tree: writing beside the source would put it
            // inside a fetched package, which is a cache keyed by url and tag, so the day the tag moves
            // the directory is renamed and everything star left there is orphaned rather than updated.
            // `.star/` rather than `<pkg>/` because a directory named after a dependency makes the
            // import ambiguous and the compiler refuses it by name — see `StarKnown`.
            let mutable stem: String = star_without_extension(target);
            if packaged {
                child_path = answer;
                stem = ".star/" + star_without_extension(target);
            }
            match file_read_maybe(child_path) {
                None => {
                    // Burxt's own message, passed through rather than reworded — it distinguishes a name
                    // that is not a dependency from one that is not fetched from a vendored directory
                    // that is simply absent, and only the last of those three is beyond `burxt fetch`.
                    // Rewording that would lose the distinction star did not make and cannot restore.
                    print_error("cannot read " + child_path + ", imported by " + path);
                    // **Three situations, and an exit status tells them apart from none of them.** A
                    // compiler with no `where` and a compiler refusing an undeclared name both exit 1
                    // with empty stdout, and they need opposite advice: update your toolchain, or fix
                    // your manifest. Telling somebody to check `burxt.package` when the command does
                    // not exist on their machine is the kind of message that costs an afternoon.
                    //
                    // The capability is read from the usage block, which names `burxt where` only on a
                    // compiler that has it — measured, one matching line against none. That block is
                    // also what the compiler's own CLI reference is generated from, so it cannot
                    // advertise a command that is not there. No version gate and no `--capabilities`
                    // flag: a second mechanism saying what this already says is the thing today was
                    // spent removing.
                    //
                    // Asked only on the way out, so a document that imports by path pays nothing.
                    if star_looks_packaged(target) {
                        let usage: Capture = os_capture_status("burxt");
                        if !star_mentions(usage.errors, "burxt where") {
                            print_error("  `" + target + "` names a package, and this `burxt` cannot"
                                + " resolve one — its usage does not list `burxt where`. Update the"
                                + " compiler; an import by path works on every version.");
                        } else {
                            if len(string_trim(asked.errors)) > 0 {
                                print_error("  " + string_trim(asked.errors));
                            }
                        }
                    }
                    exit(2);
                }
                Some(child) => {
                    let child_name: String = star_component_name(target);
                    match star_generate(child, star_function_name(child_name), []) {
                        Error(message) => {
                            print_error(message + "  (in " + child_path + ")");
                            exit(1);
                        }
                        Ok(built) => {
                            if written {
                                let out: String = here + stem + ".bx";
                                // `mkdir -p`, and only for a package component — a local one writes
                                // beside a source that already exists, so the directory does too.
                                if packaged {
                                    let made: Bool = file_make_directory(star_directory_of(out));
                                }
                                let wrote: Int = file_write(out,
                                    "// GENERATED from " + child_path + " by star-burxt. Do not edit.\n"
                                    + star_source_of(built, star_function_name(child_name)));
                                if !star_is_blank(built.style) {
                                    let styled: Int = file_write(here + stem + ".css", built.style);
                                }
                            }
                            let noted: Int = push(known, StarKnown {
                                name: child_name, props: built.props, source: stem,
                            });
                        }
                    }
                }
            }
        }
        at = stop + 1;
    }
    return known;
}
