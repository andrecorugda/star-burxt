// Every Burxt version this repository names, held to one floor and one current release.
//
//     burxt build tools/versions.bx -o star-versions
//     ./star-versions
//     ./star-versions --prove-it     # the negative control
//
// **Four places named a version and two disagreed, and nothing checked any of them.**
// `docs/install.md` promised *"1.3.0 or newer"*, `docs/_config.yml` said `1.3.0`,
// `.github/workflows/site.yml` installed **1.3.0** and `.github/workflows/star.yml` installed
// **1.4.0** — a difference with no stated reason, which is drift rather than design. And the floor was
// prose: **no 1.3.0 tarball was ever built against**, so the one number a reader acts on could have
// been false for two minor versions and nothing would have said so.
//
// The language session's framing is why this is small rather than a project: *"the honest way to verify
// a floor is to build against the old tarball, not to raise the number."* A floor is a capability claim,
// and a capability claim nothing exercises cannot fail for the reason it exists.
//
// ---- two numbers, two jobs, each named once ------------------------------------------------------
//
//   THE FLOOR      `docs/_config.yml`'s `star_requires` — the minimum a reader is promised. The site
//                  reads it, `docs/install.md` states it in prose, and `star.yml` builds against it on
//                  every push so the promise is exercised rather than asserted.
//
//   THE CURRENT    `BURXT_VERSION` in both workflows — the newest release, which is what a reader
//                  actually installs today. **Both workflows must carry the same number**, because two
//                  "current" values is the disagreement this file exists to end.
//
// So the floor and the current are allowed to differ — that is the point — and everything claiming to
// be one of them must agree with everything else claiming to be the same one.
use "std/files.bx";
use "std/string.bx";
use "std/os.bx";

pure function contains(haystack: String, needle: String) -> Bool {
    return string_find(haystack, needle) >= 0;
}

// The value of a `key: "value"` line, quotes stripped. Enough for a YAML scalar and no more — this
// repository has no YAML parser and does not need one.
pure function scalar(text: String, key: String) -> String allocates {
    let rows: [String] = string_lines(text);
    let mutable i: Int = 0;
    while i < len(rows) {
        let line: String = string_trim(rows[i]);
        if string_starts_with(line, key) {
            let after: String = string_trim(substring(line, len(key), len(line) - len(key)));
            let mutable out: String = after;
            if string_starts_with(out, ":") { out = string_trim(substring(out, 1, len(out) - 1)); }
            let mutable clean: String = "";
            let mutable c: Int = 0;
            while c < len(out) {
                let ch: String = substring(out, c, 1);
                if ch != "\"" && ch != "'" { clean = clean + ch; }
                c += 1;
            }
            return string_trim(clean);
        }
        i += 1;
    }
    return "";
}

// The version in `**Burxt X or newer.**`, which is the sentence a reader acts on.
pure function prose_floor(text: String) -> String allocates {
    let marker: String = "**Burxt ";
    let at: Int = string_find(text, marker);
    if at < 0 { return ""; }
    let from: Int = at + len(marker);
    let mutable stop: Int = from;
    while stop < len(text) && substring(text, stop, 1) != " " { stop += 1; }
    return substring(text, from, stop - from);
}

// `a >= b` over `major.minor.patch`. A string comparison would put 1.10.0 below 1.4.0.
pure function at_least(a: String, b: String) -> Bool {
    let x: [String] = string_split(a, ".");
    let y: [String] = string_split(b, ".");
    let mutable i: Int = 0;
    while i < 3 {
        let mutable p: Int = 0;
        let mutable q: Int = 0;
        if i < len(x) { p = string_to_int(x[i], 0); }
        if i < len(y) { q = string_to_int(y[i], 0); }
        if p > q { return true; }
        if p < q { return false; }
        i += 1;
    }
    return true;
}

// **This was `false`, and the header above it advertised `--prove-it`.** A negative control that
// cannot fail is worse than none: the flag ran, the tool printed its success line, and the exit status
// said the control had held. It was written as a placeholder and read as a check for a day.
//
// The plant is the floor as a reader is told it, one character off — the disagreement between prose and
// configuration that this whole file exists to catch — so the control exercises the comparison rather
// than a counter.
let prove: Bool = os_arg_count() > 1 && os_arg(1) == "--prove-it";

let config: String = file_read("docs/_config.yml");
let install: String = file_read("docs/install.md");
let star_ci: String = file_read(".github/workflows/star.yml");
let site_ci: String = file_read(".github/workflows/site.yml");

let floor: String = scalar(config, "star_requires");
let mutable stated: String = prose_floor(install);
let floor_ci: String = scalar(star_ci, "BURXT_FLOOR");
let star_pin: String = scalar(star_ci, "BURXT_VERSION");
let site_pin: String = scalar(site_ci, "BURXT_VERSION");

if prove {
    stated = stated + ".1";
}

let mutable failures: [String] = [];

if len(floor) == 0 {
    let a: Int = push(failures, "docs/_config.yml declares no `star_requires`, so nothing else has a"
        + " floor to agree with");
}

// **The sentence a reader acts on, against the value the site is configured with.** These are two
// files and they can disagree, which is the whole reason this check exists.
if len(floor) > 0 && stated != floor {
    let b: Int = push(failures, "docs/install.md promises `Burxt " + stated + " or newer` and"
        + " docs/_config.yml says the floor is `" + floor + "`. One of them is what a reader installs"
        + " and the other is what the site believes");
}

// The floor CI builds against must be the floor that is advertised, or the test proves a number
// nobody was promised.
if len(floor) > 0 && floor_ci != floor {
    let c: Int = push(failures, ".github/workflows/star.yml builds the floor test against `" + floor_ci
        + "` and the advertised floor is `" + floor + "`. A floor test on the wrong release exercises"
        + " nothing anybody was told");
}

// **One current number.** Two workflows installing different releases is the drift this file ends.
if star_pin != site_pin {
    let d: Int = push(failures, "star.yml installs `" + star_pin + "` and site.yml installs `"
        + site_pin + "`. The floor and the current are allowed to differ; two currents are not — a"
        + " difference with no stated reason is drift, and it went two minor versions unnoticed");
}

if len(floor) > 0 && !at_least(star_pin, floor) {
    let e: Int = push(failures, "CI installs `" + star_pin + "`, which is below the advertised floor `"
        + floor + "`");
}

if prove {
    if len(failures) == 0 {
        print("CONTROL FAILED: a planted floor of `" + stated + "` was not reported as a disagreement");
        exit(1);
    }
    print("control held: the planted floor `" + stated + "` was reported");
    exit(0);
}

// ---- and the prose that states them, which decays exactly like a comment ---------------------------
//
// **This was live when the check was written.** `CLAUDE.md` said *"this SUITE needs 1.5.0"* and
// *"currently 1.5.0"* while the pin had moved to 1.6.0 and then 1.7.0 — stale through two upgrades,
// hand-edited each time, and nothing looked. That is the same failure as a stale comment and it is worse
// than one, because a recorded MEASUREMENT reads as evidence: the four other places this file already
// holds together were all correct, and the sentence a reader starts from was not.
//
// The distinction that makes it checkable without a list is in the prose itself. A live claim says
// **needs** or **currently**; a historical one says *carried*, *the published*, *tarball*. And within
// `needs`, the floor announces itself as *"or newer"* — which is exactly what a floor means and exactly
// how `docs/install.md` phrases it. So:
//
//     "a component needs 1.3.0 or newer"   -> the FLOOR
//     "this SUITE needs 1.7.0"             -> the CURRENT
//     "currently 1.7.0"                    -> the CURRENT
//     "1.6.0 carried inflate.bx"           -> history, and not this file's business
//
// The alternative was marking the live claims with a sentinel, which is what `not-burxt:` does and what
// BMX's changelog does by declaring itself historical. Reading the wording is better here because the
// wording is already load-bearing: a sentence that says "needs" is making the claim.
let readme: String = file_read("CLAUDE.md");

// The `major.minor.patch` at `from`, or "" if there is not one.
pure function version_at(text: String, from: Int) -> String allocates {
    let mutable stop: Int = from;
    let mutable dots: Int = 0;
    while stop < len(text) {
        let c: String = substring(text, stop, 1);
        if c == "." {
            dots += 1;
            stop += 1;
        } else {
            if string_find("0123456789", c) >= 0 {
                stop += 1;
            } else {
                stop = stop;
                break;
            }
        }
    }
    if dots != 2 || stop == from {
        return "";
    }
    return substring(text, from, stop - from);
}

// Every claim introduced by `marker`, checked against `want` — except that a `needs` claim followed by
// "or newer" is a floor claim and is checked against the floor instead.
function claims(text: String, marker: String, want: String, floor_value: String,
        mutable problems: [String]) -> Int allocates {
    let mutable found: Int = 0;
    let mutable at: Int = 0;
    while at < len(text) {
        let hit: Int = string_find_from(text, marker, at);
        if hit < 0 {
            at = len(text);
        } else {
            let from: Int = hit + len(marker);
            let stated: String = version_at(text, from);
            if len(stated) > 0 {
                found += 1;
                let after: String = substring(text, from + len(stated),
                    len(text) - from - len(stated));
                let mutable expected: String = want;
                let mutable which: String = "the current";
                if string_starts_with(after, " or newer") {
                    expected = floor_value;
                    which = "the floor";
                }
                if stated != expected {
                    let x: Int = push(problems, "CLAUDE.md says `" + marker + stated
                        + "` and " + which + " is `" + expected
                        + "` — a recorded measurement decays exactly like a comment, and this one reads"
                        + " as evidence");
                }
            }
            at = from + 1;
        }
    }
    return found;
}

let mutable prose: [String] = [];
let needs: Int = claims(readme, "needs ", star_pin, floor, prose);
let now: Int = claims(readme, "currently ", star_pin, floor, prose);

// **Zero is not a pass.** If the phrasing changes, this reports nothing wrong out of nothing looked at.
if needs + now == 0 {
    let z: Int = push(failures, "CLAUDE.md states no version with `needs` or `currently`, so this gate"
        + " checked nothing — the phrasing it reads has changed");
}
let mutable pr: Int = 0;
while pr < len(prose) {
    let x: Int = push(failures, prose[pr]);
    pr += 1;
}

print(to_string(len(failures)) + " problem(s) in the versions this repository names");
if len(failures) > 0 {
    let mutable f: Int = 0;
    while f < len(failures) {
        print("  " + failures[f]);
        f += 1;
    }
    exit(1);
}
print("  floor   " + floor + "   advertised, configured, and built against on every push");
print("  current " + star_pin + "   installed by both workflows");
