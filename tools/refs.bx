// Every git ref the documentation tells a reader to depend on must exist.
//
//     burxt build tools/refs.bx -o star-refs
//     ./star-refs
//
// **The README told readers to depend on `v0.2.0`, a tag that did not exist**, while the install page
// said `v0.1.0` — so one instruction fails to fetch and the other fetches a framework 55 commits behind
// that cannot read a single example on the site. Two pages, two answers, neither true.
//
// BMX found the same family by grepping their own claims of absence: a README saying the format was 0.4
// when it was 0.11, and a page listing *"what exists as of 0.2"* frozen before four features shipped.
// **A version claim is a claim like any other, and nothing was checking these.**
//
// It greps for the SHAPE of a dependency line rather than keeping a list of files, because a registry
// cannot see an instruction added somewhere new.
//
// ---- and it was Python until Andre's directive ---------------------------------------------------
//
// This was seventy-five lines of Python doing nothing Python was needed for: walk files, match a
// pattern, run `git rev-parse`. `lib/files.bx`, `lib/string.bx` and `lib/os.bx` do all three. Andre's
// instruction was the whole reason it moved — *"I will not accept a language that really depends on
// another language"* — and the port is the argument: if a language cannot check its own repository, a
// reader is right to doubt it can check theirs.
//
// **The pattern is matched by hand rather than by a regular expression, because Burxt has none.** That
// is a genuine difference from the Python and worth stating: three words after `dependency`, split on
// whitespace. It is *less* clever and it refuses a malformed line instead of silently not matching one,
// which is the better failure for a check whose whole job is noticing a line nobody verified.
use "std/files.bx";
use "std/string.bx";
use "std/os.bx";

pure function contains(haystack: String, needle: String) -> Bool {
    return string_find(haystack, needle) >= 0;
}

pure function skipped(path: String) -> Bool {
    return contains(path, "/.git/") || contains(path, "/.burxt/")
        || contains(path, "/node_modules/") || contains(path, "/__pycache__/");
}

// `file_walk` answers `./docs/x.md`; a path a reader pastes into an editor should not carry the `./`.
pure function shown(path: String) -> String {
    if string_starts_with(path, "./") { return substring(path, 2, len(path) - 2); }
    return path;
}

pure function watched(path: String) -> Bool {
    return string_ends_with(path, ".md") || string_ends_with(path, ".package");
}

// Does this ref exist in the repository it names?
//
// Local refs only, and `origin/` for a branch. A remote lookup would make this depend on the network,
// and **a check that cannot run offline is a check that gets skipped.**
function resolves(ref: String) -> Bool touches commands, files, input {
    let mutable tries: [String] = [];
    let a: Int = push(tries, ref);
    let b: Int = push(tries, "refs/tags/" + ref);
    let c: Int = push(tries, "origin/" + ref);
    let mutable i: Int = 0;
    while i < len(tries) {
        let asked: Capture = os_capture_status(
            "git rev-parse --verify --quiet " + file_quote(tries[i]));
        if asked.code == 0 { return true; }
        i += 1;
    }
    return false;
}

let mutable wrong: [String] = [];
let mutable checked: Int = 0;

match file_walk(".") {
    None => {
        print_error("cannot walk this directory");
        exit(2);
    }
    Some(paths) => {
        let mutable p: Int = 0;
        while p < len(paths) {
            let path: String = paths[p];
            if !skipped(path) && watched(path) {
                let rows: [String] = string_lines(file_read(path));
                let mutable r: Int = 0;
                while r < len(rows) {
                    let line: String = string_trim(rows[r]);
                    if string_starts_with(line, "dependency") {
                        let words: [String] = string_split_space(line);
                        if len(words) == 4 {
                            let url: String = words[2];
                            let ref: String = words[3];
                            // Only this project's own refs can be checked without a network.
                            if contains(url, "star-burxt") {
                                checked += 1;
                                if !resolves(ref) {
                                    let x: Int = push(wrong, shown(path) + ":" + to_string(r + 1)
                                        + " tells a reader to depend on `" + ref
                                        + "`, which does not exist");
                                }
                            }
                        }
                    }
                    r += 1;
                }
            }
            p += 1;
        }
    }
}

// ---- and every path the documentation tells a reader to TYPE ---------------------------------------
//
// The same rule as above with a different noun: a git ref a page says to depend on must exist, and so
// must a file a page says to run. The language session asked for this after moving their PNG codec out
// of `scripts/editor-icons.bx` and leaving test messages that told a reader to edit a file which no
// longer held the code.
//
// **Measured first, because the obvious version of it does not work.** Grepping every backticked path in
// this repository gives 35 that do not resolve, and most of them are correct: other repositories' files
// (`lib/inflate.bx`, `bmx/burxt/bmx.bx`), documentation placeholders (`examples/X.sbmx`), and **history**
// — a sentence saying `tools/gallery.mjs` claimed a browser made it unportable is true and names a file
// that is deliberately gone. Their rule is the one that separates those: *a dated past-tense measurement
// cannot decay; a present-tense one is a spec with no runner.* A checker cannot read tense.
//
// So this checks the subset where the distinction collapses: **a path in RUNNABLE position.** A reader
// types it, so it either works or it wastes their time — there is no past tense in a command. Prose is
// left to the author, which is where the judgement belongs.
//
// It found three when it was written, all from the same day's ports, and one of them was
// a `python3 tests/extension.py` invocation in the section explaining how to run a negative control —
// **and naming that control's flag here turned this file red**, because `star-controls` reads a file's
// own prose to decide whether it advertises one. Using versus mentioning, fourth time in a day, and the
// check was right: this file did name the flag. The policy is the one `tests/extension.bx` records —
// describe the token, never write it. An
// instruction, in the document a new reader follows, for a file that had been Burxt for six hours.
let mutable typed: Int = 0;
let mutable broken: [String] = [];
let mutable owned: [String] = [];
// Every literal `{` in a string is `\{`, including inside an awk program — the compiler reads the
// unescaped one as an interpolation and reports `expected an expression, found print`.
let dirs: Capture = os_capture_status("git ls-files | cut -s -d/ -f1 | sort -u");
let dir_rows: [String] = string_lines(dirs.output);
let mutable d: Int = 0;
while d < len(dir_rows) {
    let name: String = string_trim(dir_rows[d]);
    if len(name) > 0 {
        let x: Int = push(owned, name);
    }
    d += 1;
}

// **Runnable means an interpreter or `./` in front of it, ON ANY LINE** — backticked spans and fenced
// blocks alike. The first version read only backticked spans, and its own zero-guard caught that: after
// the three stale references were fixed, every remaining runnable path was either inside a ```sh block
// or a top-level binary with no directory, so it reported "nothing to check" rather than a false pass.
// **That guard is the only reason I noticed the predicate was too narrow to be worth having.**
//
// The top-level directories come from the tree rather than a list, so a directory added tomorrow is
// covered and another repository's `lib/` is not.
// **Every page a reader follows, not just CLAUDE.md.** The language session ran this predicate against
// their tree and found the class I could not have seen in one repository: a documented command for a
// HYPOTHETICAL user's project — `burxt build src/main.bx` in a comment about walking up to find a
// manifest. `src/` is a top-level directory there, so the ownership filter admits it, and structurally
// `src/main.bx` in a user's tree and `src/main.bx` in theirs are the same string. **That class is not
// decidable**: a checker cannot read whose project it is any more than it can read tense.
//
// Measured here before extending: `docs/` names exactly one runnable path this repository does not own
// (`bmx/burxt/bmx.bx`, correctly skipped) and none it does. So the class is absent today — and only
// because no top-level directory here collides with a plausible project layout, which is luck rather
// than design. `examples/` and `tests/` are perfectly ordinary names in somebody else's tree.
//
// **When it does fire falsely, the fix is the prose, not an exclusion.** A command meant for a reader's
// project should name a placeholder that is visibly one — `<your-component>.sbmx` — because a reader
// following a real-looking path into a repository that does not have it is the same wasted trip this
// gate exists to prevent. A list of permitted absences is the thing both of us have spent the day
// arguing falls behind.
let mutable pages: [String] = [];
let pg1: Int = push(pages, "CLAUDE.md");
let listing2: Capture = os_capture_status("git ls-files 'docs/*.md'");
let doc_rows: [String] = string_lines(listing2.output);
let mutable dr: Int = 0;
while dr < len(doc_rows) {
    let name: String = string_trim(doc_rows[dr]);
    if len(name) > 0 {
        let x: Int = push(pages, name);
    }
    dr += 1;
}

let mutable page_at: Int = 0;
while page_at < len(pages) {
let doc: String = file_read(pages[page_at]);
let rows: [String] = string_lines(doc);
let mutable leads: [String] = [];
let l1: Int = push(leads, "python3 ");
let l2: Int = push(leads, "node ");
let l3: Int = push(leads, "bash ");
let l4: Int = push(leads, "sh ");
let l5: Int = push(leads, "./");

let mutable row: Int = 0;
while row < len(rows) {
    let line: String = rows[row];
    let mutable k: Int = 0;
    while k < len(leads) {
        let mutable at: Int = 0;
        while at < len(line) {
            let hit: Int = string_find_from(line, leads[k], at);
            if hit < 0 {
                at = len(line);
            } else {
                let from: Int = hit + len(leads[k]);
                let mutable stop: Int = from;
                while stop < len(line) {
                    let c: String = substring(line, stop, 1);
                    if c == " " || c == "`" || c == "\t" {
                        stop = stop;
                        break;
                    }
                    stop += 1;
                }
                let path: String = substring(line, from, stop - from);
                let slash: Int = string_find(path, "/");
                if slash > 0 {
                    let root: String = substring(path, 0, slash);
                    let mutable ours: Bool = false;
                    let mutable o: Int = 0;
                    while o < len(owned) {
                        if owned[o] == root {
                            ours = true;
                        }
                        o += 1;
                    }
                    if ours {
                        typed += 1;
                        if !file_exists(path) {
                            let x: Int = push(broken, pages[page_at] + " tells a reader to run `"
                                + leads[k] + path + "` and that file does not exist — an instruction"
                                + " has no past tense, so this one is simply wrong");
                        }
                    }
                }
                at = from + 1;
            }
        }
        k += 1;
    }
    row += 1;
}
page_at += 1;
}
if typed == 0 {
    let z: Int = push(wrong, "no page names a runnable path under a directory this repository owns,"
        + " so that half of this gate checked nothing — the phrasing it reads has changed");
}
let mutable b: Int = 0;
while b < len(broken) {
    let x: Int = push(wrong, broken[b]);
    b += 1;
}

// **A suite that found nothing is not a suite that passed.** If the pattern stops matching — a
// dependency line respelled, a walk that lost its root — this reports zero problems out of zero
// claims, which reads exactly like success.
if checked == 0 {
    print("no `dependency star …` line found anywhere — the pattern has stopped matching");
    exit(1);
}
if len(wrong) > 0 {
    print(to_string(len(wrong)) + " problem(s):");
    let mutable w: Int = 0;
    while w < len(wrong) {
        print("  " + wrong[w]);
        w += 1;
    }
    exit(1);
}
print(to_string(checked) + " dependency ref(s) and " + to_string(typed)
    + " runnable path(s) named by the documentation, all of which exist");
