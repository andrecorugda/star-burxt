// A PNG, decoded to pixels.
//
//     use "tools/png.bx";
//     let mutable pixels: [Int] = [];
//     let image: Png = png_read(bytes, pixels);
//
// **Built once, alone, before its callers** — which is this repository's rule for a shared dependency,
// learned when three decoders were written against a bit reader that did not exist yet and did not
// conflict in git while disagreeing in semantics. Two checks need a PNG's pixels and neither should
// carry a decoder: `tools/gallery.bx` asks whether the bottom band of a capture is background, and the
// editor's icon check asks what fraction of a box the ink fills.
//
// **This was impossible here until Burxt 1.6.0 and it is three calls now.** `zlib_into` does the whole
// compressed stream; what is left is the part a zlib library never does for you.
//
// ---- the two things a PNG makes you get right ----------------------------------------------------
//
// **Every IDAT is concatenated BEFORE a single inflate.** A PNG may split its zlib stream across any
// number of chunks at any byte boundary — Chrome's encoder uses five for a 1120x620 capture — so
// inflating chunk by chunk is wrong on exactly the files that have more than one, and right on the
// small ones you test with.
//
// **And the raster is FILTERED.** Each row carries a leading byte naming one of five predictors, and
// the row's bytes are differences from that prediction rather than pixels. A decoder that skips this
// gets an image that is recognisable and wrong — which is worse than a broken one, because it looks
// like a decode.
use "std/inflate.bx";

class Png {
    width: Int,
    height: Int,
    channels: Int,
    // The zlib return, or a negative refusal. `stride` is a row's bytes WITHOUT the filter byte.
    code: Int,
    stride: Int,
}

pure function png_be32(bytes: [Int], at: Int) -> Int {
    return bytes[at] * 16777216 + bytes[at + 1] * 65536 + bytes[at + 2] * 256 + bytes[at + 3];
}

// `IDAT` as four numbers. Comparing bytes needs no string building, which a `pure function` cannot
// return anyway.
pure function png_is_idat(bytes: [Int], at: Int) -> Bool {
    return bytes[at] == 73 && bytes[at + 1] == 68 && bytes[at + 2] == 65 && bytes[at + 3] == 84;
}

pure function png_channels(colour: Int) -> Int {
    if colour == 0 { return 1; }
    if colour == 2 { return 3; }
    if colour == 3 { return 1; }
    if colour == 4 { return 2; }
    if colour == 6 { return 4; }
    return 0;
}

pure function png_abs(x: Int) -> Int {
    if x < 0 { return 0 - x; }
    return x;
}

// The Paeth predictor: whichever of left, above and above-left is nearest to `a + b - c`.
pure function png_paeth(a: Int, b: Int, c: Int) -> Int {
    let p: Int = a + b - c;
    let pa: Int = png_abs(p - a);
    let pb: Int = png_abs(p - b);
    let pc: Int = png_abs(p - c);
    if pa <= pb && pa <= pc { return a; }
    if pb <= pc { return b; }
    return c;
}

// The unfiltered raster, row-major, with no filter bytes. `Png.code` is the zlib return or negative.
function png_read(bytes: [Int], mutable pixels: [Int]) -> Png allocates {
    // **The signature, first, because nothing else here is a check that this is a PNG.** This read
    // width and height straight off bytes 16..24, so ten arbitrary bytes were "too short" and thirty
    // arbitrary bytes were a picture with garbage dimensions. The language session's decoder answers
    // `the eight-byte PNG signature does not match` for the first case, and comparing notes is what
    // showed mine could not distinguish a wrong file from a short one.
    if len(bytes) < 8 {
        return Png { width: 0, height: 0, channels: 0, code: -4, stride: 0 };
    }
    if bytes[0] != 137 || bytes[1] != 80 || bytes[2] != 78 || bytes[3] != 71
        || bytes[4] != 13 || bytes[5] != 10 || bytes[6] != 26 || bytes[7] != 10 {
        return Png { width: 0, height: 0, channels: 0, code: -4, stride: 0 };
    }
    if len(bytes) < 26 {
        return Png { width: 0, height: 0, channels: 0, code: -1, stride: 0 };
    }
    let width: Int = png_be32(bytes, 16);
    let height: Int = png_be32(bytes, 20);
    let channels: Int = png_channels(bytes[25]);
    if channels == 0 || width <= 0 || height <= 0 {
        return Png { width: width, height: height, channels: channels, code: -2, stride: 0 };
    }

    // **A chunk's declared length is not a promise, and this trapped before it was bounded.** A
    // truncated PNG — the back half of a download, the front half of a write that died — reaches here
    // with a header claiming more bytes than the file holds, and the copy loop ran straight off the end:
    // `index 43 is out of bounds`, a crash instead of a refusal. `tests/pixels.bx` found it by handing
    // the decoder the first half of a file it had just built, which is the cheapest possible corruption
    // and the one a test is least likely to think of.
    let mutable stream: [Int] = [];
    let mutable at: Int = 8;
    let mutable truncated: Bool = false;
    while at + 8 <= len(bytes) && !truncated {
        let length: Int = png_be32(bytes, at);
        if length < 0 || at + 12 + length > len(bytes) {
            truncated = true;
        } else {
            if png_is_idat(bytes, at + 4) {
                let mutable i: Int = 0;
                while i < length {
                    let x: Int = push(stream, bytes[at + 8 + i]);
                    i += 1;
                }
            }
            at = at + 12 + length;
        }
    }
    if truncated {
        return Png { width: width, height: height, channels: channels, code: -3, stride: 0 };
    }

    let mutable raw: [Int] = [];
    let code: Int = zlib_into(raw, stream);
    let stride: Int = width * channels;
    if code < 0 || len(raw) != height * (stride + 1) {
        return Png { width: width, height: height, channels: channels, code: code, stride: stride };
    }

    // Unfiltering, row by row. `above` is the previous row AFTER unfiltering — the spec's predictors
    // read reconstructed bytes, never the filtered ones, which is the mistake that produces an image
    // that is almost right.
    let mutable row: Int = 0;
    while row < height {
        let from: Int = row * (stride + 1);
        let filter: Int = raw[from];
        let base: Int = row * stride;
        let mutable i: Int = 0;
        while i < stride {
            let here: Int = raw[from + 1 + i];
            let mutable left: Int = 0;
            if i >= channels {
                left = pixels[base + i - channels];
            }
            let mutable up: Int = 0;
            if row > 0 {
                up = pixels[base - stride + i];
            }
            let mutable up_left: Int = 0;
            if row > 0 && i >= channels {
                up_left = pixels[base - stride + i - channels];
            }
            let mutable value: Int = here;
            if filter == 1 {
                value = here + left;
            }
            if filter == 2 {
                value = here + up;
            }
            if filter == 3 {
                // **`divide_floor`, because `/` on two Ints is refused** — and the average is a floor
                // of the sum, which is what the spec says and what an integer divide happens to give.
                value = here + divide_floor(left + up, 2);
            }
            if filter == 4 {
                value = here + png_paeth(left, up, up_left);
            }
            // **`%` is a PERCENT literal here, not modulo** — `5%` is five percent of something — so
            // the wrap is `remainder`. Safe toward zero because every predictor adds a non-negative
            // byte to a non-negative byte, so `value` is never negative and the two divisions agree.
            let x: Int = push(pixels, remainder(value, 256));
            i += 1;
        }
        row += 1;
    }

    return Png { width: width, height: height, channels: channels, code: code, stride: stride };
}
