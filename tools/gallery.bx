// Every example, captured running, beside the markup that made it.
//
//     burxt build tools/gallery.bx -o star-gallery
//     ./star-gallery                  # -> docs/assets/gallery/*.png and docs/_includes/gallery.html
//     ./star-gallery --include-only   # rewrite the page from captures already on disk
//     ./star-gallery --serve DIR PORT # the server, spawned by the run above; not for hand use
//
// **A screenshot is a claim that cannot go stale loudly**, which is the whole hazard of a gallery: the
// picture keeps looking correct after the component stops working, because a picture is a file. So every
// capture here is taken from a real browser mounting the real `.wasm`, and every one is VERIFIED — the
// page's own DOM has to contain the marker its demo state promises, or the run fails.
//
// That check exists because of how `from_text` behaves: it FALLS BACK when a field is missing or renamed.
// A demo state that drifted from its component would render the default view and the slide would look
// deliberate — a screenshot of nothing in particular, indistinguishable from a design decision.
//
// ---- this was JavaScript, and what actually made it portable -------------------------------------
//
// It was declared `platform — drives a real browser mounting real wasm, and captures it`, which is true
// about what it does and was false about what it needs. Chrome was already driven as a BINARY rather
// than a module. Asking the sorting question — *which job runs this, and is that job allowed to need
// Burxt?* — sent every import to the standard library: `node:fs` is `files.bx`, `node:child_process` is
// `os.bx`, `node:path` and `node:os` are `path.bx` and `files.bx`, and `node:zlib` is `inflate.bx` since
// 1.6.0.
//
// **`node:http` was the one that looked impossible, and the reason it is not is worth writing down.**
// `HttpResponse.body` is a `String`, and a Burxt String is UTF-8 — so serving a `.wasm` looked ruled out
// by the type. It is not: the validation lives at `file_read`, which refuses non-text at the door, and
// **`from_bytes` accepts arbitrary bytes and round-trips them**, 0x00 and 0xFF included. Measured before
// this file was written: an 83,629-byte `showcase.wasm` served through `http_serve` and fetched back with
// a matching sha256, which also exercises `net_write`'s partial-write path re-slicing with `substring`.
// The lesson is the one this family keeps relearning — **do not infer a missing capability from a type.**
//
// **And a server with a synchronous child in one process is a deadlock.** The JavaScript learned this the
// hard way: `spawnSync` blocked the event loop, Chrome asked for a page, nothing answered, and sixteen
// timeouts all looked like pages that would not settle. Burxt's `http_serve` blocks by construction, so
// there is no version of this that works in one process — the server is a second copy of this binary,
// spawned with `--serve`, which is what the JavaScript's comment said a shell would do.
use "std/files.bx";
use "std/string.bx";
use "std/json.bx";
use "std/http.bx";
use "std/os.bx";
use "png.bx";

const WIDTH: Int = 1120;
const HEIGHT: Int = 620;
// The band of rows at the bottom that must be background, and the per-channel slack a resample allows.
const BAND: Int = 12;
const SLACK: Int = 6;

// ---- the server ----------------------------------------------------------------------------------

class Files { root: String }

pure function content_type(path: String) -> String {
    if string_ends_with(path, ".html") { return "text/html"; }
    if string_ends_with(path, ".js") { return "text/javascript"; }
    if string_ends_with(path, ".css") { return "text/css"; }
    if string_ends_with(path, ".wasm") { return "application/wasm"; }
    return "application/octet-stream";
}

implement Handler for Files {
    // **Read first, then answer.** The JavaScript wrote a 200 and then discovered the file was missing,
    // which leaves nothing to say — a missing favicon request took the whole run down that way.
    function (self) handle(request: HttpRequest) -> HttpResponse allocates touches files {
        let mutable path: String = request.path;
        if string_starts_with(path, "/") {
            path = substring(path, 1, len(path) - 1);
        }
        let mutable headers: [HttpHeader] = [];
        match file_read_bytes(self.root + "/" + path) {
            None => {
                return HttpResponse { status: 404, headers: headers, body: "" };
            }
            Some(bytes) => {
                let h: Int = push(headers,
                    HttpHeader { name: "content-type", value: content_type(path) });
                return HttpResponse { status: 200, headers: headers, body: from_bytes(bytes) };
            }
        }
    }
}

// ---- reading the collection ----------------------------------------------------------------------

pure function contains(haystack: String, needle: String) -> Bool {
    return string_find(haystack, needle) >= 0;
}

// The name in a row like ``| `Todos.sbmx` | why it is here | |``. The roster is the COLLECTION, in the
// order the collection lists it — so a component cannot appear in a carousel it was never written down
// in, and the two orders cannot disagree.
function roster(mutable names: [String], mutable reasons: [String]) -> Int touches files {
    let page: String = file_read("examples/README.md");
    let rows: [String] = string_lines(page);
    let mutable i: Int = 0;
    while i < len(rows) {
        let row: String = rows[i];
        if string_starts_with(row, "| `") {
            let close: Int = string_find_from(row, ".sbmx`", 3);
            if close > 3 {
                let name: String = substring(row, 3, close - 3);
                let x: Int = push(names, name);
                // The second column, which is the sentence the slide's caption carries.
                let after: Int = close + 6;
                let bar: Int = string_find_from(row, "|", after);
                let mutable why: String = "";
                if bar > after {
                    let next: Int = string_find_from(row, "|", bar + 1);
                    if next > bar {
                        why = string_trim(substring(row, bar + 1, next - bar - 1));
                    }
                }
                let y: Int = push(reasons, why);
            }
        }
        i += 1;
    }
    return len(names);
}

// A component with no `to_text`/`from_text` cannot be mounted on its own — `Badge` is used BY `Page`.
// They are NAMED rather than skipped, because a gallery that quietly drops five of twenty-one reads as a
// gallery of everything.
function mountable(name: String) -> Bool touches files {
    let src: String = file_read("examples/" + name + ".sbmx");
    return contains(src, "function to_text(") && contains(src, "function from_text(");
}

// `:props:` onward, which is the half a reader is deciding about.
function markup(name: String) -> String allocates touches files {
    let src: String = file_read("examples/" + name + ".sbmx");
    let at: String = ":props:";
    let from: Int = string_find(src, at);
    if from < 0 {
        return string_trim_end(src);
    }
    return string_trim_end(substring(src, from, len(src) - from));
}

pure function escape_html(text: String) -> String allocates {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(text) {
        let c: String = substring(text, i, 1);
        if c == "&" {
            out = out + "&amp;";
        } else {
            if c == "<" {
                out = out + "&lt;";
            } else {
                if c == ">" {
                    out = out + "&gt;";
                } else {
                    out = out + c;
                }
            }
        }
        i += 1;
    }
    return out;
}

// A JSON document, as a JavaScript string literal — which is what `mount` is handed, because the state
// crosses into wasm as text.
pure function as_js_string(json: String) -> String allocates {
    let mutable out: String = "\"";
    let mutable i: Int = 0;
    while i < len(json) {
        let c: String = substring(json, i, 1);
        if c == "\"" {
            out = out + "\\\"";
        } else {
            if c == "\\" {
                out = out + "\\\\";
            } else {
                out = out + c;
            }
        }
        i += 1;
    }
    return out + "\"";
}

// ---- Chrome ---------------------------------------------------------------------------------------

// A CI runner has one on PATH; this machine has them in a cache. Both, because a tool that only works
// where it was written is a tool nobody else runs.
function find_chrome() -> String allocates touches commands, files, input {
    let mutable candidates: [String] = [];
    let a: Int = push(candidates, "google-chrome");
    let b: Int = push(candidates, "chromium");
    let c: Int = push(candidates, "chromium-browser");
    let mutable i: Int = 0;
    while i < len(candidates) {
        let found: Capture = os_capture_status("command -v " + candidates[i] + " 2>/dev/null");
        let path: String = string_trim(found.output);
        if found.code == 0 && len(path) > 0 {
            return path;
        }
        i += 1;
    }
    // The caches, newest first, which is what `sort -r` gives for a version-named directory.
    let cached: Capture = os_capture_status(
        "ls -d \"$HOME\"/.cache/puppeteer/chrome/*/chrome-linux64/chrome"
        + " \"$HOME\"/.cache/puppeteer/chrome/*/chrome-linux/chrome"
        + " \"$HOME\"/.cache/ms-playwright/*/chrome-linux/chrome 2>/dev/null | sort -r | head -1");
    let path: String = string_trim(cached.output);
    if len(path) > 0 {
        return path;
    }
    return "";
}

// ---- the picture itself ---------------------------------------------------------------------------

// **The bottom band of a capture must be empty, and that is the check a dimension comparison cannot
// make.** The page draws the component inside 1.6rem of padding, so the last rows are background unless
// something was cut off — and a cropped capture has ink running to its final row. Heights can agree and
// the picture still be wrong; this asks the picture.
function bottom_is_clear(path: String) -> Bool touches files {
    let mutable bytes: [Int] = [];
    match file_read_bytes(path) {
        None => { return false; }
        Some(read) => { bytes = read; }
    }
    let mutable pixels: [Int] = [];
    let image: Png = png_read(bytes, pixels);
    if image.code < 0 || image.height <= BAND {
        return false;
    }
    let first: Int = (image.height - BAND) * image.stride;
    let r0: Int = pixels[first];
    let g0: Int = pixels[first + 1];
    let b0: Int = pixels[first + 2];
    let mutable row: Int = image.height - BAND;
    while row < image.height {
        let base: Int = row * image.stride;
        let mutable x: Int = 0;
        while x < image.width {
            let at: Int = base + x * image.channels;
            let mutable dr: Int = pixels[at] - r0;
            let mutable dg: Int = pixels[at + 1] - g0;
            let mutable db: Int = pixels[at + 2] - b0;
            if dr < 0 { dr = 0 - dr; }
            if dg < 0 { dg = 0 - dg; }
            if db < 0 { db = 0 - db; }
            if dr > SLACK || dg > SLACK || db > SLACK {
                return false;
            }
            x += 1;
        }
        row += 1;
    }
    return true;
}

class Shot { width: Int, height: Int, bytes: Int }

function shot_of(path: String) -> Shot touches files {
    match file_read_bytes(path) {
        None => { return Shot { width: 0, height: 0, bytes: 0 }; }
        Some(bytes) => {
            if len(bytes) < 24 {
                return Shot { width: 0, height: 0, bytes: len(bytes) };
            }
            let w: Int = bytes[16] * 16777216 + bytes[17] * 65536 + bytes[18] * 256 + bytes[19];
            let h: Int = bytes[20] * 16777216 + bytes[21] * 65536 + bytes[22] * 256 + bytes[23];
            return Shot { width: w, height: h, bytes: len(bytes) };
        }
    }
}

// ---- the run --------------------------------------------------------------------------------------

class Tally { failures: Int, captured: Int }

function fail(mutable tally: Tally, name: String, why: String) -> Int {
    tally.failures += 1;
    print("  FAIL  " + name + " — " + why);
    return 1;
}

// One Chrome, with a deadline. `timeout` is what stops a browser that never settles from hanging the
// suite instead of failing it.
function chrome_run(binary: String, flags: String, url: String) -> Capture
        touches commands, files, input {
    return os_capture_status("timeout 25 " + file_quote(binary) + " " + flags + " "
        + file_quote(url) + " 2>/dev/null");
}

pure function probe_flags(width: Int, height: Int) -> String allocates {
    return "--headless --no-sandbox --disable-gpu --hide-scrollbars --window-size="
        + to_string(width) + "," + to_string(height) + " --virtual-time-budget=5000";
}

// `<title>ready h=NNN</title>`, which is where the page writes its own height for a pass that cannot ask
// for a full-page shot.
pure function reported_height(dump: String) -> Int {
    let marker: String = "<title>ready h=";
    let at: Int = string_find(dump, marker);
    if at < 0 {
        return 0 - 1;
    }
    let from: Int = at + len(marker);
    let end: Int = string_find_from(dump, "<", from);
    if end < from {
        return 0 - 1;
    }
    return string_to_int(substring(dump, from, end - from), 0 - 1);
}

let mutable args: [String] = [];
let mutable a: Int = 1;
while a < os_arg_count() {
    let x: Int = push(args, os_arg(a));
    a += 1;
}

// **The server mode, first, because it never returns.** This is the same binary the capture run spawns
// with `&` — `http_serve` blocks by construction, so the only way to have both is two processes.
if len(args) >= 3 && args[0] == "--serve" {
    let files: Files = Files { root: args[1] };
    let handler: dynamic Handler = files;
    match http_serve(string_to_int(args[2], 0), handler, 1048576) {
        None => {
            print_error("gallery: cannot listen on " + args[2]);
            exit(1);
        }
        Some(served) => {
            exit(0);
        }
    }
}

let mutable include_only: Bool = false;
let mutable i0: Int = 0;
while i0 < len(args) {
    if args[i0] == "--include-only" {
        include_only = true;
    }
    i0 += 1;
}

let mutable names: [String] = [];
let mutable reasons: [String] = [];
let found: Int = roster(names, reasons);
if found < 15 {
    print_error("gallery: found only " + to_string(found) + " rows in examples/README.md");
    exit(2);
}

let mutable shown: [String] = [];
let mutable shown_why: [String] = [];
let mutable skipped: [String] = [];
let mutable r: Int = 0;
while r < len(names) {
    if mountable(names[r]) {
        let x: Int = push(shown, names[r]);
        let y: Int = push(shown_why, reasons[r]);
    } else {
        let x: Int = push(skipped, names[r]);
    }
    r += 1;
}
print(to_string(len(shown)) + " of " + to_string(len(names))
    + " components are mountable on their own");
if len(skipped) > 0 {
    print("  not in the carousel, and each is a CHILD component: " + string_join(skipped, ", "));
}

const SHOTS: String = "docs/assets/gallery";
let made_shots: Capture = os_capture_status("mkdir -p " + SHOTS);

let mutable tally: Tally = Tally { failures: 0, captured: 0 };
let mutable work: String = "";
let mutable server_pid: String = "";

if !include_only {
    match file_temp_directory("star-gallery") {
        None => {
            print_error("gallery: cannot make a temporary directory");
            exit(2);
        }
        Some(dir) => { work = dir; }
    }

    let mutable asset: Int = 0;
    let mutable assets: [String] = [];
    let a1: Int = push(assets, "app.js");
    let a2: Int = push(assets, "reconcile.js");
    let a3: Int = push(assets, "theme.css");
    while asset < len(assets) {
        let copied: Capture = os_capture_status("cp " + file_quote("examples/" + assets[asset])
            + " " + file_quote(work + "/" + assets[asset]));
        if copied.code != 0 {
            print_error("gallery: cannot stage " + assets[asset]);
            exit(2);
        }
        asset += 1;
    }

    // ---- build every component into one served directory ---------------------------------------
    let mutable b: Int = 0;
    while b < len(shown) {
        let name: String = shown[b];
        let low: String = string_to_lower_ascii(name);
        let built: Capture = os_capture_status("./star-build " + file_quote("examples/" + name + ".sbmx")
            + " " + file_quote(low) + " " + file_quote(work) + " 2>&1");
        if built.code != 0 {
            print_error("gallery: star-build refused " + name + ":");
            print_error(built.output + built.errors);
            exit(1);
        }
        if file_exists("examples/" + name + ".css") {
            let css: Capture = os_capture_status("cp " + file_quote("examples/" + name + ".css")
                + " " + file_quote(work + "/" + low + ".css"));
        }

        // The demo state, whose `shows` marker is what the DOM has to contain afterwards.
        let mutable state_json: String = "\{\}";
        let demo_path: String = "tests/gallery/" + name + ".json";
        if file_exists(demo_path) {
            match json_parse(file_read(demo_path)) {
                Ok(value) => {
                    match value {
                        Object(fields) => {
                            let mutable f: Int = 0;
                            while f < len(fields) {
                                if fields[f].name == "state" {
                                    state_json = json_render(fields[f].value);
                                }
                                f += 1;
                            }
                        }
                        Null => { state_json = state_json; }
                        Truth(t) => { state_json = state_json; }
                        Number(n) => { state_json = state_json; }
                        Text(s) => { state_json = state_json; }
                        List(items) => { state_json = state_json; }
                    }
                }
                Error(why) => {
                    print_error("gallery: " + demo_path + " does not parse: " + why);
                    exit(2);
                }
            }
        }

        // **The page reports its own height, because a viewport screenshot CROPS.** Capturing at a fixed
        // 1120x720 cut the bottom off every component taller than that — Andre saw it immediately. There
        // is no full-page flag on the command line, so the height has to be known BEFORE the shot: this
        // writes it where a `--dump-dom` pass can read it.
        let page: String = "<!doctype html>\n"
            + "<meta charset=\"utf-8\"><title>" + name + "</title>\n"
            + "<link rel=\"stylesheet\" href=\"./theme.css\">\n"
            + "<link rel=\"stylesheet\" href=\"./" + low + ".css\">\n"
            + "<style>body\{margin:0;padding:1.6rem;display:flex;align-items:flex-start;"
            + "justify-content:center\}\n"
            + "  .bx-shell\{width:100%;max-width:34rem\}</style>\n"
            + "<body class=\"bx\"><div class=\"bx-shell\"><div id=\"root\"></div></div>\n"
            + "<script type=\"module\">\n"
            + "  import \{ mount \} from './app.js';\n"
            + "  import \{ reconcile \} from './reconcile.js';\n"
            + "  await mount(\{ wasm: new URL('./" + low + ".wasm', import.meta.url),\n"
            + "                root: document.getElementById('root'), component: '" + low + "',\n"
            + "                initial: " + as_js_string(state_json) + ", reconcile \});\n"
            + "  const tall = Math.ceil(document.documentElement.scrollHeight);\n"
            + "  document.title = 'ready h=' + tall;\n"
            + "</script>\n";
        let wrote: Int = file_write(work + "/" + low + ".html", page);
        if wrote < 0 {
            print_error("gallery: cannot write " + low + ".html");
            exit(2);
        }
        b += 1;
    }

    // ---- serve, capture, verify -----------------------------------------------------------------
    let binary: String = find_chrome();
    if len(binary) == 0 {
        print_error("gallery: no Chrome binary on PATH or under ~/.cache/puppeteer"
            + " or ~/.cache/ms-playwright");
        exit(2);
    }

    // A port high enough to be unprivileged and specific enough not to be somebody's dev server. The
    // readiness poll is what makes a wrong guess a failure rather than sixteen mysterious timeouts.
    let port: Int = 8734;
    let spawned: Capture = os_capture_status("./star-gallery --serve " + file_quote(work) + " "
        + to_string(port) + " >/dev/null 2>&1 & echo $!");
    server_pid = string_trim(spawned.output);

    let mutable up: Bool = false;
    let mutable tries: Int = 0;
    while tries < 40 && !up {
        match http_get(127, 0, 0, 1, port, "127.0.0.1", "/theme.css") {
            Ok(response) => {
                if response.status == 200 {
                    up = true;
                }
            }
            Error(why) => { up = false; }
        }
        if !up {
            let waited: Capture = os_capture_status("sleep 0.1");
        }
        tries += 1;
    }
    if !up {
        let killed: Capture = os_capture_status("kill " + server_pid + " 2>/dev/null");
        print_error("gallery: the server never answered on " + to_string(port)
            + " — nothing was captured, which is this tool rather than any component");
        exit(1);
    }

    let mutable c: Int = 0;
    while c < len(shown) {
        let name: String = shown[c];
        let low: String = string_to_lower_ascii(name);
        let url: String = "http://127.0.0.1:" + to_string(port) + "/" + low + ".html";
        let probe: String = probe_flags(WIDTH, HEIGHT);

        // Pass one: how tall is it? **Retried once, because an empty dump is this tool and not the
        // page** — two components reported nothing on the first run of the JavaScript and both rendered
        // perfectly on their own.
        let mutable sized: Capture = chrome_run(binary, probe + " --dump-dom", url);
        let mutable tall: Int = reported_height(sized.output);
        if tall < 0 {
            sized = chrome_run(binary, probe + " --dump-dom", url);
            tall = reported_height(sized.output);
        }
        if tall < 0 {
            let mutable what: String = "the dump had no title";
            if len(string_trim(sized.output)) == 0 {
                what = "the dump came back EMPTY";
            }
            let f: Int = fail(tally, low + ".png",
                "the page never reported its height, twice. That is this tool rather than the"
                + " component: " + what);
            c += 1;
        } else {
            if tall < HEIGHT {
                tall = HEIGHT;
            }
            let flags: String = probe_flags(WIDTH, tall);
            let shot_path: String = SHOTS + "/" + low + ".png";
            let took: Capture = chrome_run(binary,
                flags + " --screenshot=" + file_quote(shot_path), url);

            // **The capture is verified against the page's own DOM.** A picture cannot tell you it
            // rendered the default view instead of the state it was given, and `from_text` FALLS BACK on
            // a field it does not recognise. An empty dump and a dump without the component are
            // different failures, and reporting the first as the second sent the JavaScript's author
            // looking at `Clock` for ten minutes when the page was fine.
            let mutable dom: Capture = chrome_run(binary, flags + " --dump-dom", url);
            if len(string_trim(dom.output)) == 0 {
                dom = chrome_run(binary, flags + " --dump-dom", url);
            }
            if len(string_trim(dom.output)) == 0 {
                let f: Int = fail(tally, low + ".png",
                    "no DOM came back, twice. That is this tool, not the component: check the server is"
                    + " still up and the browser is not being killed early");
                c += 1;
            } else {
                let mutable shows: String = "";
                let demo_path: String = "tests/gallery/" + name + ".json";
                if file_exists(demo_path) {
                    match json_parse(file_read(demo_path)) {
                        Ok(value) => {
                            match value {
                                Object(fields) => {
                                    let mutable f2: Int = 0;
                                    while f2 < len(fields) {
                                        if fields[f2].name == "shows" {
                                            match fields[f2].value {
                                                Text(s) => { shows = s; }
                                                Null => { shows = shows; }
                                                Truth(t) => { shows = shows; }
                                                Number(n) => { shows = shows; }
                                                List(items) => { shows = shows; }
                                                Object(inner) => { shows = shows; }
                                            }
                                        }
                                        f2 += 1;
                                    }
                                }
                                Null => { shows = shows; }
                                Truth(t) => { shows = shows; }
                                Number(n) => { shows = shows; }
                                Text(s) => { shows = shows; }
                                List(items) => { shows = shows; }
                            }
                        }
                        Error(why) => { shows = shows; }
                    }
                }
                let painted: Bool = contains(dom.output, "class=\"star\"");
                let landed: Bool = len(shows) == 0 || contains(dom.output, shows);
                let shot: Shot = shot_of(shot_path);

                if shot.bytes == 0 {
                    let f: Int = fail(tally, low + ".png",
                        "no file was written — the capture never completed");
                } else {
                    if shot.width != WIDTH {
                        let f: Int = fail(tally, low + ".png",
                            "it is " + to_string(shot.width) + "px wide, not " + to_string(WIDTH));
                    } else {
                        if shot.height < tall {
                            let f: Int = fail(tally, low + ".png", "it is " + to_string(shot.height)
                                + "px tall and the page asked for " + to_string(tall)
                                + " — it is CROPPED");
                        } else {
                            if !bottom_is_clear(shot_path) {
                                let f: Int = fail(tally, low + ".png",
                                    "there is ink in its bottom rows, so the component is CUT OFF. The"
                                    + " page keeps padding below the component, so those rows must be"
                                    + " background");
                            } else {
                                if shot.bytes < 4000 {
                                    let f: Int = fail(tally, low + ".png", "it is only "
                                        + to_string(shot.bytes)
                                        + " bytes, which is a picture of an empty page");
                                } else {
                                    if !painted {
                                        let f: Int = fail(tally, low + ".png",
                                            "the component did not render at all");
                                    } else {
                                        if !landed {
                                            let f: Int = fail(tally, low + ".png", "rendered, but \""
                                                + shows + "\" is not on the page — its demo state did"
                                                + " not take, so this is a picture of the DEFAULT view"
                                                + " and would look deliberate");
                                        } else {
                                            print("  ok    " + low + ".png");
                                            tally.captured += 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                c += 1;
            }
        }
    }

    let killed: Capture = os_capture_status("kill " + server_pid + " 2>/dev/null");
    if tally.failures > 0 {
        print("");
        print_error(to_string(tally.failures) + " capture(s) not verified");
        exit(1);
    }
}

// ---- the carousel ---------------------------------------------------------------------------------
//
// **No JavaScript, and that is not a purity point.** `scroll-snap` plus anchor links is the whole
// mechanism: a browser scrolls the nearest scrollable ancestor when you follow a fragment, so the strip
// moves and snaps with nothing running. A carousel that needs a script is a carousel that is blank while
// the script loads, on the page whose argument is that the component is already there.
//
// The code panel is the MARKUP half — `:props:` onward — because that is the half a reader is deciding
// about. It ships as a `language-sbmx` block, so the site's own painter numbers it and draws its guides.
let mutable slides: String = "";
let mutable dots: String = "";
let mutable s: Int = 0;
while s < len(shown) {
    let name: String = shown[s];
    let low: String = string_to_lower_ascii(name);
    // The height comes from the FILE, so the browser reserves exactly the right box and the strip does
    // not jump as each slide loads.
    let shot: Shot = shot_of(SHOTS + "/" + low + ".png");
    if shot.height == 0 {
        print_error("gallery: no capture on disk for " + low + ", so the page cannot be written");
        exit(1);
    }
    let mutable loading: String = "lazy";
    if s < 2 {
        loading = "eager";
    }
    slides = slides + "  <section class=\"shelf-slide\" id=\"shelf-" + low + "\" aria-label=\""
        + name + ", " + to_string(s + 1) + " of " + to_string(len(shown)) + "\">\n"
        + "    <figure class=\"shelf-shot\">\n"
        + "      <!-- Versioned like the stylesheets, and for the same reason: a PNG keeps its filename"
        + " when it is\n"
        + "           retaken, so a reader holds the PREVIOUS capture until the cache expires. Andre"
        + " reported the\n"
        + "           captures as cropped after they had been retaken — the ones he was looking at were"
        + " the old\n"
        + "           720x470 shots, which genuinely were cut off. -->\n"
        + "      <img src=\"\{\{ site.baseurl \}\}/assets/gallery/" + low
        + ".png?v=\{\{ site.time | date: '%s' \}\}\"\n"
        + "           width=\"" + to_string(WIDTH) + "\" height=\"" + to_string(shot.height) + "\"\n"
        + "           loading=\"" + loading + "\" alt=\"" + name
        + ".sbmx running in a browser\">\n"
        + "    </figure>\n"
        + "    <figure class=\"shelf-code\">\n"
        + "      <figcaption><strong>" + name + ".sbmx</strong> <span>"
        + escape_html(shown_why[s]) + "</span></figcaption>\n"
        + "      <!-- Wrapped in raw, or Jekyll eats the markup: a double brace is a slot in a star"
        + " document and a\n"
        + "           Liquid expression to Jekyll, so an unwrapped panel either fails the build or"
        + " renders the wrong\n"
        + "           thing silently. tools/liquid.bx caught it the moment the page was generated, which"
        + " is the gate\n"
        + "           earning its place — I had already pushed. -->\n"
        + "      \{% raw %\}<pre><code class=\"language-sbmx\">" + escape_html(markup(name))
        + "</code></pre>\{% endraw %\}\n"
        + "    </figure>\n"
        + "  </section>";
    if s < len(shown) - 1 {
        slides = slides + "\n";
    }

    let mutable on: String = "";
    if s == 0 {
        on = " class=\"on\"";
    }
    dots = dots + "      <a href=\"#shelf-" + low + "\" aria-label=\"" + name + "\"" + on + "></a>";
    if s < len(shown) - 1 {
        dots = dots + "\n";
    }
    s += 1;
}

let page: String = "<!-- GENERATED by tools/gallery.bx. Do not edit: regenerate. -->\n"
    + "<!-- Every capture is a real browser mounting the real .wasm, and every one is verified against"
    + " the DOM it\n"
    + "     came from — a screenshot cannot tell you it rendered the default view instead of the state"
    + " it was given.\n"
    + "\n"
    + "     The controls degrade: the strip is a scroll-snap container, so it drags and swipes with no"
    + " script at all,\n"
    + "     and the dots are anchors that work the same way. `shelf.js` adds the arrows, the keyboard"
    + " and the live\n"
    + "     counter on top of that — it is an enhancement rather than the mechanism. -->\n"
    + "<div class=\"shelf\" data-shelf>\n"
    + "  <div class=\"shelf-bar\">\n"
    + "    <button class=\"shelf-arrow\" type=\"button\" data-shelf-prev"
    + " aria-label=\"Previous example\">&#8249;</button>\n"
    + "    <div class=\"shelf-dots\">\n"
    + dots + "\n"
    + "    </div>\n"
    + "    <button class=\"shelf-arrow\" type=\"button\" data-shelf-next"
    + " aria-label=\"Next example\">&#8250;</button>\n"
    + "    <span class=\"shelf-count\" data-shelf-count>1 / " + to_string(len(shown)) + "</span>\n"
    + "  </div>\n"
    + "  <div class=\"shelf-track\" data-shelf-track tabindex=\"0\">\n"
    + slides + "\n"
    + "  </div>\n"
    + "</div>\n";

let wrote_page: Int = file_write("docs/_includes/gallery.html", page);
if wrote_page < 0 {
    print_error("gallery: cannot write docs/_includes/gallery.html");
    exit(1);
}

print("");
// **Say which run this was.** `--include-only` printed "16 captures, every one verified" while capturing
// nothing, which is the exact shape of claim this tool exists to refuse.
if include_only {
    print("reused " + to_string(len(shown))
        + " captures already on disk — nothing was re-captured or re-verified");
} else {
    print(to_string(tally.captured) + " captures, every one verified against the page it came from");
}
print("wrote docs/_includes/gallery.html");
