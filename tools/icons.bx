// Do the file icons fill their box the way the family agreed?
//
//     burxt build tools/icons.bx -o star-icons
//     ./star-icons
//     ./star-icons --prove-it     # the negative control
//
// **Andre's complaint about the `.bx` icon was that it "looks like it is really sticking to the edge
// making it no space on the file tree line."** Measured by the language session, it filled 86% of its
// height — four clear pixels at 48px — and the fix was to crop each source to its own ink and centre it
// at 70%.
//
// The consistency is the point rather than the padding: `.bx`, `.bmx` and `.sbmx` sit on consecutive
// rows of a file tree, and an eye reads inconsistent margins as misalignment rather than as three
// different logos. So this asserts the FRACTION, not the bytes. A byte comparison against a
// re-derivation would need the derivation script and would go green on any pair of files that agree with
// each other — including two that are both wrong. **A new drop of artwork nobody re-derived is exactly
// the case this has to catch**, and the artwork arrives from another repository.
//
// ---- this was half of editors/vscode/config.mjs, and only half of it could move ------------------
//
// That file was declared `blocked — asserts the icons' ink fraction, which means inflating a PNG`, and
// 1.6.0 unblocked exactly that. But the file's other twelve checks build `new RegExp(...)` from
// `language-configuration.json` and test strings against it, and **that is not portable in the sense
// that matters**: the value of those checks is that the editor's own engine folds BMX's fences, so a
// Burxt matcher agreeing with the markers would be testing a different engine and calling it the same
// answer. The regex half stayed where it is, with a reason that says regex rather than zlib.
//
// The unfiltering lives in `tools/png.bx`, shared with the gallery, because two checks needing pixels
// is one decoder and not two.
use "std/files.bx";
use "std/string.bx";
use "std/json.bx";
use "std/os.bx";
use "png.bx";

class Tally { ran: Int, broken: Int }

function check(mutable tally: Tally, ok: Bool, name: String, detail: String) -> Int {
    tally.ran += 1;
    if ok {
        print("  ok    " + name);
        return 0;
    }
    tally.broken += 1;
    print("  FAIL  " + name);
    print("        " + detail);
    return 1;
}

pure function field_of(value: Json, name: String) -> Json {
    match value {
        Object(fields) => {
            let mutable i: Int = 0;
            while i < len(fields) {
                if fields[i].name == name {
                    return fields[i].value;
                }
                i += 1;
            }
            return Json.Null;
        }
        Null => { return Json.Null; }
        Truth(b) => { return Json.Null; }
        Number(digits) => { return Json.Null; }
        Text(s) => { return Json.Null; }
        List(items) => { return Json.Null; }
    }
}

pure function text_of(value: Json) -> String {
    match value {
        Text(s) => { return s; }
        Null => { return ""; }
        Truth(b) => { return ""; }
        Number(digits) => { return digits; }
        List(items) => { return ""; }
        Object(fields) => { return ""; }
    }
}

// The rows an icon's ink occupies, as a percentage of its height, times ten — so 700 is 70.0% and the
// tolerance is expressed without a Decimal. **A row counts as ink when any pixel's alpha clears 8**,
// which is the same threshold the JavaScript used: a PNG's fully-transparent margin is not always
// exactly zero after a resample.
function ink_tenths(path: String) -> Int touches files {
    let mutable bytes: [Int] = [];
    match file_read_bytes(path) {
        None => { return 0 - 1; }
        Some(read) => { bytes = read; }
    }
    let mutable pixels: [Int] = [];
    let image: Png = png_read(bytes, pixels);
    if image.code < 0 || image.height <= 0 {
        return 0 - 2;
    }
    let mutable top: Int = 0 - 1;
    let mutable bottom: Int = 0 - 1;
    let mutable row: Int = 0;
    while row < image.height {
        let base: Int = row * image.stride;
        // Without an alpha channel every pixel is opaque, so every row is ink and the fraction is 1.
        let mutable opaque: Bool = image.channels != 4;
        if image.channels == 4 {
            let mutable x: Int = 0;
            while x < image.width && !opaque {
                if pixels[base + x * 4 + 3] > 8 {
                    opaque = true;
                }
                x += 1;
            }
        }
        if opaque {
            if top < 0 {
                top = row;
            }
            bottom = row;
        }
        row += 1;
    }
    if top < 0 {
        return 0;
    }
    return divide_floor((bottom - top + 1) * 1000, image.height);
}

function size_of(path: String) -> Int touches files {
    let mutable bytes: [Int] = [];
    match file_read_bytes(path) {
        None => { return 0 - 1; }
        Some(read) => { bytes = read; }
    }
    let mutable pixels: [Int] = [];
    let image: Png = png_read(bytes, pixels);
    if image.width != image.height {
        return 0;
    }
    return image.width;
}

let prove: Bool = os_arg_count() > 1 && os_arg(1) == "--prove-it";
let mutable tally: Tally = Tally { ran: 0, broken: 0 };

let declared_text: String = file_read("editors/vscode/package.json");
let mutable declared: Json = Json.Null;
match json_parse(declared_text) {
    Ok(value) => { declared = value; }
    Error(why) => {
        print_error("editors/vscode/package.json does not parse: " + why);
        exit(2);
    }
}

let mutable languages: [Json] = [];
match field_of(field_of(declared, "contributes"), "languages") {
    List(items) => { languages = items; }
    Null => { languages = languages; }
    Truth(b) => { languages = languages; }
    Number(digits) => { languages = languages; }
    Text(s) => { languages = languages; }
    Object(fields) => { languages = languages; }
}
let mutable sbmx_icon: String = "";
let mutable l: Int = 0;
while l < len(languages) {
    if text_of(field_of(languages[l], "id")) == "sbmx" {
        match field_of(languages[l], "icon") {
            Object(fields) => { sbmx_icon = "declared"; }
            Text(s) => { sbmx_icon = s; }
            Null => { sbmx_icon = sbmx_icon; }
            Truth(b) => { sbmx_icon = sbmx_icon; }
            Number(digits) => { sbmx_icon = sbmx_icon; }
            List(items) => { sbmx_icon = sbmx_icon; }
        }
    }
    l += 1;
}
if prove {
    sbmx_icon = "";
}
let x1: Int = check(tally, len(sbmx_icon) > 0,
    "the `.sbmx` language declares a file icon",
    "no `icon` on the sbmx language, so the file tree shows the generic document glyph");

// ---- every icon that ships, and the relation between them ------------------------------------------
//
// **This used to name `sbmx-gear-icon-{48,128}.png` and check each against 70% ± 3.** That is a list,
// and a list cannot fall behind quietly — it falls behind silently. Three file types ship icons here and
// only one was looked at, so a new `bmx-file-icon-48.png` at 86% would have passed the check whose own
// comment says *"a new drop of artwork nobody re-derived is exactly the case this has to catch, and the
// artwork arrives from another repository."*
//
// So the subjects come from the directory, and the property is the one the comment states: **`.bx`,
// `.bmx` and `.sbmx` sit on consecutive rows of a file tree, and an eye reads inconsistent margins as
// misalignment rather than as three different logos.** The anchor at 70% stays, because two icons that
// agree with each other and disagree with the family are still wrong — but the anchor alone was never
// the point, and the agreement was never checked at all.
//
// The language session's framing of why this shape is worth the rewrite: a check with no list to
// maintain needs nobody, ever. Their `Content-Length` relation still wants an assertion per response
// shape; this one covers an icon added tomorrow by a person who never reads this file.
let listing: Capture = os_capture_status("ls editors/vscode/icons/*.png 2>/dev/null");
let icons: [String] = string_lines(listing.output);

let mutable measured: [Int] = [];
let mutable named: [String] = [];
let mutable i: Int = 0;
while i < len(icons) {
    let path: String = string_trim(icons[i]);
    if len(path) > 0 {
        let square: Int = size_of(path);
        let x2: Int = check(tally, square > 0,
            path + " is square at " + to_string(square) + "px",
            path + " is not square, so it will be stretched into whatever box the tree gives it");
        let tenths: Int = ink_tenths(path);
        if tenths >= 0 {
            let m: Int = push(measured, tenths);
            let n: Int = push(named, path);
        }
    }
    i += 1;
}

// **Zero is not a pass**, and a `ls` that matched nothing is exactly what this would look like.
if len(measured) == 0 {
    print("no icon found under editors/vscode/icons/ at all, so this gate checked nothing");
    exit(1);
}

// The relation: every icon within three points of every other. Stated as a spread rather than pairwise,
// because the number a reader wants is how far apart the worst two are.
let mutable lowest: Int = measured[0];
let mutable highest: Int = measured[0];
let mutable low_name: String = named[0];
let mutable high_name: String = named[0];
let mutable m: Int = 0;
while m < len(measured) {
    if measured[m] < lowest {
        lowest = measured[m];
        low_name = named[m];
    }
    if measured[m] > highest {
        highest = measured[m];
        high_name = named[m];
    }
    m += 1;
}
if prove {
    // 86% is the measured value of the icon Andre complained about — four clear pixels at 48px — so the
    // control is the defect as it actually arrived rather than an arbitrary number.
    highest = 860;
    high_name = "editors/vscode/icons/a-new-drop-nobody-rederived.png";
}
let spread: Int = highest - lowest;
// **The headline is the PROPERTY, not the measurement.** It read "5 icons agree with each other to
// within 16 point(s)" on the failing control — a false sentence on the FAIL line, because this printer
// shows the same string either way. The measurement belongs in the detail, where it is only read when
// it is the diagnosis.
let x3: Int = check(tally, spread <= 30,
    "all " + to_string(len(measured)) + " icons are within 3 points of each other",
    "the icons disagree by " + to_string(divide_floor(spread + 5, 10)) + " points — " + low_name
        + " fills " + to_string(divide_floor(lowest + 5, 10)) + "% and " + high_name + " fills "
        + to_string(divide_floor(highest + 5, 10))
        + "%. They sit on consecutive rows of a file tree, so that reads as misalignment rather than as"
        + " two different logos");

// And the anchor, because two icons agreeing with each other and disagreeing with the family are still
// wrong. 70% is the family's number; the tolerance is a few pixels at 48px, not a licence to drift.
let mutable off: Int = lowest - 700;
if off < 0 {
    off = 0 - off;
}
let mutable off_high: Int = highest - 700;
if off_high < 0 {
    off_high = 0 - off_high;
}
if off_high > off {
    off = off_high;
}
let x4: Int = check(tally, off <= 30,
    "and every one of them is 70% ± 3, which is the family's number",
    "an icon is " + to_string(divide_floor(off + 5, 10)) + " points off the family's 70% — an icon at"
        + " 86% sits against the filename");

print("");
if prove {
    if tally.broken > 0 {
        print("the control failed as it must — " + to_string(tally.broken) + " caught");
        exit(0);
    }
    print("THE CONTROL DID NOT FAIL, so this check cannot see a drifted icon");
    exit(1);
}
if tally.broken > 0 {
    print(to_string(tally.broken) + " of " + to_string(tally.ran) + " broken");
    exit(1);
}
if tally.ran < 5 {
    print("only " + to_string(tally.ran) + " checks ran, which is fewer than this repository ships icons");
    exit(1);
}
print("the file icons fill their box the way the family agreed");
