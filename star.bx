// ============================================================================
// star.bx — star-burxt: what gives a BMX document life.
//
//     dependency  star  https://github.com/andrecorugda/star-burxt  v0.2.0
//     use "star/star.bx";
//
// BMX describes where an expression goes. It does not know what `for` means, or
// `if`, or `on:click` — `BOUNDARY.md` is the document that keeps it that way. This
// file is the host that decides, and `SPEC.md` §4a.5 is its specification:
//
//   - refuse an unknown block name, never render it and never skip it silently
//   - refuse an unknown attribute on a block it declares
//   - decide what a head means, including whether it binds names inside the body
//   - **refuse an event attribute it cannot wire.** A host with no runtime must
//     refuse `on:*` rather than emit an inline handler — emitting one puts
//     unchecked script on the page, which is the hole escaping exists to close
//
// That last one is the reason this file exists rather than a runtime `button()`
// function. BMX's parser hands a component block's head over as a **runtime
// String**, so `on:click=count + 1` would arrive as text that nothing compiles:
// no typecheck, no unknown-name error, no `burxt review` surface. A handler that
// is a string is a handler the language cannot judge, and judging it is the whole
// case for writing a framework in this language rather than another one.
//
// ---- the shape, and why it is the one Burxt was going to force anyway --------
//
//     props count: Int          the state
//     on:click=count + 1        an event yields the NEXT state
//     view                      a pure function of the state
//     dispatch                  a pure function of (handler, state) -> state
//
// A view is `pure`, so `burxt effects --allow ""` confirms it reaches nothing —
// by construction rather than by inspection. A handler is an expression producing
// the next state, which is the same architecture Elm arrived at, and it is not a
// coincidence: **Burxt has no closures** (Burxt's `lib/fn.bx` — "a closure needs an owner
// for its captured state, which is a memory question in a language whose whole
// memory model is regions"). With no closures there is nothing to capture a
// mutable cell in, so state cannot hide inside a handler. It has to be threaded,
// and threading it is what makes the update inspectable.
//
// The consequence worth stating: **an event handler's effect on the program is a
// value you can print.** `dispatch(0, 41)` is `42`. No framework whose handlers
// are closures can say that, and `burxt review` can diff what a handler promises
// between versions.
//
// ---- what reaches the page ---------------------------------------------------
//
// A handler becomes `data-star-h="0"` — an INDEX, never an inline handler. The
// driver installs one delegated listener and calls the exported `dispatch`. So a
// star-burxt page carries no executable markup at all, which is §4a.5 satisfied
// literally rather than approximately.
// **`std/` is the standard library, wherever Burxt is installed** — the prefix that makes this a
// package rather than a folder inside the compiler's repository.
//
// **`bmx` is a package dependency**, declared in `burxt.package` and pinned to a commit. BMX is a
// format with its own repository, its own version and its own conformance suite; star-burxt is one
// of its hosts rather than part of it, and the manifest is where that stops being a claim and
// becomes something a build has to satisfy. It reached here through `std/` until the day BMX left
// Burxt's `lib/`, which is a sentence worth keeping only because the two are easy to confuse: a
// dependency and the standard library are both "somewhere else", and only one of them is versioned
// by somebody with their own release cadence.
//
// **The long path is the format's neutrality, not an accident.** In the format's repository
// `reference/bmx.js` defines what BMX means and `burxt/bmx.bx` is one implementation of it; putting
// `bmx.bx` at that repo's root instead would shorten this line by seven characters and make the
// spec repository look like a Burxt package, which is the one thing it must not look like. A
// dependency needs no `burxt.package` of its own — nothing reads it — so the format repo can stay
// exactly what it is.
use "std/html.bx";
use "std/option.bx";
use "bmx/burxt/bmx.bx";

// ---- what this package supports, and it is three names ----------------------
//
// `public` is what a dependent package may reach. Without it every name here is
// hidden, and an application declaring `dependency star …` is told so by name:
//
//     error: `star_generate` is declared in the package `star` but not `public`,
//     so this package cannot reach it.
//
// That is the difference between a framework and a folder, and it is a decision
// rather than an omission: THREE names are supported — `star_generate`, and the
// two classes it answers with. `star_event_part`, `star_emit_stmts` and the rest
// of this file are how it is done today, and the day one of them changes should
// not be a day anybody else's build breaks.
//
// Fields need no `public` of their own. A class that is reachable is reachable
// with its shape, because a `StarComponent` whose `view` could not be read would
// be a value with nothing to do.

// A handler found while walking the document: its index, and the expression the
// author wrote. The expression is emitted into `dispatch` verbatim, where the
// compiler judges it — a typo is `unknown variable`, a wrong type is a type
// error, and both name the thing the author wrote.
public class StarHandler { event: String, expression: String }

// What a generated component is: the view, the dispatch, and the handler table
// that ties an index on the page to an expression in the source.
public class StarComponent {
    view: String,
    dispatch: String,
    handlers: [StarHandler],
    // The `===bx` section, verbatim. Empty when the document has none — which is also the switch
    // between the two modes below, so a reader can tell which one a file is in by looking at it.
    code: String,
    // `===style.global` as written, plus `===style.local` with every selector scoped to this
    // component. One sheet, because the page loads one file per component and the difference
    // between the two sections is spent by the time it is written.
    style: String,
    // The declaration verbatim (`count: Int`) and the names alone (`count`), so the
    // emitted entry point can both DECLARE and PASS the props without the caller
    // re-deriving either.
    props: String,
    argument_list: String,
}

// Is this section empty of anything that matters?
//
// **`bmx_strip_end` strips trailing SPACES and nothing else** — not newlines, not tabs. That is right
// for BMX's indentation rule and wrong for asking "is there anything here", which is what four call
// sites were asking it. The markup session found the same trap in their own suite: used on refusal
// fixtures it left the newline on, so every one of 35 cases compared `BMX-E031\n` against
// `BMX-E031 at 0: …` and failed while all 57 AST cases passed — a clean split down the middle of a
// suite, which reads exactly like a defect in refusal handling.
//
// Here it produced a subtler thing. `===bx` with a single blank line between the fences flipped the
// component-mode switch, so a document demanded `Msg` and `update`; the same section with nothing
// between the fences did not. **Two documents that mean the same thing, and star spoke a different
// language to each** — reachable by pressing return.
//
// The name is the trap and it is not BMX's to fix: `strip_end` sounds like a trim. So this asks the
// question it means.
pure function star_is_blank(text: String) -> Bool {
    let mutable i: Int = 0;
    while i < len(text) {
        let c: Int = byte_at(text, i);
        if c != 32 && c != 10 && c != 13 && c != 9 { return false; }
        i += 1;
    }
    return true;
}

// ---- `.sbmx` sections, split off before BMX ever sees the file ----------------
//
// A component file has two halves: Burxt in `===bx`, and markup. The markup goes to BMX; the code
// does not, and **that is the boundary rather than a convenience**. Handing the code to BMX would
// make the markup format responsible for transporting a payload it cannot read — and it fails in
// practice, not only in principle: a fenced code block shreds a component the moment a Burxt string
// contains a line beginning with three backticks, splitting the program in two with a paragraph in
// the middle. `===` delimiters are star's, so star controls what terminates them.
//
// A section opens with `===name` and closes with a bare `===`. Everything outside every section is
// markup. If star ever failed to strip a section, BMX would render it as a paragraph — visibly
// wrong on the page rather than silently miscompiled, which is the right way for this to break.

pure function star_end_of_line(text: String, from: Int, width: Int) -> Int {
    let mutable i: Int = from;
    while i < width && byte_at(text, i) != 10 {
        i += 1;
    }
    return i;
}

// A line that is exactly `===` closes whatever is open. Checked before the opener, because `===`
// would otherwise read as an opener whose name is empty.
pure function star_closes_section(line: String) -> Bool {
    return bmx_strip_end(line) == "===";
}

pure function star_opens_section(line: String) -> Bool {
    if len(line) < 4 {
        return false;
    }
    return byte_at(line, 0) == 61 && byte_at(line, 1) == 61 && byte_at(line, 2) == 61;
}

pure function star_section_name(line: String) -> String {
    return bmx_strip_end(substring(line, 3, len(line) - 3));
}

// The text of one section, or the empty String when the file has none of that kind.
pure function star_section(source: String, wanted: String) -> String {
    let mutable out: String = "";
    let mutable inside: Bool = false;
    let width: Int = len(source);
    let mutable at: Int = 0;
    while at < width {
        let stop: Int = star_end_of_line(source, at, width);
        let line: String = substring(source, at, stop - at);
        if star_closes_section(line) {
            inside = false;
        } else {
            if star_opens_section(line) {
                inside = star_section_name(line) == wanted;
            } else {
                if inside {
                    out = out + line + "\n";
                }
            }
        }
        at = stop + 1;
    }
    return out;
}

// Everything that is not in a section. This is what BMX parses.
//
// A section's lines become BLANK rather than disappearing, so every byte offset after them is where
// it was — which is what keeps BMX's error offsets pointing at the line the author wrote. The same
// trick the compiler's own module loader uses on `use` lines, and for the same reason.
pure function star_markup(source: String) -> String {
    let mutable out: String = "";
    let mutable inside: Bool = false;
    let width: Int = len(source);
    let mutable at: Int = 0;
    while at < width {
        let stop: Int = star_end_of_line(source, at, width);
        let line: String = substring(source, at, stop - at);
        let mutable keep: Bool = false;
        if star_closes_section(line) {
            inside = false;
        } else {
            if star_opens_section(line) {
                inside = true;
            } else {
                keep = !inside;
            }
        }
        if keep {
            out = out + line + "\n";
        } else {
            out = out + star_blanked(line) + "\n";
        }
        at = stop + 1;
    }
    return out;
}

// A line of spaces the same width, so offsets do not move.
pure function star_blanked(line: String) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(line) {
        out = out + " ";
        i += 1;
    }
    return out;
}

// Does this text contain that one? Written here rather than imported: star depends on `std/string`
// for nothing else, and one substring search is not worth a dependency.
pure function star_mentions(haystack: String, needle: String) -> Bool {
    let n: Int = len(needle);
    if n == 0 {
        return true;
    }
    let mutable i: Int = 0;
    while i + n <= len(haystack) {
        let mutable j: Int = 0;
        let mutable same: Bool = true;
        while j < n && same {
            if byte_at(haystack, i + j) != byte_at(needle, j) {
                same = false;
            }
            j += 1;
        }
        if same {
            return true;
        }
        i += 1;
    }
    return false;
}

// ---- head parsing, which is the host's job and not the format's --------------
//
// Byte codes rather than character literals, and `byte_at`/`substring` rather than
// building strings a byte at a time — the idiom BMX's own parser uses, and the
// one that does not allocate per character.
//
//     111 'o'   110 'n'   58 ':'   61 '='   32 ' '

// `button on:click=count + 1` -> Some("click=count + 1"). The format captured the
// head as opaque text; splitting it is ours, and so is refusing what we cannot wire.
pure function star_event_part(head: String) -> Option<String> {
    let mutable i: Int = 0;
    while i + 3 <= len(head) {
        if byte_at(head, i) == 111 && byte_at(head, i + 1) == 110 && byte_at(head, i + 2) == 58 {
            // Only at a token boundary, so `button on:click=x` matches and a
            // component legitimately named `weapon:click` does not.
            if star_at_token_start(head, i) {
                return Option.Some(substring(head, i + 3, len(head) - (i + 3)));
            }
        }
        i += 1;
    }
    return Option.None;
}

// `click=count + 1` -> the event name, and the expression after the FIRST `=`.
// The expression runs to the end of the head, so an `on:` binding is written last:
// expressions contain spaces and equals signs, and a format that does not parse
// heads cannot tell us where one ends.
pure function star_event_name(part: String) -> String {
    let mutable i: Int = 0;
    while i < len(part) {
        if byte_at(part, i) == 61 { return substring(part, 0, i); }
        i += 1;
    }
    return part;
}

pure function star_event_expression(part: String) -> String {
    let mutable i: Int = 0;
    while i < len(part) {
        if byte_at(part, i) == 61 { return substring(part, i + 1, len(part) - (i + 1)); }
        i += 1;
    }
    return "";
}

// The head with its `on:` binding removed — what is left is the element's own
// business. Trailing space trimmed, so `button on:click=x` leaves `button`.
pure function star_head_without_event(head: String) -> String {
    let mutable i: Int = 0;
    while i + 3 <= len(head) {
        if byte_at(head, i) == 111 && byte_at(head, i + 1) == 110 && byte_at(head, i + 2) == 58 {
            if star_at_token_start(head, i) {
                return bmx_strip_end(substring(head, 0, i));
            }
        }
        i += 1;
    }
    return head;
}

// ---- the events this host can wire, and the refusal for the rest -------------

// §4a.5: refuse an event attribute we cannot wire. The list is short on purpose —
// every entry is one the driver installs a delegated listener for, and adding to
// it means adding to the driver. A host that accepts an event it does not deliver
// has told the author a lie the compiler cannot catch.
// ---- the events this host can wire -----------------------------------------------------------
//
// **This list and the driver's must agree or the framework lies.** star refuses `on:hover` because
// the driver installs no listener for it; accepting an event nothing delivers would be a handler
// that silently never runs, which is the worst shape a failure can have on a page. `test.py`
// generates every event named in `examples/app.js` and requires each to be accepted, so the two
// cannot drift apart without something going red.
//
// Every event carries a VALUE, and what it is depends on the event — the typed text for `input`, the
// key for `keydown`, the coordinates for a pointer, the animation's name for `animationend`. It
// arrives as text, like the row key, because the DOM boundary is text.
pure function star_event_is_wired(name: String) -> Bool {
    return star_in_set(name,
        // pointer and mouse
        " click dblclick contextmenu pointerdown pointerup pointermove pointerenter pointerleave"
        + " mousedown mouseup mouseenter mouseleave mouseover mouseout"
        // keyboard
        + " keydown keyup"
        // forms
        + " input change submit reset focus blur focusin focusout"
        // dragging
        + " dragstart dragover dragleave drop dragend"
        // touch
        + " touchstart touchmove touchend"
        // scrolling
        + " wheel scroll"
        // **animation, which is why a transition can drive state.** `animationend` and
        // `transitionend` are what let a component know its own animation finished, so a leaving
        // element can be removed after it has faded rather than during.
        + " animationend animationstart animationiteration transitionend transitionstart ");
}

// The block names this host declares, and the refusal for the rest.
//
// §4a.5 first line: *refuse an unknown block name, never render it and never skip
// it silently.* So star-burxt says what it knows: `for` and `if` are control flow,
// `props` is the signature, and these are elements. Anything else is a component,
// and until cross-file resolution exists there is nothing to resolve it against —
// so it is refused BY NAME rather than rendered as something plausible.
// Elements whose content model is PHRASING rather than flow. A `<p>` inside one of
// these is invalid HTML, not merely unwanted, which is why the unwrapping above is
// required rather than a preference. The list is short because it is the set this
// host declares — adding to it is a decision, not a convenience.
// ---- the element vocabulary, as a content model rather than a list --------------------------
//
// Three sets, and the SPLIT is what does the work rather than the membership. HTML's own rule is
// that a phrasing element holds text and a flow element holds sections; putting a heading in a
// button is invalid markup that browsers handle unpredictably, so star refuses it (STAR-E005) and
// unwraps paragraphs inside phrasing elements so a `button` holds text rather than a `<p>`.
//
// Written as space-delimited sets because a chain of forty `||` is a place to make a typo nobody
// sees. The spaces around each name are load-bearing: without them `p` would match inside `input`.

// Text-level. Paragraphs inside these UNWRAP, and a heading, list, quote or code block is refused.
pure function star_takes_phrasing(name: String) -> Bool {
    return star_in_set(name,
        " a abbr b bdi bdo button caption cite code data data dfn del dt em h1 h2 h3 h4 h5 h6 i ins"
        + " kbd label legend mark meter option p q rp rt ruby s samp small span strong sub summary"
        + " sup textarea time title u var ");
}

// **What an element IS, as against what it may CONTAIN.** Two different questions, and one set was
// answering both — wrong in both directions, found by writing a `<label>` with a `<select>` in it.
//
// `select` IS phrasing content and TAKES `option` children, so asking "does it take flow?" refused
// `<label>size <select>…</select></label>` — ordinary, valid, and one of the most common patterns in
// any form. Nine of ten valid pairs I probed were refused: `<span><canvas>`, `<p><video>`,
// `<p><iframe>`, `<span><progress>`, `<span><output>`, `<p><object>`, `<p><audio>`,
// `<button><progress>`.
//
// **And the other direction was worse.** `h1` takes phrasing, so it sat in that set — which meant
// `<button><h1>` was ACCEPTED, the exact case the comment above says STAR-E005 exists to refuse.
// A rule whose own stated purpose it does not serve, in the file that states it.
//
// `option`, `legend`, `caption`, `dt`, `rp`, `rt` and `title` stay OUT: they take phrasing, but they
// are not phrasing content — each is only valid inside a particular parent, so admitting them here
// would let `<span><option>` through.
pure function star_is_phrasing(name: String) -> Bool {
    return star_in_set(name,
        " a abbr audio b bdi bdo br button canvas cite code data datalist del dfn em embed i iframe"
        + " img input ins kbd label map mark meter noscript object output picture progress q ruby s"
        + " samp select slot small span strong sub sup textarea time u var video wbr ");
}

// Takes no children at all. `html_element` carries `requires !html_is_void(tag) ||
// len(children) == 0`, so one of these with a body is a CONTRACT violation — refused at generate
// time rather than left to trip when the page is already open.
pure function star_is_void(name: String) -> Bool {
    return star_in_set(name, " area base br col embed hr img input link meta source track wbr ");
}

// Everything else a document may wrap things in.
//
// **`template` and `svg` are left out ON PURPOSE, and saying so is the point.** A convention that
// exists only as an absence is indistinguishable from a name somebody forgot — which is how `time`,
// `abbr`, `kbd`, `iframe` and a dozen others sat refused as *undeclared block names* while being
// perfectly good HTML. Those were false refusals of correct markup, found by turning the
// still-parses search key around: a scanner with a wrong model fails in BOTH directions, and a suite
// cannot hold the accepting one because nobody writes a case asserting that something they believe
// illegal actually works.
//
//   `template` — its children are INERT. star renders children as live content, so admitting it
//                would render exactly what the element exists not to render.
//   `svg`      — foreign content. Its children are not HTML elements, so `:path:` and `:circle:`
//                would have to be a second vocabulary with a different content model.
//
// Both are answerable, neither is answered, and `not-done.md` says so.
pure function star_takes_flow(name: String) -> Bool {
    return star_in_set(name,
        " address article aside audio blockquote canvas colgroup dd details dialog div dl fieldset"
        + " figcaption figure footer form header hgroup iframe li main menu nav noscript object ol"
        + " optgroup output picture pre progress search section select table tbody td tfoot th thead"
        + " tr ul video ");
}

// **What separates one head token from the next: a space OR a comma.**
//
// Andre writes `-> [on:click=save(id), .featured, #plans]`, and a comma is the natural separator
// inside brackets. Until this existed `class=card, id=main` produced `class="card,"` — the comma
// swallowed into the value, silently, with no refusal. BMX found the same shape in their own
// `BMX-E033`, where asking whether a `#` followed *whitespace* let `#one,#two` evade the one-id rule
// in both implementations at once: **70 of 70 fixtures agreed and both were wrong.**
//
// One function rather than five `== 32` tests, because five copies of a separator rule is five places
// for the next separator to be forgotten.
pure function star_separates(byte: Int) -> Bool {
    return byte == 32 || byte == 44;
}

// Is the token starting at `i` at the start of the head or preceded by a separator? The test that was
// `byte_at(head, i - 1) == 32` in five places, and wrong at every one of them for a comma.
pure function star_at_token_start(head: String, i: Int) -> Bool {
    return i == 0 || star_separates(byte_at(head, i - 1));
}

pure function star_in_set(name: String, set: String) -> Bool {
    return star_mentions(set, " " + name + " ");
}


pure function star_is_element(name: String) -> Bool {
    return star_takes_phrasing(name) || star_is_void(name) || star_takes_flow(name);
}


// ---- keys, which are a prerequisite rather than an optimisation ---------------
//
//     ::: for line in order.lines key line.id
//
// The trailing `key <expr>` is star-burxt's, parsed out of a head BMX captured and
// refused to interpret — the same move as `props` and `on:`, and again needing
// nothing from the format.
//
// **Why this is not a list optimisation.** Without a key, children are matched by
// POSITION, and `items[3]` is not the same item after a splice. That is silent ABA:
// a row's handler, its focus, and anything it owns quietly transfer to whatever
// slid into its index. It is merely wasteful until something is async or something
// is owned; then it is corruption. So keys have to exist before a component can own
// a resource, not after.

// `line in order.lines key line.id` -> Some("line.id"). The keyword must stand at a
// token boundary, so a collection named `monkey` does not match.
pure function star_key_part(head: String) -> Option<String> {
    let mutable i: Int = 0;
    while i + 4 <= len(head) {
        if byte_at(head, i) == 107 && byte_at(head, i + 1) == 101
            && byte_at(head, i + 2) == 121 && byte_at(head, i + 3) == 32 {
            if i > 0 && star_separates(byte_at(head, i - 1)) {
                return Option.Some(bmx_strip_end(substring(head, i + 4, len(head) - (i + 4))));
            }
        }
        i += 1;
    }
    return Option.None;
}

// The head with the `key` clause removed — what `for` itself gets.
pure function star_head_without_key(head: String) -> String {
    let mutable i: Int = 0;
    while i + 4 <= len(head) {
        if byte_at(head, i) == 107 && byte_at(head, i + 1) == 101
            && byte_at(head, i + 2) == 121 && byte_at(head, i + 3) == 32 {
            if i > 0 && star_separates(byte_at(head, i - 1)) {
                return bmx_strip_end(substring(head, 0, i));
            }
        }
        i += 1;
    }
    return head;
}

// ---- emission ----------------------------------------------------------------

// The document's blocks become statements pushing into `target`. This mirrors
// `bmx_emit_stmts` and diverges in exactly one place: a block carrying an `on:*`
// binding becomes an element with `data-star-h="N"` and its expression is put
// aside for `dispatch`, where the COMPILER judges it. That divergence is the
// whole file.
// `key_here` is the key expression that applies to elements emitted at THIS level —
// the immediate body of a keyed `for`. It is not passed down: a key identifies the
// row, and a grandchild of the row is identified by being inside it.
// `source` is threaded through for ONE reason: an error's position. It could have been rewritten
// afterwards by finding "at <n>" in the message and substituting — and that is string surgery on a
// diagnostic, which is the kind of remedy that quietly damages the thing it is fixing the moment a
// message legitimately contains those characters. One parameter through four call sites is cheaper
// and cannot be wrong.
function star_emit_stmts(source: String, known: [StarKnown], marker: String, blocks: [Block], target: String, tag: String, indent: String,
                         mutable handlers: [StarHandler], key_here: String,
                         loop_var: String) -> Result<String, String> {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(blocks) {
        let label: String = "s_" + tag + "_" + to_string(i);
        match blocks[i] {
            Fenced(fenced) => {
                let inner: String = "k_" + tag + "_" + to_string(i);
                if fenced.name == "props" {
                    // Consumed by star_generate for the signature; emits nothing.
                    i += 1;
                    continue;
                }
                // ---- `match`, and the reason it earns its own construct -----------------------
                //
                // A real screen decides. `::: if` can do it, and four `if`s over a route lose the
                // thing that makes deciding in Burxt worth anything:
                //
                //     error: this `match` on `Route` does not handle `Archive`. Every variant must
                //     be handled — that is what makes adding a variant later a compile error
                //     instead of a silent fall-through.
                //
                // **Add a screen, forget its view, and the build fails.** No JavaScript framework
                // can say that; they give you a blank page and a bug report. The exhaustiveness is
                // the compiler's — star only has to emit a `match` rather than a chain of `if`s,
                // and the arms' patterns go through verbatim like every other head, so the
                // compiler does the destructuring too.
                if fenced.name == "match" {
                    if len(bmx_strip_end(fenced.head)) == 0 {
                        return Result.Error("STAR-E010 at " + star_at(source, fenced.offset)
                            + ": a `match` needs something to match on — `:match: model.route`");
                    }
                    let mutable arms: String = "";
                    let mutable c: Int = 0;
                    while c < len(fenced.children) {
                        match fenced.children[c] {
                            Fenced(arm) => {
                                if arm.name != "case" {
                                    return Result.Error("STAR-E011 at " + star_at(source, arm.offset)
                                        + ": a `match` holds `case` blocks and nothing else, so"
                                        + " every branch is one the compiler can check. Found `"
                                        + arm.name + "`");
                                }
                                if len(bmx_strip_end(arm.head)) == 0 {
                                    return Result.Error("STAR-E012 at " + star_at(source, arm.offset)
                                        + ": a `case` needs a pattern — `:case: Post(id)`");
                                }
                                match star_emit_stmts(source, known, marker, arm.children, target,
                                                      tag + "_" + to_string(i) + "_" + to_string(c),
                                                      indent + "        ", handlers, key_here, loop_var) {
                                    Error(e) => { return Result.Error(e); }
                                    Ok(body) => {
                                        arms = arms + indent + "    " + bmx_strip_end(arm.head)
                                            + " => \{\n" + body + indent + "    \}\n";
                                    }
                                }
                            }
                            Paragraph(p) => {
                                return Result.Error("STAR-E011 at " + star_at(source, p.offset)
                                    + ": a `match` holds `case` blocks and nothing else — text"
                                    + " between the branches has no branch to belong to");
                            }
                            Heading(h) => {
                                return Result.Error("STAR-E011 at " + star_at(source, h.offset)
                                    + ": a `match` holds `case` blocks and nothing else");
                            }
                            Quote(q) => {
                                return Result.Error("STAR-E011 at " + star_at(source, q.offset)
                                    + ": a `match` holds `case` blocks and nothing else");
                            }
                            List(l) => {
                                return Result.Error("STAR-E011 at " + star_at(source, l.offset)
                                    + ": a `match` holds `case` blocks and nothing else");
                            }
                            Code(cd) => {
                                return Result.Error("STAR-E011 at " + star_at(source, cd.offset)
                                    + ": a `match` holds `case` blocks and nothing else");
                            }
                        }
                        c += 1;
                    }
                    if len(arms) == 0 {
                        return Result.Error("STAR-E013 at " + star_at(source, fenced.offset)
                            + ": a `match` with no `case` blocks decides nothing");
                    }
                    out = out + indent + "match " + bmx_strip_end(fenced.head) + " \{\n"
                        + arms + indent + "\}\n";
                    i += 1;
                    continue;
                }
                // A `case` outside a `match` has no scrutinee, so it is refused where it is
                // written rather than emitted as code naming a pattern with nothing to match.
                if fenced.name == "case" {
                    return Result.Error("STAR-E014 at " + star_at(source, fenced.offset)
                        + ": a `case` belongs inside a `match`");
                }
                // Reached only when the `if` arm did not consume it, which means there is no `if`
                // immediately above — an `else` separated from its `if` by a paragraph is the
                // mistake this catches, and it would otherwise render as an unknown block.
                if fenced.name == "else" {
                    return Result.Error("STAR-E016 at " + star_at(source, fenced.offset)
                        + ": an `else` must come directly after an `if`, with nothing between"
                        + " them");
                }
                if fenced.name == "for" || fenced.name == "if" {
                    // The head is host CODE and goes through verbatim. Neither
                    // construct produces an element, so the body pushes into the
                    // same list — and the compiler resolves what the head binds.
                    //
                    // A `key` clause is stripped off first and becomes an attribute on
                    // whatever the body pushes, so the reconciler can match a row to a
                    // row rather than to an index. The key EXPRESSION goes through
                    // verbatim too, so `key line.idd` is a compile error naming the
                    // field — a key nobody checked would be worse than no key at all.
                    let loop_head: String = star_head_without_key(fenced.head);
                    if fenced.name == "if" && len(loop_head) < len(fenced.head) {
                        return Result.Error("STAR-E006 at " + star_at(source, fenced.offset)
                            + ": `key` belongs on a `for`, not on an `if` — there is one branch"
                            + " and nothing to tell apart");
                    }
                    let mutable keyed: String = "";
                    match star_key_part(fenced.head) {
                        None => { }
                        Some(expr) => { keyed = expr; }
                    }
                    // How many handlers existed before the body was walked. If the body added
                    // one and the loop has no `key`, the page has no way to say WHICH row was
                    // clicked — every row would dispatch identically, which is worse than a
                    // refusal because it looks like it works.
                    //
                    // Counted rather than searched for: the walk already records every handler it
                    // finds, so asking whether the count moved is exact, and a search would be a
                    // second implementation of the same question.
                    let before: Int = len(handlers);
                    match star_emit_stmts(source, known, marker, fenced.children, target, tag + "_" + to_string(i),
                                          indent + "    ", handlers, keyed,
                                          star_binds(fenced.name, loop_head, loop_var)) {
                        Error(e) => { return Result.Error(e); }
                        Ok(body) => {
                            if fenced.name == "for" && len(keyed) == 0 && len(handlers) > before {
                                return Result.Error("STAR-E018 at " + star_at(source, fenced.offset)
                                    + ": this `for` has a handler inside it, so the page has to be"
                                    + " able to say which row was clicked. Add `key <expression>`"
                                    + " to the `for`");
                            }
                            // **A `for` over a CALL binds the call first.** Burxt refuses
                            // `for x in f(y)` — the call would be remade on every pass — and it is
                            // right to, but the author never wrote that line: they wrote
                            // `::: for task in shown(model)`, which is a reasonable thing to write.
                            // So the subject is bound here, where the reader cannot be shown a
                            // complaint about generated code.
                            out = out + indent
                                + star_loop_prelude(fenced.name, loop_head, tag + "_" + to_string(i))
                                + fenced.name + " "
                                + star_loop_head(fenced.name, loop_head, tag + "_" + to_string(i))
                                + " \{\n" + body + indent + "\}\n";
                        }
                    }
                    // **An `else` is the NEXT block, and it is consumed here rather than reached
                    // on its own.** Writing two `if`s with hand-negated conditions is what an
                    // author does without this, and the two drift: a condition is edited in one
                    // place and the other still says what it used to.
                    if fenced.name == "if" && i + 1 < len(blocks) {
                        match blocks[i + 1] {
                            Fenced(next) => {
                                if next.name == "else" {
                                    if len(bmx_strip_end(next.head)) > 0 {
                                        return Result.Error("STAR-E015 at "
                                            + star_at(source, next.offset)
                                            + ": an `else` takes no condition — it is the other"
                                            + " branch of the `if` above it. Write a second `if`"
                                            + " if you meant a different question");
                                    }
                                    match star_emit_stmts(source, known, marker, next.children, target,
                                                          tag + "_" + to_string(i) + "e",
                                                          indent + "    ", handlers, keyed, loop_var) {
                                        Error(e) => { return Result.Error(e); }
                                        Ok(otherwise) => {
                                            out = out + indent + "else \{\n" + otherwise
                                                + indent + "\}\n";
                                        }
                                    }
                                    i += 1;
                                }
                            }
                            Paragraph(p) => { }
                            Heading(h) => { }
                            Quote(q) => { }
                            List(l) => { }
                            Code(cd) => { }
                        }
                    }
                    i += 1;
                    continue;
                }
                // A component: another `.sbmx`, imported and generated by the driver, called here.
                let at_known: Int = star_known_at(known, fenced.name);
                if at_known >= 0 {
                    let wanted: [String] = star_prop_names(known[at_known].props);
                    let mutable args: String = "";
                    let mutable a: Int = 0;
                    while a < len(wanted) {
                        let given: String = star_head_value(fenced.head, wanted[a]);
                        if len(given) == 0 {
                            return Result.Error("STAR-E017 at " + star_at(source, fenced.offset)
                                + ": `" + fenced.name + "` needs `" + wanted[a]
                                + "`, and this call does not give it. Its props are `"
                                + known[at_known].props + "`");
                        }
                        if a > 0 { args = args + ", "; }
                        args = args + given;
                        a += 1;
                    }
                    // **Arguments go in the CALLEE's declared order, not the order they were
                    // written.** Positional arguments in the author's order would swap two props
                    // of the same type in silence — the compiler cannot see a mistake when both
                    // are `String`. Reading the callee's declaration is what makes that
                    // impossible, and it is the reason the driver hands the props over.
                    out = out + indent + "let " + label + ": Int = push(" + target + ", "
                        + star_function_name(fenced.name) + "(" + args + "));\n";
                    i += 1;
                    continue;
                }
                if !star_is_element(fenced.name) {
                    return Result.Error("STAR-E001 at " + star_at(source, fenced.offset)
                        + ": this host does not declare a block named `" + fenced.name
                        + "`. Elements, `for`/`if`/`match`/`props` and imported components are"
                        + " declared — a component needs a `use \"./" + fenced.name
                        + ".sbmx\";` in the `===bx` section");
                }
                // A void element with a body is refused HERE, with the author's
                // offset, rather than emitted and left to `html_element`'s `requires`
                // to catch at run time. Both refuse; only one of them refuses before
                // the page exists, and the contract is what makes the generator's
                // refusal provably complete rather than a list somebody maintains.
                if html_is_void(fenced.name) && len(fenced.children) > 0 {
                    return Result.Error("STAR-E004 at " + star_at(source, fenced.offset)
                        + ": `" + fenced.name + "` is a void element and cannot have a body."
                        + " Put whatever it needs in the head — `:" + fenced.name
                        + ": …` — and leave nothing between the fences");
                }
                // A key becomes an attribute the reconciler can match on. It is emitted
                // as a real expression, so `key line.idd` is a compile error naming the
                // field — an unchecked key would be worse than none, because it would
                // move a row's identity somewhere silently wrong.
                let mutable attrs: String = "[]";
                let mutable key_attr: String = "";
                if len(key_here) > 0 {
                    key_attr = "html_attr(\"data-star-key\", " + key_here + ")";
                }
                // The scoping marker, on every element THIS component emits. A child component's
                // elements carry the CHILD's marker, which is what stops a parent's `local` rules
                // reaching into it.
                let mut_marker: String = marker;
                let mark_attr: String = star_marker_attr(mut_marker);
                // What is left of the head once `on:` and `key` are off it is attributes.
                let with_child: String = star_head_without_key(star_head_without_event(fenced.head));
                let bare_head: String = star_head_without_child(with_child);
                let mutable written: String = "";
                let mutable flag_lines: String = "";
                match star_attrs_of(bare_head) {
                    Error(e) => {
                        return Result.Error(e + " (at " + star_at(source, fenced.offset) + ")");
                    }
                    Ok(pair) => { written = pair.inline; flag_lines = pair.flags; }
                }
                // Named once so every emission site below decides the same list.
                let holder: String = "at_" + tag + "_" + to_string(i);
                match star_event_part(fenced.head) {
                    None => { }
                    Some(part) => {
                        let event: String = star_event_name(part);
                        if !star_event_is_wired(event) {
                            // §4a.5: refuse an event we cannot wire, rather than
                            // emit something plausible. The driver installs a
                            // delegated listener per wired event and no others.
                            return Result.Error("STAR-E002 at " + star_at(source, fenced.offset)
                                + ": `on:" + event + "` is not an event this host can wire."
                                + star_event_hint(event));
                        }
                        // **A handler inside a `for` is refused, and refusing is the
                        // honest answer rather than a gap.** `dispatch` is a function of
                        // (handler, state); the loop variable is bound in the VIEW and does
                        // not exist there, so emitting the expression produces code that
                        // names something out of scope. The compiler would catch it — with
                        // an error about a variable the author never wrote in a function
                        // they never saw. Refusing here says the true thing instead.
                        //
                        // What it needs is for a handler id to carry a PATH INTO STATE
                        // rather than a captured value, so `dispatch` can re-derive the row
                        // from the state it is given. That is designed and not built, and
                        // it is why `key` landed first: a path through a positional index
                        // is ABA, since `items[3]` is not the same item after a splice.
                        // **A handler inside a `for` works now, and what it may NOT do is name
                        // the loop variable.** A handler runs in `dispatch`, a function of
                        // (handler, key, state); the loop variable was bound in the VIEW and is
                        // gone by then. So the row's identity crosses as its `key`, which is on
                        // the page as `data-star-key` and arrives as the `key` parameter.
                        //
                        // Refused HERE, naming the variable, rather than left to the compiler —
                        // which would say `unknown variable: row` inside a `dispatch` the author
                        // never wrote, about a binding they did write, in a file they did not.
                        if len(loop_var) > 0 && star_mentions(star_event_expression(part), loop_var) {
                            return Result.Error("STAR-E007 at " + star_at(source, fenced.offset)
                                + ": this handler names `" + loop_var + "`, which does not exist"
                                + " where handlers run — a handler is a function of (handler, key,"
                                + " state), and `" + loop_var + "` was bound while drawing the"
                                + " page. Use `key`, which carries this row's `key` expression as"
                                + " text: `string_to_int(key, 0)` for a number");
                        }
                        match star_trailing_attribute(star_event_expression(part)) {
                            None => { }
                            Some(name) => {
                                // **Two causes again, and one of the two answers cannot be followed.**
                                // A second `on:` is not an attribute out of order — it is a second
                                // event, and no ordering fixes it, because whichever comes first
                                // swallows the rest of the line. Telling that author to "put
                                // attributes first" is advice that cannot work, which is the failure
                                // `xml:lang` had an hour ago and STAR-E020 now avoids.
                                if star_mentions(name, "on:") {
                                    return Result.Error("STAR-E022 at " + star_at(source, fenced.offset)
                                        + ": an element takes ONE `on:` binding, and this head has two"
                                        + " — `on:" + event + "` and `" + name + "`. A handler is an"
                                        + " expression with no end marker, so the first one takes the"
                                        + " rest of the line. Put the second event on a wrapper, or"
                                        + " handle both in the one you keep");
                                }
                                return Result.Error("STAR-E022 at " + star_at(source, fenced.offset)
                                    + ": `on:" + event + "` runs to the end of the head, so `"
                                    + name + "=` after it becomes part of the handler instead of an"
                                    + " attribute. Put every attribute BEFORE the `on:` binding");
                            }
                        }
                        let index: Int = len(handlers);
                        let added: Int = push(handlers, StarHandler {
                            event: event,
                            expression: star_event_expression(part),
                        });
                        // **The EVENT travels with the index, and it has to.** The index alone says
                        // which handler; it does not say which event asked for it — and the driver
                        // wires every kind star accepts on one delegated listener, so an element
                        // carrying `data-star-h` used to run its handler for ANY of them. A `save`
                        // button fired on `mouseover`, and with a reconciler patching the DOM under
                        // the cursor it fired again, and again: found by pointing a real browser at a
                        // real Laravel app, where **495 rows were written while nobody touched the
                        // mouse.** One `on:` per element is what hid it — with a single index per
                        // element, the driver had nothing to compare against and nothing looked wrong.
                        attrs = "[html_attr(\"data-star-h\", \"" + to_string(index) + "\")"
                            + ", html_attr(\"data-star-on\", \"" + event + "\")"
                            + star_joined(key_attr) + star_joined(written)
                            + star_joined(mark_attr) + "]";
                    }
                }
                // **An element that takes phrasing content unwraps its paragraphs**, and
                // this is required rather than preferred: `<p>` is FLOW content and
                // `<button>` takes PHRASING, so `<button><p>x</p></button>` is invalid
                // HTML. BMX is right to parse `increment` as a paragraph — it is one —
                // and deciding what that means inside a button is the host's job.
                //
                // The first version of this rule said "a LONE paragraph becomes text",
                // which had a discontinuity in it: one paragraph became text and two
                // became two `<p>`, so adding a second line to a button changed the
                // output in KIND rather than in quantity. The content model has no such
                // seam — a phrasing element unwraps however many there are, and a flow
                // element keeps them, because in a `<div>` a `<p>` is correct and wanted.
                // **`child=` is the body, so it is emitted here and the block's own body must be
                // empty.** Two sources of content for one element is a document that does not say
                // what it means, and picking one silently is the failure this whole evening has been
                // about.
                match star_child_of(with_child) {
                    None => { }
                    Some(raw) => {
                        if len(fenced.children) > 0 {
                            return Result.Error("STAR-E021 at " + star_at(source, fenced.offset)
                                + ": `" + fenced.name + "` has a `child=` in its head AND a body"
                                + " between the fences. Pick one — `child=` is for the short form");
                        }
                        if html_is_void(fenced.name) {
                            return Result.Error("STAR-E004 at " + star_at(source, fenced.offset)
                                + ": `" + fenced.name + "` is a void element and cannot have a body,"
                                + " so it cannot take `child=`");
                        }
                        if attrs == "[]" { attrs = star_attr_list(key_attr, star_two(written, mark_attr)); }
                        if len(flag_lines) > 0 {
                            out = out + star_flag_block(attrs, flag_lines, holder, indent);
                            attrs = holder;
                        }
                        // **Braces mean an EXPRESSION; bare or quoted means text.** `child={…}` is
                        // Burxt between the braces, so the compiler judges it — `child={task.labl}`
                        // is an error naming the field. `child=hello` and `child="two words"` are the
                        // literal forms, read exactly as any other attribute value is, quotes off.
                        //
                        // `child={}` is an empty body, said out loud: there is a difference between an
                        // element an author left empty on purpose and one whose content went missing,
                        // and only one of them should be writeable.
                        let mutable content: String = "";
                        if star_is_braced(raw) {
                            let expression: String = star_unbraced(raw);
                            if len(expression) > 0 { content = "html_text(" + expression + ")"; }
                        } else {
                            content = "html_text(" + star_attr_value(star_unquoted(raw)) + ")";
                        }
                        out = out + indent + "let " + label + ": Int = push(" + target
                            + ", html_element(\"" + fenced.name + "\", " + attrs
                            + ", [" + content + "]));\n";
                        i += 1;
                        continue;
                    }
                }
                if star_takes_phrasing(fenced.name) {
                    let mutable phrasing: String = "";
                    let mutable c: Int = 0;
                    while c < len(fenced.children) {
                        match fenced.children[c] {
                            Paragraph(words) => {
                                match bmx_emit_inline(words.children) {
                                    Error(e) => { return Result.Error(e); }
                                    Ok(kids) => {
                                        // `bmx_emit_inline` yields a bracketed list; splice
                                        // the lists together rather than nesting them.
                                        let body: String = substring(kids, 1, len(kids) - 2);
                                        if len(phrasing) > 0 && len(body) > 0 { phrasing = phrasing + ", "; }
                                        phrasing = phrasing + body;
                                    }
                                }
                            }
                            Heading(h) => {
                                return Result.Error("STAR-E005 at " + star_at(source, h.offset)
                                    + ": `" + fenced.name + "` takes phrasing content, so it cannot"
                                    + " contain a heading");
                            }
                            Quote(q) => {
                                return Result.Error("STAR-E005 at " + star_at(source, q.offset)
                                    + ": `" + fenced.name + "` takes phrasing content, so it cannot"
                                    + " contain a quote");
                            }
                            List(l) => {
                                return Result.Error("STAR-E005 at " + star_at(source, l.offset)
                                    + ": `" + fenced.name + "` takes phrasing content, so it cannot"
                                    + " contain a list");
                            }
                            Code(cd) => {
                                return Result.Error("STAR-E005 at " + star_at(source, cd.offset)
                                    + ": `" + fenced.name + "` takes phrasing content, so it cannot"
                                    + " contain a code block");
                            }
                            Fenced(f) => {
                                // **A phrasing element may hold another phrasing element.**
                                // `<p><span>` and `<button><span class=box>` are correct HTML and
                                // ordinary in a styled component; what HTML forbids here is FLOW
                                // content, not nesting. The first version of this arm refused every
                                // nested block, which made a styled button impossible — found by
                                // the site's own showcase, where a checkbox is a `span` in a
                                // `button`.
                                //
                                // The nested element is built by RECURSING into this same function
                                // rather than by a second emitter: attributes, events, keys and
                                // components all have to work inside a `<span>` exactly as they do
                                // outside one, and two emitters would be two answers.
                                // **Is the child PHRASING, not does the child take flow.** Those
                                // are different questions and this asked the wrong one — see
                                // `star_is_phrasing`.
                                if !star_is_phrasing(f.name) {
                                    return Result.Error("STAR-E005 at " + star_at(source, f.offset)
                                        + ": `" + fenced.name + "` takes phrasing content, so it"
                                        + " cannot contain a `" + f.name + "` block");
                                }
                                let hold: String = "p_" + tag + "_" + to_string(i) + "_" + to_string(c);
                                let mutable one: [Block] = [];
                                let put: Int = push(one, fenced.children[c]);
                                match star_emit_stmts(source, known, marker, one, hold,
                                                      tag + "_p" + to_string(i) + "_" + to_string(c),
                                                      indent, handlers, "", loop_var) {
                                    Error(e) => { return Result.Error(e); }
                                    Ok(body) => {
                                        out = out + indent + "let mutable " + hold
                                            + ": [Html] = [];\n" + body;
                                        if len(phrasing) > 0 { phrasing = phrasing + ", "; }
                                        phrasing = phrasing + hold + "[0]";
                                    }
                                }
                            }
                        }
                        c += 1;
                    }
                    if attrs == "[]" { attrs = star_attr_list(key_attr, star_two(written, mark_attr)); }
                    if len(flag_lines) > 0 {
                        out = out + star_flag_block(attrs, flag_lines, holder, indent);
                        attrs = holder;
                    }
                    out = out + indent + "let " + label + ": Int = push(" + target
                        + ", html_element(\"" + fenced.name + "\", " + attrs
                        + ", [" + phrasing + "]));\n";
                    i += 1;
                    continue;
                }
                if false {
                    match fenced.children[0] {
                        Paragraph(words) => {
                            match bmx_emit_inline(words.children) {
                                Error(e) => { return Result.Error(e); }
                                Ok(kids) => {
                                    out = out + indent + "let " + label + ": Int = push(" + target
                                        + ", html_element(\"" + fenced.name + "\", " + attrs
                                        + ", " + kids + "));\n";
                                    i += 1;
                                    continue;
                                }
                            }
                        }
                        Heading(h) => { }
                        Quote(q) => { }
                        List(l) => { }
                        Code(c) => { }
                        Fenced(f) => { }
                    }
                }
                match star_emit_stmts(source, known, marker, fenced.children, inner, tag + "_" + to_string(i),
                                      indent, handlers, "", loop_var) {
                    Error(e) => { return Result.Error(e); }
                    Ok(body) => {
                        if attrs == "[]" { attrs = star_attr_list(key_attr, star_two(written, mark_attr)); }
                        if len(flag_lines) > 0 {
                            out = out + star_flag_block(attrs, flag_lines, holder, indent);
                            attrs = holder;
                        }
                        out = out + indent + "let mutable " + inner + ": [Html] = [];\n" + body;
                        out = out + indent + "let " + label + ": Int = push(" + target
                            + ", html_element(\"" + fenced.name + "\", " + attrs
                            + ", " + inner + "));\n";
                    }
                }
            }
            Heading(heading) => {
                match bmx_emit_one(blocks[i]) {
                    Error(e) => { return Result.Error(e); }
                    Ok(expr) => { out = out + indent + "let " + label + ": Int = push(" + target
                                     + ", " + star_marked(expr, marker) + ");\n"; }
                }
            }
            Paragraph(words) => {
                match bmx_emit_one(blocks[i]) {
                    Error(e) => { return Result.Error(e); }
                    Ok(expr) => { out = out + indent + "let " + label + ": Int = push(" + target
                                     + ", " + star_marked(expr, marker) + ");\n"; }
                }
            }
            Quote(words) => {
                match bmx_emit_one(blocks[i]) {
                    Error(e) => { return Result.Error(e); }
                    Ok(expr) => { out = out + indent + "let " + label + ": Int = push(" + target
                                     + ", " + star_marked(expr, marker) + ");\n"; }
                }
            }
            List(list) => {
                match bmx_emit_one(blocks[i]) {
                    Error(e) => { return Result.Error(e); }
                    Ok(expr) => { out = out + indent + "let " + label + ": Int = push(" + target
                                     + ", " + star_marked(expr, marker) + ");\n"; }
                }
            }
            Code(code) => {
                match bmx_emit_one(blocks[i]) {
                    Error(e) => { return Result.Error(e); }
                    Ok(expr) => { out = out + indent + "let " + label + ": Int = push(" + target
                                     + ", " + star_marked(expr, marker) + ");\n"; }
                }
            }
        }
        i += 1;
    }
    return Result.Ok(out);
}

// The `props` head is the component's signature — declared by the component, so an
// invoker never needs an out-of-band list. BMX captured it opaquely; reading it is
// ours, and it goes through verbatim into the function's parameter list, where the
// compiler judges every name and type in it.
pure function star_props(blocks: [Block]) -> String {
    let mutable i: Int = 0;
    while i < len(blocks) {
        match blocks[i] {
            Fenced(fenced) => { if fenced.name == "props" { return fenced.head; } }
            Heading(h) => { }
            Paragraph(p) => { }
            Quote(q) => { }
            List(l) => { }
            Code(c) => { }
        }
        i += 1;
    }
    return "";
}

// The whole of it: a document becomes a `pure function ... -> Html` and a
// `pure function ..._dispatch(handler: Int, <props>) -> <state>`.
//
// **`state` is the FIRST prop's type**, which is the v1 rule and is stated here
// rather than inferred: a handler yields the next state, and with one prop that is
// unambiguous. Structured state is the open v2 question — regions are LIFO and
// nested regions do not exist, so nothing built inside a frame can outlive it.
//
// Both functions are `pure`, so `burxt effects --allow ""` confirms a component
// reaches nothing — a confirmation by construction rather than a discovery.
// The `use` lines of a `===bx` section, and everything else, split apart.
//
// Burxt finds imports by scanning a file's LEADING lines and stops at the first declaration — a
// `use` after a `class` is a syntax error, measured rather than assumed. So a component's imports
// have to be lifted above the generated header, and the rest of the author's code placed after it.
//
// A `use` is recognised at the start of a line, which is where the language requires it anyway.
function star_imports_of(code: String) -> String {
    let mutable out: String = "";
    let width: Int = len(code);
    let mutable at: Int = 0;
    while at < width {
        let stop: Int = star_end_of_line(code, at, width);
        let line: String = substring(code, at, stop - at);
        if star_is_use_line(line) {
            out = out + line + "\n";
        }
        at = stop + 1;
    }
    return out;
}

function star_code_without_imports(code: String) -> String {
    let mutable out: String = "";
    let width: Int = len(code);
    let mutable at: Int = 0;
    while at < width {
        let stop: Int = star_end_of_line(code, at, width);
        let line: String = substring(code, at, stop - at);
        if !star_is_use_line(line) {
            out = out + line + "\n";
        }
        at = stop + 1;
    }
    return out;
}

pure function star_is_use_line(line: String) -> Bool {
    let mutable i: Int = 0;
    while i < len(line) && byte_at(line, i) == 32 {
        i += 1;
    }
    if i + 4 > len(line) {
        return false;
    }
    return byte_at(line, i) == 117 && byte_at(line, i + 1) == 115
        && byte_at(line, i + 2) == 101 && byte_at(line, i + 3) == 32;
}

// What to write instead of an event this host cannot wire.
//
// **This used to name four events and there are thirty-nine.** The list was written when there were
// four and never revisited, so the message told an author their options were `click`, `input`,
// `change` and `submit` long after `keydown` and `mouseenter` worked. **A stale list inside an error
// is worse than no list**: a reader believes it, stops looking, and builds around a limit that was
// lifted.
//
// It names groups rather than all thirty-nine, because a message a person scrolls is a message they
// do not read — and it names the nearest thing for the cases somebody actually reaches for.
pure function star_event_hint(asked: String) -> String {
    // `hover` is the one worth answering specially, because it is not a DOM event at all — it is a
    // CSS pseudo-class, and the reason somebody asks for it is usually styling rather than state.
    if asked == "hover" {
        return " There is no `hover` event — hovering is CSS. Use `:hover` in a"
            + " `===style.local` section, or `on:mouseenter` and `on:mouseleave` if the hover has"
            + " to change your state.";
    }
    if asked == "keypress" {
        return " Use `on:keydown` — `keypress` is deprecated and does not fire for every key.";
    }
    if asked == "mousemove" {
        return " Use `on:pointermove`, which covers a mouse, a pen and a finger.";
    }
    return " Wired: click, dblclick, contextmenu; keydown, keyup; input, change, submit, reset,"
        + " focus, blur, focusin, focusout; the pointer and mouse events (down, up, move, enter,"
        + " leave, over, out); dragstart, dragover, dragleave, drop, dragend; touchstart, touchmove,"
        + " touchend; wheel, scroll; and the animation and transition events.";
}

// A byte offset as `line:column`, which is what every other tool in this project prints and what an
// editor can jump to. `bmx_where` does the conversion and star does NOT write its own: **column
// counts CHARACTERS, not bytes**, so a hand-rolled version is correct on every ASCII line and puts
// the caret one place wrong on the first line with an accent in it — and whoever writes it tests
// with ASCII. BMX measured that on a line containing `å` before shipping it.
//
// One-based, matching `burxt` and matching what an editor shows. LSP is zero-based; that
// subtraction belongs to whoever speaks LSP.
pure function star_at(source: String, offset: Int) -> String {
    let w: BmxWhere = bmx_where(source, offset);
    return to_string(w.line) + ":" + to_string(w.column);
}

// Small path helpers, here rather than in `std/path.bx`, because star's driver needs four of them
// and a dependency for four functions is a dependency to keep in step for four functions.
function star_directory_of(path: String) -> String {
    let mutable cut: Int = 0 - 1;
    let mutable i: Int = 0;
    while i < len(path) {
        if byte_at(path, i) == 47 { cut = i; }
        i += 1;
    }
    if cut < 0 {
        return "";
    }
    return substring(path, 0, cut + 1);
}

function star_without_extension(path: String) -> String {
    let mutable cut: Int = len(path);
    let mutable i: Int = 0;
    while i < len(path) {
        if byte_at(path, i) == 46 { cut = i; }
        i += 1;
    }
    return substring(path, 0, cut);
}

function star_ends_with(text: String, suffix: String) -> Bool {
    if len(suffix) > len(text) {
        return false;
    }
    return substring(text, len(text) - len(suffix), len(suffix)) == suffix;
}

// The path inside `use "..."`, or the empty String.
function star_quoted_path(line: String) -> String {
    let mutable i: Int = 0;
    while i < len(line) && byte_at(line, i) != 34 {
        i += 1;
    }
    if i >= len(line) {
        return "";
    }
    i += 1;
    let from: Int = i;
    while i < len(line) && byte_at(line, i) != 34 {
        i += 1;
    }
    return substring(line, from, i - from);
}

// `./Badge.sbmx` -> `Badge`. The BLOCK NAME an author writes, so the file name and the markup
// cannot drift: renaming the file renames the block.
function star_component_name(target: String) -> String {
    let base: String = substring(target, len(star_directory_of(target)),
                                 len(target) - len(star_directory_of(target)));
    return star_without_extension(base);
}

// Each `.sbmx` import respelled to the stem its generated `.bx` actually lives at, which is
// `StarKnown.source` — see that class for why the written spelling will not do.
//
// **Unchanged input is returned unchanged, byte for byte**, rather than reconstructed and handed back.
// Every existing document imports by path, so `source` is already the written stem and this would
// rebuild the section to produce the same thing — except for the trailing newline and any line the
// reconstruction normalised. `docs/_includes/showcase.html` and the gallery are checked by
// regenerating and diffing, so a whitespace-only difference here is a red build about nothing.
function star_code_with_known_paths(code: String, known: [StarKnown]) -> String {
    let mutable out: String = "";
    let mutable changed: Bool = false;
    let width: Int = len(code);
    let mutable at: Int = 0;
    while at < width {
        let stop: Int = star_end_of_line(code, at, width);
        let line: String = substring(code, at, stop - at);
        let mutable emitted: String = line;
        if star_is_use_line(line) {
            let target: String = star_quoted_path(line);
            if star_ends_with(target, ".sbmx") {
                let wanted: String = star_component_name(target);
                let mutable k: Int = 0;
                while k < len(known) {
                    if known[k].name == wanted && len(known[k].source) > 0
                       && known[k].source + ".sbmx" != target {
                        emitted = "use \"" + known[k].source + ".sbmx\";";
                        changed = true;
                    }
                    k += 1;
                }
            }
        }
        out = out + emitted + "\n";
        at = stop + 1;
    }
    if !changed {
        return code;
    }
    return out;
}

// The author's imports as the GENERATED file needs them: a `.sbmx` becomes the `.bx` it was
// generated into, and everything else passes through.
function star_burxt_imports(code: String) -> String {
    let mutable out: String = "";
    let imports: String = star_imports_of(code);
    let mutable at: Int = 0;
    while at < len(imports) {
        let stop: Int = star_end_of_line(imports, at, len(imports));
        let line: String = substring(imports, at, stop - at);
        let target: String = star_quoted_path(line);
        if star_ends_with(target, ".sbmx") {
            out = out + "use \"" + star_without_extension(target) + ".bx\";\n";
        } else {
            if len(bmx_strip_end(line)) > 0 {
                out = out + line + "\n";
            }
        }
        at = stop + 1;
    }
    return out;
}

// ---- styles ----------------------------------------------------------------------------------
//
//     ===style.local     scoped to this component
//     ===style.global    exactly as written
//
// **There is no default, and that is the design.** Vue's `<style>` is global unless you remember
// `scoped`; Apex is the same shape. Here neither spelling is shorter, so neither is the lazy
// choice — the same rule as `Decimal<2>` refusing to round until you say how. **The dangerous
// option does not get to be the short one.**
//
// Scoping stamps `data-s-<name>` on every element THIS component emits and appends the matching
// attribute to every selector. `.card` becomes `.card[data-s-page]`.
//
// A descendant selector — `[data-s-page] .card` — would have been three lines shorter and would
// leak into child components, because a child's elements sit inside this one's subtree. Exact
// matching cannot: a child's elements carry the CHILD's marker, so a parent's `.card` rule stops
// at the boundary. That is what `local` has to mean to be worth writing.

// Every selector in the sheet, with the marker appended. Declarations are untouched.
pure function star_scoped_css(css: String, marker: String) -> String {
    let mutable out: String = "";
    let mutable selector: String = "";
    let mutable depth: Int = 0;
    let mutable i: Int = 0;
    while i < len(css) {
        let b: Int = byte_at(css, i);
        if depth == 0 && b == 123 {
            let head: String = star_trim(selector);
            // **An at-rule with a block holds RULES, and those are what need scoping.** `@media`
            // is not a selector; stamping it produces `@media (max-width: 600px)[data-s-x]`, which
            // is not CSS. Its body is scoped by walking it, so the rules inside get the marker and
            // the at-rule itself does not.
            if len(head) > 0 && byte_at(head, 0) == 64 {
                let close: Int = star_matching_brace(css, i);
                out = out + head + " \{" + star_scoped_css(substring(css, i + 1, close - i - 1), marker)
                    + "\}";
                selector = "";
                i = close;
            } else {
                out = out + star_scoped_selector(selector, marker) + " \{";
                selector = "";
                depth += 1;
            }
        } else {
            if depth > 0 {
                out = out + byte_as_string(b);
                if b == 123 { depth += 1; }
                if b == 125 { depth -= 1; }
            } else {
                selector = selector + byte_as_string(b);
            }
        }
        i += 1;
    }
    // Whatever is left was never a rule — an `@import`, a comment, trailing space. It goes through
    // unchanged rather than being dropped, because a stylesheet star silently shortened would be
    // very hard to debug from the page.
    return out + selector;
}

// The index of the `\}` closing the `\{` at `from`.
pure function star_matching_brace(css: String, from: Int) -> Int {
    let mutable depth: Int = 0;
    let mutable i: Int = from;
    while i < len(css) {
        if byte_at(css, i) == 123 { depth += 1; }
        if byte_at(css, i) == 125 {
            depth -= 1;
            if depth == 0 {
                return i;
            }
        }
        i += 1;
    }
    return len(css) - 1;
}

// `.card, .note p` -> `.card[data-s-x], .note p[data-s-x]`. Appended to the END of each
// comma-separated selector, which is the element the rule actually styles.
pure function star_scoped_selector(selector: String, marker: String) -> String {
    let mutable out: String = "";
    let mutable one: String = "";
    let mutable i: Int = 0;
    // **A comma inside `:not(…)`, `:is(…)` or `[title="a,b"]` is not a separator**, and this is the
    // seventh instance of one sentence: a delimiter rule has to know what protects a delimiter.
    // Without the guard, `.x:not(.a .b, .c)` split mid-parenthesis and the marker landed INSIDE the
    // `:not()`, so the rule excluded `.a .b[data-s-c]` rather than `.a .b`. Valid CSS, silent, and
    // the wrong meaning — which is the shape every one of the seven had.
    let mutable round: Int = 0;
    let mutable square: Int = 0;
    let mutable quote: Int = 0;
    while i <= len(selector) {
        if i < len(selector) && quote == 0 {
            let c: Int = byte_at(selector, i);
            if c == 40 { round += 1; }
            if c == 41 { round -= 1; }
            if c == 91 { square += 1; }
            if c == 93 { square -= 1; }
        }
        if i < len(selector) && (byte_at(selector, i) == 34 || byte_at(selector, i) == 39) {
            if quote == 0 { quote = byte_at(selector, i); }
            else { if quote == byte_at(selector, i) { quote = 0; } }
        }
        if i == len(selector)
            || (byte_at(selector, i) == 44 && round == 0 && square == 0 && quote == 0) {
            let trimmed: String = star_trim(one);
            if len(trimmed) > 0 {
                if len(out) > 0 { out = out + ", "; }
                // An at-rule — `@media (...)` — is not a selector and must not be stamped. Its
                // BODY holds rules, and those are scoped when the walk reaches them.
                if byte_at(trimmed, 0) == 64 {
                    out = out + trimmed;
                } else {
                    out = out + star_stamped(trimmed, marker);
                }
            }
            one = "";
        } else {
            one = one + byte_as_string(byte_at(selector, i));
        }
        i += 1;
    }
    return out;
}

// One selector with the component's marker attached to its LAST element — before any pseudo.
//
// **`.row::before[data-s-hero]` is invalid CSS and a browser drops the whole rule, silently.** The
// first version appended the attribute at the end of the selector, which is correct for `.row` and
// wrong for every `:hover`, `:focus`, `::before` and `::after` in a `===style.local` section. So
// every hover state in this repository had been dead since styles landed, and nothing could say so:
// a dropped CSS rule looks exactly like a rule that decided not to change anything. Found by putting
// a checkbox in a pseudo-element to shorten a document — the squares vanished from the picture.
//
// The attribute goes before the first `:` of the last compound selector: `.row[data-s-hero]::before`.
// A descendant selector stamps only its last part, which is what scoping means — `.card h1` becomes
// `.card h1[data-s-hero]`, not `.card[data-s-hero] h1`, so a parent's rule cannot reach into a child
// component.
pure function star_stamped(selector: String, marker: String) -> String {
    let attribute: String = "[data-s-" + marker + "]";
    // Where the last compound selector starts: after the last space, `>`, `+` or `~`.
    let mutable from: Int = 0;
    let mutable i: Int = 0;
    let mutable depth: Int = 0;
    while i < len(selector) {
        let c: Int = byte_at(selector, i);
        // A combinator inside `:not(.a .b)` or `[title="a b"]` joins nothing at this level — the last
        // compound is the whole `:not(…)`, not the `.b` inside it.
        if c == 40 || c == 91 { depth += 1; }
        if c == 41 || c == 93 { depth -= 1; }
        if depth == 0 && (c == 32 || c == 62 || c == 43 || c == 126) { from = i + 1; }
        i += 1;
    }
    // The first `:` at or after that point is where a pseudo begins, and the marker goes before it.
    let mutable at: Int = len(selector);
    let mutable j: Int = from;
    let mutable inside: Int = 0;
    while j < len(selector) {
        if byte_at(selector, j) == 40 || byte_at(selector, j) == 91 { inside += 1; }
        if byte_at(selector, j) == 41 || byte_at(selector, j) == 93 { inside -= 1; }
        if byte_at(selector, j) == 58 && inside == 0 {
            at = j;
            j = len(selector);
        } else {
            j += 1;
        }
    }
    return substring(selector, 0, at) + attribute + substring(selector, at, len(selector) - at);
}

// ---- components ------------------------------------------------------------------------------
//
// `::: Badge value={{ model.count }}` is a call. The component is another `.sbmx`, imported with
// the language's own `use` — no implicit file resolution, because Burxt's loader refuses to guess
// when an import could mean two things, and a framework on top of it should not introduce
// searching.
//
// **star.bx does not read files.** The driver resolves the imports, generates each component, and
// hands back what it learned — name and props. That keeps `touches files` out of the generator,
// and it is what lets the argument list be built in the CALLEE's declared order rather than in the
// order the author happened to type.

// A component this document may use: its name as written, the props of the function it became, and
// **the import path its generated `.bx` will answer to**.
//
// That third field exists because a `.sbmx` import has two spellings with the same shape and only the
// compiler can tell them apart. `use "Badge.sbmx"` is a path beside the document; `use "mylib/Card.sbmx"`
// is a component inside a *package*, and where that package sits on disk is derived from its source —
// a git dependency lands under `.burxt/packages` beside a key made from url and tag, a path dependency
// never goes near it. star must not re-derive either; `resolve.bx` asks `burxt where` and puts the
// answer here.
//
// **It cannot simply be the import as written, because that spelling is refused.** A package component
// generated into `./mylib/Card.bx` makes `use "mylib/Card.bx"` mean two things at once, and the
// compiler says so rather than choosing: *"could mean the dependency `mylib` declared in
// burxt.package, or the file at mylib/Card.bx. Rename one of them."* So a package component is
// generated into `.star/<pkg>/` in the CONSUMER's tree — never into the package, which for a git
// dependency is a fetch-managed cache whose directory name changes the day the tag does — and this
// field carries the stem that reaches it.
//
// A local import answers its own stem, so this is exactly what it always was for every document
// written before packages resolved at all.
public class StarKnown { name: String, props: String, source: String }

// `Badge` -> `badge`, `UserCard` -> `user_card`. Burxt functions are snake_case and a component is
// a Burxt function; the block name is the type-shaped spelling an author expects in markup.
pure function star_function_name(name: String) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(name) {
        let b: Int = byte_at(name, i);
        if b >= 65 && b <= 90 {
            if i > 0 { out = out + "_"; }
            out = out + byte_as_string(b + 32);
        } else {
            out = out + byte_as_string(b);
        }
        i += 1;
    }
    return out;
}

pure function star_known_at(known: [StarKnown], name: String) -> Int {
    let mutable i: Int = 0;
    while i < len(known) {
        if known[i].name == name {
            return i;
        }
        i += 1;
    }
    return 0 - 1;
}

// The names a props declaration binds, in order: `value: Int, label: String` -> value, label.
pure function star_prop_names(props: String) -> [String] {
    let mutable out: [String] = [];
    let mutable at: Int = 0;
    let width: Int = len(props);
    while at < width {
        while at < width && (byte_at(props, at) == 32 || byte_at(props, at) == 44) {
            at += 1;
        }
        let from: Int = at;
        while at < width && byte_at(props, at) != 58 {
            at += 1;
        }
        if at > from {
            let pushed: Int = push(out, bmx_strip_end(substring(props, from, at - from)));
        }
        // Past the type, to the next comma at depth zero — a type may hold commas of its own,
        // as `Decimal<2, RoundHalfEven>` does.
        let mutable depth: Int = 0;
        while at < width && (depth > 0 || byte_at(props, at) != 44) {
            if byte_at(props, at) == 60 { depth += 1; }
            if byte_at(props, at) == 62 { depth -= 1; }
            at += 1;
        }
    }
    return out;
}

// The value written for one attribute name in a head, or the empty String when it is absent.
pure function star_head_value(head: String, wanted: String) -> String {
    match star_attrs_of(head) {
        Error(e) => { return ""; }
        Ok(pair) => { }
    }
    let width: Int = len(head);
    let mutable i: Int = 0;
    while i < width {
        while i < width && byte_at(head, i) == 32 {
            i += 1;
        }
        let name_from: Int = i;
        while i < width && !star_separates(byte_at(head, i)) && byte_at(head, i) != 61 {
            i += 1;
        }
        let name: String = substring(head, name_from, i - name_from);
        let mutable value: String = "";
        if i < width && byte_at(head, i) == 61 {
            i += 1;
            if i < width && byte_at(head, i) == 34 {
                i += 1;
                let from: Int = i;
                while i < width && byte_at(head, i) != 34 {
                    i += 1;
                }
                value = "\"" + substring(head, from, i - from) + "\"";
                if i < width { i += 1; }
            } else {
                let from: Int = i;
                let mutable depth: Int = 0;
                while i < width && (depth > 0 || byte_at(head, i) != 32) {
                    if i + 1 < width && byte_at(head, i) == 123 && byte_at(head, i + 1) == 123 {
                        depth += 1;
                        i += 1;
                    }
                    if i + 1 < width && byte_at(head, i) == 125 && byte_at(head, i + 1) == 125 {
                        depth -= 1;
                        i += 1;
                    }
                    i += 1;
                }
                value = star_attr_value(substring(head, from, i - from));
            }
        }
        if name == wanted {
            return value;
        }
    }
    return "";
}

// ---- attributes ---------------------------------------------------------------------------
//
// `::: a href=/about class=nav` — the head, once `on:` and `key` have been taken off it, is a list
// of `name=value` pairs. Without these star can emit a page and not style it, which is the
// difference between a renderer and something anybody would ship.
//
// **A value ends at a space, or is quoted.** `class="a b"` for a value with spaces. That rule is
// forced rather than chosen: an `on:` expression runs to the end of the head, because expressions
// contain spaces and equals signs and the format does not parse heads. So `on:` is written last and
// everything before it is attributes.
//
// **A value may interpolate.** `href=/posts/{{ to_string(id) }}` becomes a concatenation, with the
// expression going through verbatim exactly as a slot does — so a typo in it is a compile error
// naming what the author wrote, rather than a link to a page that does not exist.
//
// A bare name is a boolean attribute: `::: input disabled` emits `disabled=""`, which is how HTML
// spells true.
//
// **But only for the names that HAVE a boolean spelling, and that set is closed.** `:h2: class=title
// Order :!h2:` emitted `<h2 class="title" Order="">` — a heading with no text in it, silently, and I
// shipped exactly that twice in one afternoon while styling. It also reached a released example:
// `Choices.sbmx` had `:legend: tone :!legend:` and `:option: value=small small :!option:`, so its
// dropdown labels were BLANK and its fieldset unlabelled. The browser test I wrote for it asserted the
// model and never looked at the text.
//
// `child=` already exists for exactly this, which is what makes refusing safe: there is a spelling that
// means what the author meant. So a valueless token that is not one of HTML's own booleans is a
// mistake worth naming — and `data-` and `aria-` stay open because an author's own attributes are
// theirs to invent.
// What a head's attributes compile to. **`flags` is the half that depends on the STATE**, and it has to
// be separate because HTML has no way to spell a false boolean: `checked="false"` is checked, and the
// only way to say "not checked" is for the attribute not to be there. So `checked={{ model.agree }}`
// cannot be an attribute with a computed value — it has to be a decision about whether the attribute
// exists, which is a statement rather than an expression.
//
// **Until this existed a form could not show its own state.** Server-rendering `Choices.sbmx` with
// `agree: true, size: "large"` produced no `checked` and no `selected` anywhere: the first paint showed
// an empty form, the client hydrated to the same HTML, and the page disagreed with the model with
// nothing reported. That is the whole reason a checkbox is the first thing anyone tries.
//
// One scanner produces both halves, because two scanners over the same head is how a delimiter rule
// comes to have two answers — which has cost this project nine defects in one class already.
class StarAttrs { inline: String, flags: String }

pure function star_is_bare_flag(name: String) -> Bool {
    if len(name) > 5 && substring(name, 0, 5) == "data-" { return true; }
    if len(name) > 5 && substring(name, 0, 5) == "aria-" { return true; }
    return star_in_set(name,
        " allowfullscreen async autofocus autoplay checked controls default defer disabled download"
        + " formnovalidate hidden inert ismap itemscope loop multiple muted nomodule novalidate open"
        + " playsinline readonly required reversed selected ");
}

// `, x` when x is there, nothing when it is not — so a list can be built by concatenation without
// a trailing comma nobody can see in generated source.
pure function star_joined(term: String) -> String {
    if len(term) == 0 {
        return "";
    }
    return ", " + term;
}

// The name a `for` binds, or the empty String for anything else. `for row in rows` -> `row`.
//
// Threaded down instead of a boolean, because the refusal below names it — *this handler names
// `row`* is a sentence an author can act on, and *handlers do not work in loops* was not.
pure function star_binds(name: String, head: String, outer: String) -> String {
    if name != "for" {
        return outer;
    }
    let mutable i: Int = 0;
    while i < len(head) && byte_at(head, i) == 32 {
        i += 1;
    }
    let from: Int = i;
    while i < len(head) && byte_at(head, i) != 32 {
        i += 1;
    }
    if i > from {
        return substring(head, from, i - from);
    }
    return outer;
}

// Where the subject of a `for` starts — after the bound name and the ` in `.
pure function star_loop_subject_at(head: String) -> Int {
    let mutable i: Int = 0;
    while i < len(head) && byte_at(head, i) == 32 { i += 1; }
    while i < len(head) && byte_at(head, i) != 32 { i += 1; }        // the bound name
    while i < len(head) && byte_at(head, i) == 32 { i += 1; }
    if i + 2 <= len(head) && byte_at(head, i) == 105 && byte_at(head, i + 1) == 110 {
        i += 2;                                                      // `in`
        while i < len(head) && byte_at(head, i) == 32 { i += 1; }
        return i;
    }
    return 0;
}

// True when the subject is a call, and so has to be bound before the loop.
pure function star_loop_needs_binding(name: String, head: String) -> Bool {
    if name != "for" { return false; }
    let at: Int = star_loop_subject_at(head);
    if at == 0 { return false; }
    return star_mentions(substring(head, at, len(head) - at), "(");
}

pure function star_loop_prelude(name: String, head: String, tag: String) -> String {
    if !star_loop_needs_binding(name, head) { return ""; }
    let at: Int = star_loop_subject_at(head);
    return "let rows_" + tag + " = " + substring(head, at, len(head) - at) + ";\n    ";
}

pure function star_loop_head(name: String, head: String, tag: String) -> String {
    if !star_loop_needs_binding(name, head) { return head; }
    let at: Int = star_loop_subject_at(head);
    return substring(head, 0, at) + "rows_" + tag;
}

pure function star_marker_attr(marker: String) -> String {
    if len(marker) == 0 {
        return "";
    }
    return "html_attr(\"data-s-" + marker + "\", \"\")";
}

// Put this component's marker on every element inside an expression BMX emitted.
//
// **A heading is an element too, and `===style.local` could not reach one.** Every block written as
// markdown — a heading, a paragraph, a list, a quote, a code block, and the `em`/`strong`/`code`
// inside them — comes out of BMX as `html_element("h1", [], …)` with no attributes, while a `::: p`
// block goes through star's own path and gets marked. So a local rule for `.card h1` matched
// nothing, and the fix belongs here rather than in BMX: the marker is star's, and BMX must not know
// that a host scopes anything. Found by the site's own showcase, where the card's title was the one
// unstyled thing in the picture.
//
// The scan SKIPS STRING LITERALS, and that is not caution for its own sake: a document whose prose
// contains the text `html_element("x", [], ` would otherwise have an attribute spliced into a
// visible sentence.
pure function star_marked(expr: String, marker: String) -> String {
    if len(marker) == 0 {
        return expr;
    }
    let attr: String = star_marker_attr(marker);
    let head: String = "html_element(\"";
    let empty: String = ", [], ";
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(expr) {
        // A string literal goes through verbatim, escapes and all.
        if byte_at(expr, i) == 34 {
            out = out + "\"";
            i += 1;
            while i < len(expr) && byte_at(expr, i) != 34 {
                if byte_at(expr, i) == 92 && i + 1 < len(expr) {
                    out = out + substring(expr, i, 2);
                    i += 2;
                    continue;
                }
                out = out + substring(expr, i, 1);
                i += 1;
            }
            if i < len(expr) {
                out = out + "\"";
                i += 1;
            }
            continue;
        }
        // `html_element("` — the tag's name is a literal, so read it here rather than letting the
        // string branch above have it, and then the empty attribute list is the next thing.
        if i + len(head) <= len(expr) && substring(expr, i, len(head)) == head {
            let from: Int = i + len(head);
            let mutable j: Int = from;
            while j < len(expr) && byte_at(expr, j) != 34 {
                j += 1;
            }
            if j < len(expr) && j + 1 + len(empty) <= len(expr)
                && substring(expr, j + 1, len(empty)) == empty {
                out = out + substring(expr, i, j + 1 - i) + ", [" + attr + "], ";
                i = j + 1 + len(empty);
                continue;
            }
            out = out + substring(expr, i, j + 1 - i);
            i = j + 1;
            continue;
        }
        out = out + substring(expr, i, 1);
        i += 1;
    }
    return out;
}

pure function star_two(a: String, b: String) -> String {
    if len(a) == 0 {
        return b;
    }
    return a + star_joined(b);
}

pure function star_attr_list(key_attr: String, written: String) -> String {
    let mutable inner: String = key_attr;
    if len(inner) == 0 {
        inner = written;
    } else {
        inner = inner + star_joined(written);
    }
    return "[" + inner + "]";
}

// The Burxt expression for one attribute value: a String literal, or a concatenation when the value
// interpolates. `/posts/{{ to_string(id) }}` -> `"/posts/" + to_string(id)`.
// ---- `child=` — a body written in the head ----------------------------------------------------
//
// **The one-liner's ambiguity, solved without touching the format.** BMX's heads are opaque bytes by
// §4a.1, so in `:span: class=text hello :!span:` nothing tells the parser where the head ends and the
// body begins — and BMX's answer is that it is ALL head, which is right: head meaning is the host's.
//
// Andre's answer is to name it. `child=hello` is an ordinary `name=value` pair, so:
//
//   - the format changes not at all, and BMX keeps its opaque head
//   - there is nothing to guess: every token in the head is still `name=value`
//   - it escapes at the boundary where head meaning already lives, through `html_text`
//
// **It also fixes a defect that predates one-liners.** `::: span class=text hello` read `hello` as a
// boolean attribute and emitted `<span class="text" hello></span>` — the text SILENTLY gone. With
// `child=` there is a spelling that means what the author meant, and the bare word keeps meaning a
// boolean attribute, which is what it means in HTML.
//
// **`child`, not `value`.** `value` is a real HTML attribute and star already emits it —
// `::: input value={{ model.draft }}` is how a field is driven. Overloading it would break every form
// in the documentation, so the one name that cannot be used is the obvious one.
pure function star_child_of(head: String) -> Option<String> {
    let mutable i: Int = 0;
    while i + 6 <= len(head) {
        // `child=` at the start of the head or after a space, so `data-child=` is untouched.
        if byte_at(head, i) == 99 && byte_at(head, i + 1) == 104 && byte_at(head, i + 2) == 105
            && byte_at(head, i + 3) == 108 && byte_at(head, i + 4) == 100
            && byte_at(head, i + 5) == 61 && star_at_token_start(head, i) {
            let from: Int = i + 6;
            let stop: Int = star_value_end(head, from);
            return Option.Some(substring(head, from, stop - from));
        }
        i += 1;
    }
    return Option.None;
}

// The head with `child=` removed, so what is left is attributes.
pure function star_head_without_child(head: String) -> String {
    let mutable i: Int = 0;
    while i + 6 <= len(head) {
        if byte_at(head, i) == 99 && byte_at(head, i + 1) == 104 && byte_at(head, i + 2) == 105
            && byte_at(head, i + 3) == 108 && byte_at(head, i + 4) == 100
            && byte_at(head, i + 5) == 61 && star_at_token_start(head, i) {
            let stop: Int = star_value_end(head, i + 6);
            let before: String = substring(head, 0, i);
            let after: String = substring(head, stop, len(head) - stop);
            return star_trim(before + after);
        }
        i += 1;
    }
    return head;
}

// Where an attribute's value ends: a quoted value at its closing quote, an interpolation at its
// closing braces, anything else at the next space. **The same rule `star_attrs_of` uses**, because two
// answers to "where does this value end" is how `child="a b"` and `class="a b"` come to disagree.
pure function star_value_end(head: String, from: Int) -> Int {
    let width: Int = len(head);
    let mutable i: Int = from;
    // **A brace-delimited value, `child={…}`, ends at its MATCHING brace.** Andre's form, and it earns
    // its place by removing a rule rather than adding one: the braces say where the value ends, so a
    // body with spaces in it needs no quotes, and `child={}` is an empty body said out loud. Matched
    // rather than "up to the next `}`", so a body holding a record literal survives.
    if i < width && byte_at(head, i) == 123 {
        let mutable depth: Int = 0;
        while i < width {
            // **A brace inside a STRING is not a brace.** `child={pick("\}", n)}` ended at the `\}`
            // in the literal, leaving `, n)}` to be read as attributes — and the refusal that came out
            // blamed `"` for not being an attribute name, which sends a reader to the wrong problem.
            //
            // BMX shipped the same defect in `-> [title="a\]b"]` an hour after documenting why
            // first-delimiter-wins was safe. **A delimiter rule has to know what protects a
            // delimiter**, and a quoted run is the only thing that protects one here.
            if byte_at(head, i) == 34 {
                i += 1;
                while i < width && byte_at(head, i) != 34 {
                    if byte_at(head, i) == 92 && i + 1 < width { i += 1; }
                    i += 1;
                }
                if i < width { i += 1; }
                continue;
            }
            if byte_at(head, i) == 123 { depth += 1; }
            if byte_at(head, i) == 125 {
                depth -= 1;
                if depth == 0 { return i + 1; }
            }
            i += 1;
        }
        return i;
    }
    if i < width && byte_at(head, i) == 34 {
        i += 1;
        while i < width && byte_at(head, i) != 34 { i += 1; }
        if i < width { i += 1; }
        return i;
    }
    let mutable depth: Int = 0;
    let mutable round: Int = 0;
    while i < width && (depth > 0 || round > 0 || !star_separates(byte_at(head, i))) {
        // A quoted run protects every delimiter inside it — see the same guard in `star_attrs_of`.
        if byte_at(head, i) == 34 {
            i += 1;
            while i < width && byte_at(head, i) != 34 {
                if byte_at(head, i) == 92 && i + 1 < width { i += 1; }
                i += 1;
            }
            if i < width { i += 1; }
            continue;
        }
        if i + 1 < width && byte_at(head, i) == 123 && byte_at(head, i + 1) == 123 {
            depth += 1;
            i += 1;
        }
        if i + 1 < width && byte_at(head, i) == 125 && byte_at(head, i + 1) == 125 {
            depth -= 1;
            i += 1;
        }
        if byte_at(head, i) == 40 { round += 1; }
        if byte_at(head, i) == 41 { round -= 1; }
        i += 1;
    }
    return i;
}

// An `attribute=` sitting inside what was read as the handler's expression, or None.
//
// **`on:` runs to the end of the head by design, so anything written after it is EATEN.** Measured:
// `::: button on:click=n + 1 class=danger` emitted a button with no class at all and folded
// `class=danger` into the dispatch expression — which then fails to compile, in generated code, with
// a message about a name the author did not write there. Before `child=` existed the only casualty
// was an attribute; now it is a whole body, which is worth a refusal of its own.
//
// Looked for at paren depth zero and outside quotes: `Msg.Set("a=b")` and `f(g(x))` are ordinary
// handlers and Burxt has no named arguments, so a bare `name=` out here is always the mistake.
pure function star_trailing_attribute(expr: String) -> Option<String> {
    let mutable depth: Int = 0;
    let mutable i: Int = 0;
    let mutable in_quote: Bool = false;
    while i < len(expr) {
        let c: Int = byte_at(expr, i);
        if c == 34 { in_quote = !in_quote; }
        if !in_quote {
            if c == 40 || c == 91 { depth += 1; }
            if c == 41 || c == 93 { depth -= 1; }
            // `name=`, not `==`, `!=`, `<=` or `>=`.
            if c == 61 && depth == 0 && i + 1 < len(expr) && byte_at(expr, i + 1) != 61
                && i > 0 && byte_at(expr, i - 1) != 61 && byte_at(expr, i - 1) != 33
                && byte_at(expr, i - 1) != 60 && byte_at(expr, i - 1) != 62 {
                // Walk back over the name to the space before it.
                let mutable from: Int = i;
                while from > 0 && byte_at(expr, from - 1) != 32 { from -= 1; }
                if from > 0 && from < i {
                    return Option.Some(substring(expr, from, i - from));
                }
            }
        }
        i += 1;
    }
    return Option.None;
}

// A value with its surrounding quotes removed, if it has a matched pair.
// Is there a `"` at the value's TOP LEVEL — outside any `{{ … }}` or `{ … }`?
//
// **The first version asked only whether a quote appeared anywhere, and that refused
// `class={{ pick("\}\}", n) }}`** — a quote inside an interpolation, which is ordinary Burxt. So a
// fix for a class of false refusals introduced one, and star's own suite caught it within the hour.
// The rule is the same as everywhere else in this file: a delimiter is only a delimiter where nothing
// protects it.
pure function star_bare_quote(value: String) -> Bool {
    let mutable i: Int = 0;
    let mutable depth: Int = 0;
    while i < len(value) {
        if byte_at(value, i) == 34 {
            // A quote at the top level is the mistake this refuses. A quote INSIDE braces opens a
            // string, and the string is then skipped whole — because the `\}\}` in
            // `{{ pick("\}\}", n) }}` would otherwise close the interpolation from inside a literal
            // and make the next quote look bare. The counter needed the same protection rule as the
            // scanners, which is the point at which "state it once" stopped being advice.
            if depth <= 0 { return true; }
            i += 1;
            while i < len(value) && byte_at(value, i) != 34 {
                if byte_at(value, i) == 92 && i + 1 < len(value) { i += 1; }
                i += 1;
            }
            i += 1;
            continue;
        }
        if byte_at(value, i) == 123 { depth += 1; }
        if byte_at(value, i) == 125 { depth -= 1; }
        i += 1;
    }
    return false;
}

pure function star_unquoted(raw: String) -> String {
    if len(raw) >= 2 && byte_at(raw, 0) == 34 && byte_at(raw, len(raw) - 1) == 34 {
        return substring(raw, 1, len(raw) - 2);
    }
    return raw;
}

// Is this value written in braces — `child={…}` — rather than as bare or quoted text?
pure function star_is_braced(raw: String) -> Bool {
    return len(raw) >= 2 && byte_at(raw, 0) == 123 && byte_at(raw, len(raw) - 1) == 125;
}

// What is between the braces, trimmed. `{}` gives the empty String, which is an empty body.
//
// **A doubled brace is unwrapped twice, so `child={{ label }}` means the same as `child={label}`.**
// Everywhere else in a head `{{ … }}` is the interpolation — `class={{ mark(x) }}` — so a reader
// arriving at `child=` will write the spelling they already know. Refusing it would be technically
// defensible and practically hostile; accepting it costs two lines.
pure function star_unbraced(raw: String) -> String {
    if star_is_braced(raw) {
        let once: String = star_trim(substring(raw, 1, len(raw) - 2));
        if star_is_braced(once) {
            return star_trim(substring(once, 1, len(once) - 2));
        }
        return once;
    }
    return raw;
}

pure function star_attr_value(raw: String) -> String {
    let mutable out: String = "";
    let mutable literal: String = "";
    let mutable i: Int = 0;
    let width: Int = len(raw);
    while i < width {
        if i + 1 < width && byte_at(raw, i) == 123 && byte_at(raw, i + 1) == 123 {
            // **The closing `\}\}` must be found OUTSIDE any string in the expression.** This is the
            // third scanner in this file to need that sentence and the reason is always the same: a
            // delimiter rule has to know what protects a delimiter. `{{ pick("\}\}", n) }}` closed
            // inside the literal and the expression came out spliced in half.
            let mutable j: Int = i + 2;
            while j + 1 < width && !(byte_at(raw, j) == 125 && byte_at(raw, j + 1) == 125) {
                if byte_at(raw, j) == 34 {
                    j += 1;
                    while j < width && byte_at(raw, j) != 34 {
                        if byte_at(raw, j) == 92 && j + 1 < width { j += 1; }
                        j += 1;
                    }
                }
                j += 1;
            }
            if len(literal) > 0 {
                if len(out) > 0 { out = out + " + "; }
                out = out + "\"" + literal + "\"";
                literal = "";
            }
            if len(out) > 0 { out = out + " + "; }
            out = out + "(" + star_trim(substring(raw, i + 2, j - (i + 2))) + ")";
            i = j + 2;
        } else {
            literal = literal + byte_as_string(byte_at(raw, i));
            i += 1;
        }
    }
    if len(literal) > 0 {
        if len(out) > 0 { out = out + " + "; }
        out = out + "\"" + literal + "\"";
    }
    if len(out) == 0 {
        return "\"\"";
    }
    return out;
}

// Leading whitespace, not only spaces. A CSS selector arrives with the newline that ended the
// previous rule in front of it, and a trim that only knew about spaces left `@media` looking like
// an ordinary selector — which is exactly how it came to be stamped with a scoping attribute.
pure function star_trim(text: String) -> String {
    let mutable from: Int = 0;
    while from < len(text) && (byte_at(text, from) == 32 || byte_at(text, from) == 10
                               || byte_at(text, from) == 9 || byte_at(text, from) == 13) {
        from += 1;
    }
    return bmx_strip_end(substring(text, from, len(text) - from));
}

// Every `name=value` in a head, as `html_attr(...)` terms ready to go in a list.
//
// The head handed in has already had `on:` and `key` removed, so what is left is attributes and
// nothing else. Refuses a value it cannot read rather than dropping it — an attribute that silently
// does not appear is the failure this whole project keeps finding.
pure function star_attrs_of(head: String) -> Result<StarAttrs, String> allocates {
    let mutable out: String = "";
    let mutable flags: String = "";
    let width: Int = len(head);
    let mutable i: Int = 0;
    while i < width {
        while i < width && star_separates(byte_at(head, i)) {
            i += 1;
        }
        if i >= width {
            return Result.Ok(StarAttrs { inline: out, flags: flags });
        }
        let name_from: Int = i;
        while i < width && !star_separates(byte_at(head, i)) && byte_at(head, i) != 61 {
            i += 1;
        }
        let name: String = substring(head, name_from, i - name_from);
        let mutable value: String = "\"\"";
        let mutable valueless: Bool = true;
        let mutable flagged: String = "";
        if i < width && byte_at(head, i) == 61 {
            valueless = false;
            i += 1;
            if i < width && byte_at(head, i) == 34 {
                i += 1;
                let from: Int = i;
                while i < width && byte_at(head, i) != 34 {
                    i += 1;
                }
                if i >= width {
                    return Result.Error("STAR-E009: the value of `" + name + "` opens with a quote"
                        + " and never closes it");
                }
                value = star_attr_value(substring(head, from, i - from));
                i += 1;
            } else {
                let from: Int = i;
                // A `{{ … }}` value may hold spaces, so an interpolation runs to its closing braces
                // rather than to the next separator.
                //
                // **A comma ends a value only at depth zero**, and that qualifier is the whole of it:
                // `on:click=Msg.Toggle(string_to_int(key, 0))` is full of commas that separate
                // ARGUMENTS, and a comma rule that could not see parentheses would cut the handler in
                // half at the first one.
                let mutable depth: Int = 0;
                let mutable round: Int = 0;
                while i < width && (depth > 0 || round > 0
                                    || !star_separates(byte_at(head, i))) {
                    // A quoted run protects every delimiter inside it — `}}`, a comma, a space,
                    // a paren. Without this, `class={{ pick("}}", n) }}` ended at the literal and the
                    // refusal blamed `}}` for not being an attribute name.
                    if byte_at(head, i) == 34 {
                        i += 1;
                        while i < width && byte_at(head, i) != 34 {
                            if byte_at(head, i) == 92 && i + 1 < width { i += 1; }
                            i += 1;
                        }
                        if i < width { i += 1; }
                        continue;
                    }
                    if i + 1 < width && byte_at(head, i) == 123 && byte_at(head, i + 1) == 123 {
                        depth += 1;
                        i += 1;
                    }
                    if i + 1 < width && byte_at(head, i) == 125 && byte_at(head, i + 1) == 125 {
                        depth -= 1;
                        i += 1;
                    }
                    if byte_at(head, i) == 40 { round += 1; }
                    if byte_at(head, i) == 41 { round -= 1; }
                    i += 1;
                }
                let written_value: String = substring(head, from, i - from);
                flagged = written_value;
                // **A quote inside an UNQUOTED value is refused here, or the compiler refuses it.**
                // It used to emit `html_attr("class", "x" onload="steal()")` — a Burxt syntax error
                // about generated code, pointing at a line the author never wrote. Safe, since it
                // never compiles, and useless, since the message is about somebody else's file.
                if star_bare_quote(written_value) {
                    return Result.Error("STAR-E024: the value of `" + name + "` has a quote in it but"
                        + " does not start with one. Wrap the whole value: `" + name + "=\"…\"`");
                }
                // **A single-brace value in an attribute WORKS BY ACCIDENT, so it is refused.**
                // `class={mark(x)}` reaches Burxt as the string literal `"{mark(x)}"` and produces
                // the right class only because Burxt interpolates braces inside its own string
                // literals. A value holding a literal brace would then ship `{mark(x)}` to a browser,
                // and nothing would say so — I shipped that spelling for ten minutes and found it by
                // grepping the emitted attribute, because two screenshots agreed and both were right
                // for the wrong reason.
                //
                // `child={…}` is star's own and is compiled as an expression; an attribute wants
                // `{{ … }}`, which is the interpolation every other attribute uses.
                if star_is_braced(written_value) && !star_mentions(written_value, "\{\{") {
                    return Result.Error("STAR-E023: `" + name + "=\{" + star_unbraced(written_value)
                        + "\}` is a single-brace value, which reaches the compiler as text and works"
                        + " only by accident. Write `" + name + "=\{\{ " + star_unbraced(written_value)
                        + " \}\}` — or `child=\{…\}`, which is the one place single braces are star's");
                }
                value = star_attr_value(written_value);
            }
        }
        if len(name) > 0 {
            // **An attribute NAME is checked here, or it is checked in the browser.**
            // `html_element` carries a precondition on its attribute names, so a name that is not
            // one exits 70 — a bare "burxt exit 70" in the console, from a contract inside a
            // function the author never called.
            //
            // The name that gets here is usually not one the author wrote deliberately: an
            // unquoted value with spaces in it, `placeholder=What needs doing?`, is read as three
            // attributes, and the third is `doing?`. So the refusal says that, because the fix is
            // quotes rather than a different name.
            if !html_is_name(name) {
                // **Two different causes, and one message for both sent readers to the wrong one.**
                // A name with a space before it is a quoting mistake; `xml:lang` is a name the host
                // cannot emit. Telling someone to add quotes to `xml:lang` is advice that cannot
                // work, which is the failure this project keeps finding in other people's messages.
                if star_mentions(name, ":") {
                    return Result.Error("STAR-E020: `" + name + "` is not an attribute name here —"
                        + " a colon in one is valid HTML but `html_attr` cannot carry it. Use a"
                        + " `data-` attribute, or the namespace-free spelling if the element has one");
                }
                return Result.Error("STAR-E020: `" + name + "` is not an attribute name."
                    + " An unquoted value ends at the first space, so"
                    + " `placeholder=What needs doing?` is three attributes — put the value in"
                    + " quotes: `placeholder=\"What needs doing?\"`");
            }
            // **A valueless name that HTML has no boolean for is almost always text.** See
            // `star_is_bare_flag` — this is the one that made a heading render empty and a dropdown
            // show blank labels, in a shipped example, with nothing reported.
            // **A boolean attribute whose value is an interpolation is a DECISION, not a value.**
            // `checked={{ model.agree }}` cannot be `checked="false"`, because that is checked. It
            // leaves the inline list here and comes back as an `if` around a `push`, so when the
            // expression is false the attribute is not there at all — which is the only thing HTML
            // understands as false.
            if !valueless && star_is_bare_flag(name) && star_is_interpolated(flagged) {
                flags = flags + name + "\t" + star_trim(star_unwrapped(flagged)) + "\n";
                continue;
            }
            if valueless && !star_is_bare_flag(name) {
                // **TWO causes, and this one names both on purpose.** Elsewhere in this file a
                // message that covered two causes was the defect — `xml:lang` told to add quotes —
                // but those could be told apart by the colon. These cannot: `class=card Order` and
                // `placeholder=What needs doing?` produce an identical bare token, and the head gives
                // nothing to choose by. Guessing one would send half of all readers to the wrong fix,
                // so both are stated and the reader picks the one they recognise.
                return Result.Error("STAR-E026: `" + name + "` has no value, so it stands for a"
                    + " boolean attribute — this element renders with NO TEXT in it and `" + name
                    + "` ends up on the tag. Two spellings cause that. An unquoted value ends at the"
                    + " first space, so `placeholder=What needs doing?` is three tokens — put the"
                    + " value in quotes: `placeholder=\"What needs doing?\"`. Or you meant text, and"
                    + " it is `child=" + name + "` — or the text on its own line between the fences."
                    + " If you really did mean a boolean attribute, `" + name + "=\"\"` says so");
            }
            if len(out) > 0 { out = out + ", "; }
            out = out + "html_attr(\"" + name + "\", " + value + ")";
        }
    }
    return Result.Ok(StarAttrs { inline: out, flags: flags });
}

// `{{ … }}`, which is what makes a boolean attribute a decision rather than a value.
pure function star_is_interpolated(written: String) -> Bool {
    let t: String = star_trim(written);
    if len(t) < 4 { return false; }
    return substring(t, 0, 2) == "\{\{";
}

// The expression inside `{{ … }}`.
pure function star_unwrapped(written: String) -> String allocates {
    let t: String = star_trim(written);
    if !star_is_interpolated(t) { return t; }
    let mutable stop: Int = len(t);
    while stop > 2 && !(byte_at(t, stop - 1) == 125 && byte_at(t, stop - 2) == 125) { stop -= 1; }
    if stop <= 4 { return ""; }
    return substring(t, 2, stop - 4);
}

// The `if` around each `push`, which is where a state-dependent attribute is decided. The holder is a
// list so the attribute can simply not be added — the one spelling HTML reads as false.
pure function star_flag_block(attrs: String, lines: String, holder: String, indent: String)
    -> String allocates {
    if len(lines) == 0 { return ""; }
    let mutable out: String = indent + "let mutable " + holder + ": [Attr] = " + attrs + ";\n";
    let mutable at: Int = 0;
    let mutable from: Int = 0;
    let mutable n: Int = 0;
    while at <= len(lines) {
        if at == len(lines) || byte_at(lines, at) == 10 {
            let row: String = substring(lines, from, at - from);
            if len(row) > 0 {
                let mutable cut: Int = 0;
                while cut < len(row) && byte_at(row, cut) != 9 { cut += 1; }
                let name: String = substring(row, 0, cut);
                let expr: String = substring(row, cut + 1, len(row) - cut - 1);
                out = out + indent + "if " + expr + " \{ let " + holder + "_" + to_string(n)
                    + ": Int = push(" + holder + ", html_attr(\"" + name + "\", \"\")); \}\n";
                n += 1;
            }
            from = at + 1;
        }
        at += 1;
    }
    return out;
}

// The complete source of a generated component, minus the runtime entry points.
//
// **One implementation, because two diverged.** The generator emitted the `StarCmd`/`StarWatch`
// vocabulary and the checker did not, so the checker reported `unknown type StarCmd` on a component
// that generates and runs. The complaint was about the checker, and nothing could have told them
// apart except running both — which is what a linter over this repository's own examples now does.
public function star_source_of(component: StarComponent, name: String) -> String {
    let mutable out: String = "use \"std/html.bx\";\n" + star_burxt_imports(component.code) + "\n";
    // The command and subscription vocabulary, only when the component asks for it — a document that
    // uses neither carries neither.
    let wants_runtime: Bool = star_mentions(component.code, "StarCmd")
        || star_mentions(component.code, "StarWatch");
    if wants_runtime {
        out = out + star_runtime_types();
    }
    out = out + star_code_without_imports(component.code);
    if wants_runtime {
        out = out + star_runtime_encoders();
    }
    return out + component.view + component.dispatch;
}

// The `props` declaration of a document, read without generating it.
function star_props_of(source: String) -> String {
    match bmx_parse(star_markup(source)) {
        Error(e) => { return ""; }
        Ok(blocks) => { return star_props(blocks); }
    }
}

// ---- commands and subscriptions: async, in a language with no async ---------------------------
//
// The browser is already an event loop, and a wasm module that blocks freezes the tab. So Burxt
// never waits — it ANSWERS. An update says what the next state is; a separate function says what the
// driver should go and do about it; and whatever comes back arrives as an ordinary event.
//
//     pure function commands(msg: Msg, m: Model) -> [StarCmd]     what to go and do
//     pure function watch(m: Model) -> [StarWatch]                what to keep listening to
//     pure function arrived(tag: Int, value: String, m: Model) -> Model    one inbox
//
// **THE AUTHOR CHOOSES THE TAGS, and that is the design decision that makes the rest simple.** A
// reply has to become a message, and a message cannot cross to JavaScript. The obvious route is for
// a command to name the handler index that should receive it — and handler indices are assigned by
// star from the order `on:` attributes appear, so the author would be writing a number they cannot
// see and that moves when they add a button. Instead a command carries a tag the author picked, and
// every reply lands in `arrived`, where they switch on their own number.
//
// One inbox for commands and subscriptions both: a fetch completing and a timer firing are the same
// kind of event as far as the program is concerned, and giving them two doors would mean two
// functions that differ only in which of the author's numbers they see.
//
// `StarCmd` and `StarWatch` are emitted INTO the component rather than imported, because they are
// the contract between a document and this driver — a component that used a different set would
// compile and then do nothing, and a shared library would let that happen quietly.
pure function star_runtime_types() -> String {
    return "// ---- what a component may ask the driver to do ----------------------\n"
        + "//\n"
        + "// Emitted, not imported: this is the contract between the document and the driver, and a\n"
        + "// component holding a different set would compile and then silently do nothing.\n"
        + "//\n"
        + "// The Int in each is a TAG THE AUTHOR CHOSE. Whatever comes back arrives at `arrived`\n"
        + "// carrying it, so nothing has to know the handler indices star assigns.\n"
        + "enum StarCmd \{\n"
        + "    // Fetch a URL. The reply's body arrives as `value`.\n"
        + "    Fetch(Int, String),\n"
        + "    // Send a body to a URL. The reply's body arrives as `value`.\n"
        + "    Send(Int, String, String),\n"
        + "    // Put the caret in an element. Nothing arrives.\n"
        + "    Focus(String),\n"
        + "    // Remember something across reloads, and read it back. `Load` arrives with the\n"
        + "    // stored text, or the empty String when there is none.\n"
        + "    Store(String, String),\n"
        + "    Load(Int, String),\n"
        + "    // Change the address without reloading. Nothing arrives.\n"
        + "    Go(String),\n"
        + "    // Stop whatever was started under this tag. Nothing arrives.\n"
        + "    Cancel(Int),\n"
        + "\}\n"
        + "\n"
        + "// **What to listen to is a function of the state**, exactly as the view is. The driver\n"
        + "// diffs this between frames and adds or removes listeners — so there is no `onMounted`,\n"
        + "// no cleanup function to forget, and stopping is a state change rather than a call.\n"
        + "enum StarWatch \{\n"
        + "    // Every so many milliseconds.\n"
        + "    Every(Int, Int),\n"
        + "    // A key, anywhere on the page. `value` is the key's name.\n"
        + "    Key(Int, String),\n"
        + "    // A websocket. Each message arrives as `value`.\n"
        + "    Socket(Int, String),\n"
        + "\}\n";
}

// A command as one line of text for the driver. Emitted as Burxt so the ENCODING lives with the
// types it encodes, rather than in a JavaScript file that could disagree with them.
pure function star_runtime_encoders() -> String {
    return "pure function star_cmd_text(c: StarCmd) -> String \{\n"
        + "    match c \{\n"
        + "        Fetch(tag, url) => \{ return \"fetch\\t\" + to_string(tag) + \"\\t\" + url; \}\n"
        + "        Send(tag, url, body) => \{ return \"send\\t\" + to_string(tag) + \"\\t\" + url + \"\\t\" + body; \}\n"
        + "        Focus(selector) => \{ return \"focus\\t0\\t\" + selector; \}\n"
        + "        Store(name, text) => \{ return \"store\\t0\\t\" + name + \"\\t\" + text; \}\n"
        + "        Load(tag, name) => \{ return \"load\\t\" + to_string(tag) + \"\\t\" + name; \}\n"
        + "        Go(path) => \{ return \"go\\t0\\t\" + path; \}\n"
        + "        Cancel(tag) => \{ return \"cancel\\t\" + to_string(tag); \}\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "pure function star_watch_text(w: StarWatch) -> String \{\n"
        + "    match w \{\n"
        + "        Every(tag, ms) => \{ return \"every\\t\" + to_string(tag) + \"\\t\" + to_string(ms); \}\n"
        + "        Key(tag, name) => \{ return \"key\\t\" + to_string(tag) + \"\\t\" + name; \}\n"
        + "        Socket(tag, url) => \{ return \"socket\\t\" + to_string(tag) + \"\\t\" + url; \}\n"
        + "    \}\n"
        + "\}\n";
}

// ---- the two modes, and the `===bx` section is what chooses between them ----------------------
//
// **Expression mode** — no `===bx`. `on:click=count + 1` says what the next state IS, and a handler
// is a one-line expression. This is what the guide teaches and it stays exactly as it was.
//
// **Component mode** — a `===bx` section. `on:click=Msg.Increment` names a MESSAGE, and the author's
// own `update` decides the next state. That lifts the one-line limit: an update can `match`, call
// helpers, and be read and tested on its own.
//
// The switch is the presence of the section rather than a flag, because a reader can see it. And it
// is not sniffed from whether an `update` exists — a file with `===bx` and no `update` gets a named
// refusal, not a compiler error about a function nobody wrote.
public function star_generate(source: String, name: String, known: [StarKnown]) -> Result<StarComponent, String> {
    // Respelled here rather than at emission, because emission sees only the component and this is the
    // last place `known` is in scope. Everything downstream reads `component.code`, so one substitution
    // reaches both the import list and the mode switch.
    let code: String = star_code_with_known_paths(star_section(source, "bx"), known);
    // **`key` and `value` are star's, and a prop may not take them.** A dispatch is
    // `(handler, key, value, <props>)`, so a prop of either name produces a function with two
    // parameters of the same name — which the compiler refuses, in generated code, about a
    // declaration the author did write in a file they did not.
    //
    // Refused here by name instead. And not renamed silently to make room: `key` and `value` are
    // what a handler writes — `Msg.Toggle(string_to_int(key, 0))` — so a prop shadowing one would be
    // confusing in a document even if it compiled.
    //
    // Found by running the linter over this repository's own examples, on a component that had
    // shipped: `Badge.sbmx` had a prop called `value`.
    let declared: [String] = star_prop_names(star_props_of(source));
    let mutable pi: Int = 0;
    while pi < len(declared) {
        if declared[pi] == "key" || declared[pi] == "value" {
            return Result.Error("STAR-E019: `" + declared[pi] + "` is a name star gives every"
                + " handler — a dispatch is `(handler, key, value, <props>)` — so a prop cannot"
                + " take it. Rename the prop; `" + declared[pi] + "` stays available inside an"
                + " `on:` expression, which is what it is for.");
        }
        pi += 1;
    }
    // The stylesheet, and the marker that scopes it. A component with no `===style.local` gets no
    // marker and no attribute on its elements — the scoping machinery costs nothing when unused.
    let local: String = star_section(source, "style.local");
    let mutable marker: String = "";
    if !star_is_blank(local) {
        marker = name;
    }
    let mutable style: String = star_section(source, "style.global");
    if len(marker) > 0 {
        style = style + star_scoped_css(local, marker);
    }
    let component_mode: Bool = !star_is_blank(code);
    if component_mode && !star_mentions(code, "function update(") {
        return Result.Error("STAR-E008: this document has a `===bx` section, so its `on:` handlers"
            + " are MESSAGES and something has to turn a message into the next state. Add"
            + " `pure function update(msg: Msg, m: Model) -> Model`, or remove the `===bx`"
            + " section to write handlers as expressions.");
    }
    match bmx_parse(star_markup(source)) {
        Error(e) => { return Result.Error(e); }
        Ok(blocks) => {
            let props: String = star_props(blocks);
            if len(props) == 0 {
                return Result.Error("STAR-E003: this document declares no `props` block, so it has"
                    + " no signature and nothing can invoke it. Add `:props: name: Type`");
            }
            let mutable handlers: [StarHandler] = [];
            match star_emit_stmts(source, known, marker, blocks, "kids", "0", "    ", handlers, "", "") {
                Error(e) => { return Result.Error(e); }
                Ok(body) => {
                    let mutable view: String = "pure function " + name + "(" + props + ") -> Html allocates \{\n";
                    view = view + "    let mutable kids: [Html] = [];\n" + body;
                    view = view + "    return html_element(\"div\", [html_attr(\"class\", \"star\")], kids);\n\}\n";

                    // The state type is the first prop's, read off the declaration
                    // the author wrote rather than guessed at.
                    let mutable state_type: String = "";
                    let mutable seen_colon: Bool = false;
                    let mutable k: Int = 0;
                    while k < len(props) {
                        let b: Int = byte_at(props, k);
                        if b == 44 { k = len(props); }
                        else {
                            if seen_colon { state_type = state_type + byte_as_string(b); }
                            if b == 58 { seen_colon = true; }
                            k += 1;
                        }
                    }
                    state_type = bmx_strip_end(state_type);
                    let mutable trimmed: String = state_type;
                    while len(trimmed) > 0 && byte_at(trimmed, 0) == 32 {
                        trimmed = substring(trimmed, 1, len(trimmed) - 1);
                    }

                    // `key` is the SECOND parameter, and it is a String because a DOM attribute
                    // is text. That is the boundary being visible rather than a wart: a row's
                    // identity round-trips through the page, so the author converts —
                    // `string_to_int(key, 0)` for a number.
                    let mutable dispatch: String = "pure function " + name + "_dispatch(handler: Int, "
                        + "key: String, value: String, " + props + ") -> " + trimmed + " \{\n";
                    let mutable h: Int = 0;
                    while h < len(handlers) {
                        // Expression mode returns the expression. Component mode hands it to
                        // `update` as a message — the ONE line that separates the two, because
                        // everything else about a handler is the same in both.
                        let mutable answer: String = handlers[h].expression;
                        if component_mode {
                            answer = "update(" + answer + ", " + star_first_prop_name(props) + ")";
                        }
                        dispatch = dispatch + "    if handler == " + to_string(h) + " \{ return "
                            + answer + "; \}\n";
                        h += 1;
                    }
                    // An index the page could not have produced is a bug in the
                    // driver, not in the document — so it holds state rather than
                    // inventing one.
                    dispatch = dispatch + "    return " + star_first_prop_name(props) + ";\n\}\n";

                    return Result.Ok(StarComponent {
                        view: view, dispatch: dispatch, handlers: handlers, code: code,
                        style: style,
                        props: props, argument_list: star_argument_list(props),
                    });
                }
            }
        }
    }
}

pure function star_first_prop_name(props: String) -> String {
    let mutable i: Int = 0;
    while i < len(props) {
        if byte_at(props, i) == 58 { return bmx_strip_end(substring(props, 0, i)); }
        i += 1;
    }
    return props;
}

// `count: Int, label: String` -> `count, label`. What the entry point passes on.
pure function star_argument_list(props: String) -> String {
    let mutable out: String = "";
    let mutable name: String = "";
    let mutable seen_colon: Bool = false;
    let mutable i: Int = 0;
    while i < len(props) {
        let b: Int = byte_at(props, i);
        if b == 44 {
            if len(out) > 0 { out = out + ", "; }
            out = out + name;
            name = "";
            seen_colon = false;
        } else {
            if b == 58 { seen_colon = true; }
            if !seen_colon && b != 32 { name = name + byte_as_string(b); }
        }
        i += 1;
    }
    if len(name) > 0 {
        if len(out) > 0 { out = out + ", "; }
        out = out + name;
    }
    return out;
}
