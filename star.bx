// ============================================================================
// star.bx — star-burxt: what gives a BMX document life.
//
//     dependency  star  https://github.com/andrecorugda/star-burxt  v0.1.0
//     use "star/star.bx";
//
// BMX describes where an expression goes. It does not know what `for` means, or
// `if`, or `on:click` — `BOUNDARY.md` is the document that keeps it that way. This
// file is the host that decides, and `SPEC.md` §4a.5 is its specification:
//
//   - refuse an unknown block name, never render it and never skip it silently
//   - refuse an unknown attribute on a block it declares
//   - decide what a head means, including whether it binds names inside the body
//   - **refuse an event attribute it cannot wire.** A host with no runtime must
//     refuse `on:*` rather than emit an inline handler — emitting one puts
//     unchecked script on the page, which is the hole escaping exists to close
//
// That last one is the reason this file exists rather than a runtime `button()`
// function. BMX's parser hands a component block's head over as a **runtime
// String**, so `on:click=count + 1` would arrive as text that nothing compiles:
// no typecheck, no unknown-name error, no `burxt review` surface. A handler that
// is a string is a handler the language cannot judge, and judging it is the whole
// case for writing a framework in this language rather than another one.
//
// ---- the shape, and why it is the one Burxt was going to force anyway --------
//
//     props count: Int          the state
//     on:click=count + 1        an event yields the NEXT state
//     view                      a pure function of the state
//     dispatch                  a pure function of (handler, state) -> state
//
// A view is `pure`, so `burxt effects --allow ""` confirms it reaches nothing —
// by construction rather than by inspection. A handler is an expression producing
// the next state, which is the same architecture Elm arrived at, and it is not a
// coincidence: **Burxt has no closures** (Burxt's `lib/fn.bx` — "a closure needs an owner
// for its captured state, which is a memory question in a language whose whole
// memory model is regions"). With no closures there is nothing to capture a
// mutable cell in, so state cannot hide inside a handler. It has to be threaded,
// and threading it is what makes the update inspectable.
//
// The consequence worth stating: **an event handler's effect on the program is a
// value you can print.** `dispatch(0, 41)` is `42`. No framework whose handlers
// are closures can say that, and `burxt review` can diff what a handler promises
// between versions.
//
// ---- what reaches the page ---------------------------------------------------
//
// A handler becomes `data-star-h="0"` — an INDEX, never an inline handler. The
// driver installs one delegated listener and calls the exported `dispatch`. So a
// star-burxt page carries no executable markup at all, which is §4a.5 satisfied
// literally rather than approximately.
// **`std/` is the standard library, wherever Burxt is installed** — the prefix that makes this a
// package rather than a folder inside the compiler's repository.
//
// **`bmx` is a package dependency**, declared in `burxt.package` and pinned to a commit. BMX is a
// format with its own repository, its own version and its own conformance suite; star-burxt is one
// of its hosts rather than part of it, and the manifest is where that stops being a claim and
// becomes something a build has to satisfy. It reached here through `std/` until the day BMX left
// Burxt's `lib/`, which is a sentence worth keeping only because the two are easy to confuse: a
// dependency and the standard library are both "somewhere else", and only one of them is versioned
// by somebody with their own release cadence.
//
// **The long path is the format's neutrality, not an accident.** In the format's repository
// `reference/bmx.js` defines what BMX means and `burxt/bmx.bx` is one implementation of it; putting
// `bmx.bx` at that repo's root instead would shorten this line by seven characters and make the
// spec repository look like a Burxt package, which is the one thing it must not look like. A
// dependency needs no `burxt.package` of its own — nothing reads it — so the format repo can stay
// exactly what it is.
use "std/html.bx";
use "std/option.bx";
use "bmx/burxt/bmx.bx";

// ---- what this package supports, and it is three names ----------------------
//
// `public` is what a dependent package may reach. Without it every name here is
// hidden, and an application declaring `dependency star …` is told so by name:
//
//     error: `star_generate` is declared in the package `star` but not `public`,
//     so this package cannot reach it.
//
// That is the difference between a framework and a folder, and it is a decision
// rather than an omission: THREE names are supported — `star_generate`, and the
// two classes it answers with. `star_event_part`, `star_emit_stmts` and the rest
// of this file are how it is done today, and the day one of them changes should
// not be a day anybody else's build breaks.
//
// Fields need no `public` of their own. A class that is reachable is reachable
// with its shape, because a `StarComponent` whose `view` could not be read would
// be a value with nothing to do.

// A handler found while walking the document: its index, and the expression the
// author wrote. The expression is emitted into `dispatch` verbatim, where the
// compiler judges it — a typo is `unknown variable`, a wrong type is a type
// error, and both name the thing the author wrote.
public class StarHandler { event: String, expression: String }

// What a generated component is: the view, the dispatch, and the handler table
// that ties an index on the page to an expression in the source.
public class StarComponent {
    view: String,
    dispatch: String,
    handlers: [StarHandler],
    // The `===bx` section, verbatim. Empty when the document has none — which is also the switch
    // between the two modes below, so a reader can tell which one a file is in by looking at it.
    code: String,
    // The declaration verbatim (`count: Int`) and the names alone (`count`), so the
    // emitted entry point can both DECLARE and PASS the props without the caller
    // re-deriving either.
    props: String,
    argument_list: String,
}

// ---- `.sbmx` sections, split off before BMX ever sees the file ----------------
//
// A component file has two halves: Burxt in `===bx`, and markup. The markup goes to BMX; the code
// does not, and **that is the boundary rather than a convenience**. Handing the code to BMX would
// make the markup format responsible for transporting a payload it cannot read — and it fails in
// practice, not only in principle: a fenced code block shreds a component the moment a Burxt string
// contains a line beginning with three backticks, splitting the program in two with a paragraph in
// the middle. `===` delimiters are star's, so star controls what terminates them.
//
// A section opens with `===name` and closes with a bare `===`. Everything outside every section is
// markup. If star ever failed to strip a section, BMX would render it as a paragraph — visibly
// wrong on the page rather than silently miscompiled, which is the right way for this to break.

pure function star_end_of_line(text: String, from: Int, width: Int) -> Int {
    let mutable i: Int = from;
    while i < width && byte_at(text, i) != 10 {
        i += 1;
    }
    return i;
}

// A line that is exactly `===` closes whatever is open. Checked before the opener, because `===`
// would otherwise read as an opener whose name is empty.
pure function star_closes_section(line: String) -> Bool {
    return bmx_strip_end(line) == "===";
}

pure function star_opens_section(line: String) -> Bool {
    if len(line) < 4 {
        return false;
    }
    return byte_at(line, 0) == 61 && byte_at(line, 1) == 61 && byte_at(line, 2) == 61;
}

pure function star_section_name(line: String) -> String {
    return bmx_strip_end(substring(line, 3, len(line) - 3));
}

// The text of one section, or the empty String when the file has none of that kind.
pure function star_section(source: String, wanted: String) -> String {
    let mutable out: String = "";
    let mutable inside: Bool = false;
    let width: Int = len(source);
    let mutable at: Int = 0;
    while at < width {
        let stop: Int = star_end_of_line(source, at, width);
        let line: String = substring(source, at, stop - at);
        if star_closes_section(line) {
            inside = false;
        } else {
            if star_opens_section(line) {
                inside = star_section_name(line) == wanted;
            } else {
                if inside {
                    out = out + line + "\n";
                }
            }
        }
        at = stop + 1;
    }
    return out;
}

// Everything that is not in a section. This is what BMX parses.
//
// A section's lines become BLANK rather than disappearing, so every byte offset after them is where
// it was — which is what keeps BMX's error offsets pointing at the line the author wrote. The same
// trick the compiler's own module loader uses on `use` lines, and for the same reason.
pure function star_markup(source: String) -> String {
    let mutable out: String = "";
    let mutable inside: Bool = false;
    let width: Int = len(source);
    let mutable at: Int = 0;
    while at < width {
        let stop: Int = star_end_of_line(source, at, width);
        let line: String = substring(source, at, stop - at);
        let mutable keep: Bool = false;
        if star_closes_section(line) {
            inside = false;
        } else {
            if star_opens_section(line) {
                inside = true;
            } else {
                keep = !inside;
            }
        }
        if keep {
            out = out + line + "\n";
        } else {
            out = out + star_blanked(line) + "\n";
        }
        at = stop + 1;
    }
    return out;
}

// A line of spaces the same width, so offsets do not move.
pure function star_blanked(line: String) -> String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(line) {
        out = out + " ";
        i += 1;
    }
    return out;
}

// Does this text contain that one? Written here rather than imported: star depends on `std/string`
// for nothing else, and one substring search is not worth a dependency.
pure function star_mentions(haystack: String, needle: String) -> Bool {
    let n: Int = len(needle);
    if n == 0 {
        return true;
    }
    let mutable i: Int = 0;
    while i + n <= len(haystack) {
        let mutable j: Int = 0;
        let mutable same: Bool = true;
        while j < n && same {
            if byte_at(haystack, i + j) != byte_at(needle, j) {
                same = false;
            }
            j += 1;
        }
        if same {
            return true;
        }
        i += 1;
    }
    return false;
}

// ---- head parsing, which is the host's job and not the format's --------------
//
// Byte codes rather than character literals, and `byte_at`/`substring` rather than
// building strings a byte at a time — the idiom BMX's own parser uses, and the
// one that does not allocate per character.
//
//     111 'o'   110 'n'   58 ':'   61 '='   32 ' '

// `button on:click=count + 1` -> Some("click=count + 1"). The format captured the
// head as opaque text; splitting it is ours, and so is refusing what we cannot wire.
pure function star_event_part(head: String) -> Option<String> {
    let mutable i: Int = 0;
    while i + 3 <= len(head) {
        if byte_at(head, i) == 111 && byte_at(head, i + 1) == 110 && byte_at(head, i + 2) == 58 {
            // Only at a token boundary, so `button on:click=x` matches and a
            // component legitimately named `weapon:click` does not.
            if i == 0 || byte_at(head, i - 1) == 32 {
                return Option.Some(substring(head, i + 3, len(head) - (i + 3)));
            }
        }
        i += 1;
    }
    return Option.None;
}

// `click=count + 1` -> the event name, and the expression after the FIRST `=`.
// The expression runs to the end of the head, so an `on:` binding is written last:
// expressions contain spaces and equals signs, and a format that does not parse
// heads cannot tell us where one ends.
pure function star_event_name(part: String) -> String {
    let mutable i: Int = 0;
    while i < len(part) {
        if byte_at(part, i) == 61 { return substring(part, 0, i); }
        i += 1;
    }
    return part;
}

pure function star_event_expression(part: String) -> String {
    let mutable i: Int = 0;
    while i < len(part) {
        if byte_at(part, i) == 61 { return substring(part, i + 1, len(part) - (i + 1)); }
        i += 1;
    }
    return "";
}

// The head with its `on:` binding removed — what is left is the element's own
// business. Trailing space trimmed, so `button on:click=x` leaves `button`.
pure function star_head_without_event(head: String) -> String {
    let mutable i: Int = 0;
    while i + 3 <= len(head) {
        if byte_at(head, i) == 111 && byte_at(head, i + 1) == 110 && byte_at(head, i + 2) == 58 {
            if i == 0 || byte_at(head, i - 1) == 32 {
                return bmx_strip_end(substring(head, 0, i));
            }
        }
        i += 1;
    }
    return head;
}

// ---- the events this host can wire, and the refusal for the rest -------------

// §4a.5: refuse an event attribute we cannot wire. The list is short on purpose —
// every entry is one the driver installs a delegated listener for, and adding to
// it means adding to the driver. A host that accepts an event it does not deliver
// has told the author a lie the compiler cannot catch.
pure function star_event_is_wired(name: String) -> Bool {
    return name == "click" || name == "input" || name == "change" || name == "submit";
}

// The block names this host declares, and the refusal for the rest.
//
// §4a.5 first line: *refuse an unknown block name, never render it and never skip
// it silently.* So star-burxt says what it knows: `for` and `if` are control flow,
// `props` is the signature, and these are elements. Anything else is a component,
// and until cross-file resolution exists there is nothing to resolve it against —
// so it is refused BY NAME rather than rendered as something plausible.
// Elements whose content model is PHRASING rather than flow. A `<p>` inside one of
// these is invalid HTML, not merely unwanted, which is why the unwrapping above is
// required rather than a preference. The list is short because it is the set this
// host declares — adding to it is a decision, not a convenience.
// ---- the element vocabulary, as a content model rather than a list --------------------------
//
// Three sets, and the SPLIT is what does the work rather than the membership. HTML's own rule is
// that a phrasing element holds text and a flow element holds sections; putting a heading in a
// button is invalid markup that browsers handle unpredictably, so star refuses it (STAR-E005) and
// unwraps paragraphs inside phrasing elements so a `button` holds text rather than a `<p>`.
//
// Written as space-delimited sets because a chain of forty `||` is a place to make a typo nobody
// sees. The spaces around each name are load-bearing: without them `p` would match inside `input`.

// Text-level. Paragraphs inside these UNWRAP, and a heading, list, quote or code block is refused.
pure function star_takes_phrasing(name: String) -> Bool {
    return star_in_set(name,
        " a b button caption code em h1 h2 h3 h4 h5 h6 i label legend mark option q s small span"
        + " strong sub summary sup textarea title u ");
}

// Takes no children at all. `html_element` carries `requires !html_is_void(tag) ||
// len(children) == 0`, so one of these with a body is a CONTRACT violation — refused at generate
// time rather than left to trip when the page is already open.
pure function star_is_void(name: String) -> Bool {
    return star_in_set(name, " area base br col embed hr img input link meta source track wbr ");
}

// Everything else a document may wrap things in.
pure function star_takes_flow(name: String) -> Bool {
    return star_in_set(name,
        " address article aside blockquote canvas colgroup dd details dialog div dl dt fieldset"
        + " figcaption figure footer form header hgroup li main nav ol optgroup output p picture"
        + " pre progress section select table tbody td tfoot th thead tr ul video ");
}

pure function star_in_set(name: String, set: String) -> Bool {
    return star_mentions(set, " " + name + " ");
}


pure function star_is_element(name: String) -> Bool {
    return star_takes_phrasing(name) || star_is_void(name) || star_takes_flow(name);
}


// ---- keys, which are a prerequisite rather than an optimisation ---------------
//
//     ::: for line in order.lines key line.id
//
// The trailing `key <expr>` is star-burxt's, parsed out of a head BMX captured and
// refused to interpret — the same move as `props` and `on:`, and again needing
// nothing from the format.
//
// **Why this is not a list optimisation.** Without a key, children are matched by
// POSITION, and `items[3]` is not the same item after a splice. That is silent ABA:
// a row's handler, its focus, and anything it owns quietly transfer to whatever
// slid into its index. It is merely wasteful until something is async or something
// is owned; then it is corruption. So keys have to exist before a component can own
// a resource, not after.

// `line in order.lines key line.id` -> Some("line.id"). The keyword must stand at a
// token boundary, so a collection named `monkey` does not match.
pure function star_key_part(head: String) -> Option<String> {
    let mutable i: Int = 0;
    while i + 4 <= len(head) {
        if byte_at(head, i) == 107 && byte_at(head, i + 1) == 101
            && byte_at(head, i + 2) == 121 && byte_at(head, i + 3) == 32 {
            if i > 0 && byte_at(head, i - 1) == 32 {
                return Option.Some(bmx_strip_end(substring(head, i + 4, len(head) - (i + 4))));
            }
        }
        i += 1;
    }
    return Option.None;
}

// The head with the `key` clause removed — what `for` itself gets.
pure function star_head_without_key(head: String) -> String {
    let mutable i: Int = 0;
    while i + 4 <= len(head) {
        if byte_at(head, i) == 107 && byte_at(head, i + 1) == 101
            && byte_at(head, i + 2) == 121 && byte_at(head, i + 3) == 32 {
            if i > 0 && byte_at(head, i - 1) == 32 {
                return bmx_strip_end(substring(head, 0, i));
            }
        }
        i += 1;
    }
    return head;
}

// ---- emission ----------------------------------------------------------------

// The document's blocks become statements pushing into `target`. This mirrors
// `bmx_emit_stmts` and diverges in exactly one place: a block carrying an `on:*`
// binding becomes an element with `data-star-h="N"` and its expression is put
// aside for `dispatch`, where the COMPILER judges it. That divergence is the
// whole file.
// `key_here` is the key expression that applies to elements emitted at THIS level —
// the immediate body of a keyed `for`. It is not passed down: a key identifies the
// row, and a grandchild of the row is identified by being inside it.
function star_emit_stmts(blocks: [Block], target: String, tag: String, indent: String,
                         mutable handlers: [StarHandler], key_here: String,
                         in_loop: Bool) -> Result<String, String> {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(blocks) {
        let label: String = "s_" + tag + "_" + to_string(i);
        match blocks[i] {
            Fenced(fenced) => {
                let inner: String = "k_" + tag + "_" + to_string(i);
                if fenced.name == "props" {
                    // Consumed by star_generate for the signature; emits nothing.
                    i += 1;
                    continue;
                }
                if fenced.name == "for" || fenced.name == "if" {
                    // The head is host CODE and goes through verbatim. Neither
                    // construct produces an element, so the body pushes into the
                    // same list — and the compiler resolves what the head binds.
                    //
                    // A `key` clause is stripped off first and becomes an attribute on
                    // whatever the body pushes, so the reconciler can match a row to a
                    // row rather than to an index. The key EXPRESSION goes through
                    // verbatim too, so `key line.idd` is a compile error naming the
                    // field — a key nobody checked would be worse than no key at all.
                    let loop_head: String = star_head_without_key(fenced.head);
                    if fenced.name == "if" && len(loop_head) < len(fenced.head) {
                        return Result.Error("STAR-E006 at " + to_string(fenced.offset)
                            + ": `key` belongs on a `for`, not on an `if` — there is one branch"
                            + " and nothing to tell apart");
                    }
                    let mutable keyed: String = "";
                    match star_key_part(fenced.head) {
                        None => { }
                        Some(expr) => { keyed = expr; }
                    }
                    match star_emit_stmts(fenced.children, target, tag + "_" + to_string(i),
                                          indent + "    ", handlers, keyed,
                                          in_loop || fenced.name == "for") {
                        Error(e) => { return Result.Error(e); }
                        Ok(body) => {
                            out = out + indent + fenced.name + " " + loop_head + " \{\n"
                                + body + indent + "\}\n";
                        }
                    }
                    i += 1;
                    continue;
                }
                if !star_is_element(fenced.name) {
                    return Result.Error("STAR-E001 at " + to_string(fenced.offset)
                        + ": this host does not declare a block named `" + fenced.name
                        + "`. Elements and `for`/`if`/`props` are declared; a component"
                        + " needs cross-file resolution, which does not exist yet");
                }
                // A void element with a body is refused HERE, with the author's
                // offset, rather than emitted and left to `html_element`'s `requires`
                // to catch at run time. Both refuse; only one of them refuses before
                // the page exists, and the contract is what makes the generator's
                // refusal provably complete rather than a list somebody maintains.
                if html_is_void(fenced.name) && len(fenced.children) > 0 {
                    return Result.Error("STAR-E004 at " + to_string(fenced.offset)
                        + ": `" + fenced.name + "` is a void element and cannot have a body."
                        + " Write `::: " + fenced.name + " on:input=...` with nothing between"
                        + " the fences");
                }
                // A key becomes an attribute the reconciler can match on. It is emitted
                // as a real expression, so `key line.idd` is a compile error naming the
                // field — an unchecked key would be worse than none, because it would
                // move a row's identity somewhere silently wrong.
                let mutable attrs: String = "[]";
                let mutable key_attr: String = "";
                if len(key_here) > 0 {
                    key_attr = "html_attr(\"data-star-key\", " + key_here + ")";
                }
                // What is left of the head once `on:` and `key` are off it is attributes.
                let bare_head: String = star_head_without_key(star_head_without_event(fenced.head));
                let mutable written: String = "";
                match star_attrs_of(bare_head) {
                    Error(e) => {
                        return Result.Error(e + " (at " + to_string(fenced.offset) + ")");
                    }
                    Ok(list) => { written = list; }
                }
                match star_event_part(fenced.head) {
                    None => { }
                    Some(part) => {
                        let event: String = star_event_name(part);
                        if !star_event_is_wired(event) {
                            // §4a.5: refuse an event we cannot wire, rather than
                            // emit something plausible. The driver installs a
                            // delegated listener per wired event and no others.
                            return Result.Error("STAR-E002 at " + to_string(fenced.offset)
                                + ": `on:" + event + "` is not an event this host can wire."
                                + " Wired events are click, input, change, submit");
                        }
                        // **A handler inside a `for` is refused, and refusing is the
                        // honest answer rather than a gap.** `dispatch` is a function of
                        // (handler, state); the loop variable is bound in the VIEW and does
                        // not exist there, so emitting the expression produces code that
                        // names something out of scope. The compiler would catch it — with
                        // an error about a variable the author never wrote in a function
                        // they never saw. Refusing here says the true thing instead.
                        //
                        // What it needs is for a handler id to carry a PATH INTO STATE
                        // rather than a captured value, so `dispatch` can re-derive the row
                        // from the state it is given. That is designed and not built, and
                        // it is why `key` landed first: a path through a positional index
                        // is ABA, since `items[3]` is not the same item after a splice.
                        if in_loop {
                            return Result.Error("STAR-E007 at " + to_string(fenced.offset)
                                + ": an `on:` handler inside a `for` is not supported yet."
                                + " A handler runs in `dispatch`, where the loop variable does"
                                + " not exist — it needs an identity to re-derive the row from"
                                + " state, which is designed and unbuilt. Move the handler"
                                + " outside the loop, or drive the row from the whole state");
                        }
                        let index: Int = len(handlers);
                        let added: Int = push(handlers, StarHandler {
                            event: event,
                            expression: star_event_expression(part),
                        });
                        attrs = "[html_attr(\"data-star-h\", \"" + to_string(index) + "\")"
                            + star_joined(key_attr) + star_joined(written) + "]";
                    }
                }
                // **An element that takes phrasing content unwraps its paragraphs**, and
                // this is required rather than preferred: `<p>` is FLOW content and
                // `<button>` takes PHRASING, so `<button><p>x</p></button>` is invalid
                // HTML. BMX is right to parse `increment` as a paragraph — it is one —
                // and deciding what that means inside a button is the host's job.
                //
                // The first version of this rule said "a LONE paragraph becomes text",
                // which had a discontinuity in it: one paragraph became text and two
                // became two `<p>`, so adding a second line to a button changed the
                // output in KIND rather than in quantity. The content model has no such
                // seam — a phrasing element unwraps however many there are, and a flow
                // element keeps them, because in a `<div>` a `<p>` is correct and wanted.
                if star_takes_phrasing(fenced.name) {
                    let mutable phrasing: String = "";
                    let mutable c: Int = 0;
                    while c < len(fenced.children) {
                        match fenced.children[c] {
                            Paragraph(words) => {
                                match bmx_emit_inline(words.children) {
                                    Error(e) => { return Result.Error(e); }
                                    Ok(kids) => {
                                        // `bmx_emit_inline` yields a bracketed list; splice
                                        // the lists together rather than nesting them.
                                        let body: String = substring(kids, 1, len(kids) - 2);
                                        if len(phrasing) > 0 && len(body) > 0 { phrasing = phrasing + ", "; }
                                        phrasing = phrasing + body;
                                    }
                                }
                            }
                            Heading(h) => {
                                return Result.Error("STAR-E005 at " + to_string(fenced.offset)
                                    + ": `" + fenced.name + "` takes phrasing content, so it cannot"
                                    + " contain a heading");
                            }
                            Quote(q) => {
                                return Result.Error("STAR-E005 at " + to_string(fenced.offset)
                                    + ": `" + fenced.name + "` takes phrasing content, so it cannot"
                                    + " contain a quote");
                            }
                            List(l) => {
                                return Result.Error("STAR-E005 at " + to_string(fenced.offset)
                                    + ": `" + fenced.name + "` takes phrasing content, so it cannot"
                                    + " contain a list");
                            }
                            Code(cd) => {
                                return Result.Error("STAR-E005 at " + to_string(fenced.offset)
                                    + ": `" + fenced.name + "` takes phrasing content, so it cannot"
                                    + " contain a code block");
                            }
                            Fenced(f) => {
                                return Result.Error("STAR-E005 at " + to_string(fenced.offset)
                                    + ": `" + fenced.name + "` takes phrasing content, so it cannot"
                                    + " contain a `" + f.name + "` block");
                            }
                        }
                        c += 1;
                    }
                    if attrs == "[]" { attrs = star_attr_list(key_attr, written); }
                    out = out + indent + "let " + label + ": Int = push(" + target
                        + ", html_element(\"" + fenced.name + "\", " + attrs
                        + ", [" + phrasing + "]));\n";
                    i += 1;
                    continue;
                }
                if false {
                    match fenced.children[0] {
                        Paragraph(words) => {
                            match bmx_emit_inline(words.children) {
                                Error(e) => { return Result.Error(e); }
                                Ok(kids) => {
                                    out = out + indent + "let " + label + ": Int = push(" + target
                                        + ", html_element(\"" + fenced.name + "\", " + attrs
                                        + ", " + kids + "));\n";
                                    i += 1;
                                    continue;
                                }
                            }
                        }
                        Heading(h) => { }
                        Quote(q) => { }
                        List(l) => { }
                        Code(c) => { }
                        Fenced(f) => { }
                    }
                }
                match star_emit_stmts(fenced.children, inner, tag + "_" + to_string(i),
                                      indent, handlers, "", in_loop) {
                    Error(e) => { return Result.Error(e); }
                    Ok(body) => {
                        if attrs == "[]" { attrs = star_attr_list(key_attr, written); }
                        out = out + indent + "let mutable " + inner + ": [Html] = [];\n" + body;
                        out = out + indent + "let " + label + ": Int = push(" + target
                            + ", html_element(\"" + fenced.name + "\", " + attrs
                            + ", " + inner + "));\n";
                    }
                }
            }
            Heading(heading) => {
                match bmx_emit_one(blocks[i]) {
                    Error(e) => { return Result.Error(e); }
                    Ok(expr) => { out = out + indent + "let " + label + ": Int = push(" + target + ", " + expr + ");\n"; }
                }
            }
            Paragraph(words) => {
                match bmx_emit_one(blocks[i]) {
                    Error(e) => { return Result.Error(e); }
                    Ok(expr) => { out = out + indent + "let " + label + ": Int = push(" + target + ", " + expr + ");\n"; }
                }
            }
            Quote(words) => {
                match bmx_emit_one(blocks[i]) {
                    Error(e) => { return Result.Error(e); }
                    Ok(expr) => { out = out + indent + "let " + label + ": Int = push(" + target + ", " + expr + ");\n"; }
                }
            }
            List(list) => {
                match bmx_emit_one(blocks[i]) {
                    Error(e) => { return Result.Error(e); }
                    Ok(expr) => { out = out + indent + "let " + label + ": Int = push(" + target + ", " + expr + ");\n"; }
                }
            }
            Code(code) => {
                match bmx_emit_one(blocks[i]) {
                    Error(e) => { return Result.Error(e); }
                    Ok(expr) => { out = out + indent + "let " + label + ": Int = push(" + target + ", " + expr + ");\n"; }
                }
            }
        }
        i += 1;
    }
    return Result.Ok(out);
}

// The `props` head is the component's signature — declared by the component, so an
// invoker never needs an out-of-band list. BMX captured it opaquely; reading it is
// ours, and it goes through verbatim into the function's parameter list, where the
// compiler judges every name and type in it.
pure function star_props(blocks: [Block]) -> String {
    let mutable i: Int = 0;
    while i < len(blocks) {
        match blocks[i] {
            Fenced(fenced) => { if fenced.name == "props" { return fenced.head; } }
            Heading(h) => { }
            Paragraph(p) => { }
            Quote(q) => { }
            List(l) => { }
            Code(c) => { }
        }
        i += 1;
    }
    return "";
}

// The whole of it: a document becomes a `pure function ... -> Html` and a
// `pure function ..._dispatch(handler: Int, <props>) -> <state>`.
//
// **`state` is the FIRST prop's type**, which is the v1 rule and is stated here
// rather than inferred: a handler yields the next state, and with one prop that is
// unambiguous. Structured state is the open v2 question — regions are LIFO and
// nested regions do not exist, so nothing built inside a frame can outlive it.
//
// Both functions are `pure`, so `burxt effects --allow ""` confirms a component
// reaches nothing — a confirmation by construction rather than a discovery.
// The `use` lines of a `===bx` section, and everything else, split apart.
//
// Burxt finds imports by scanning a file's LEADING lines and stops at the first declaration — a
// `use` after a `class` is a syntax error, measured rather than assumed. So a component's imports
// have to be lifted above the generated header, and the rest of the author's code placed after it.
//
// A `use` is recognised at the start of a line, which is where the language requires it anyway.
public function star_imports_of(code: String) -> String {
    let mutable out: String = "";
    let width: Int = len(code);
    let mutable at: Int = 0;
    while at < width {
        let stop: Int = star_end_of_line(code, at, width);
        let line: String = substring(code, at, stop - at);
        if star_is_use_line(line) {
            out = out + line + "\n";
        }
        at = stop + 1;
    }
    return out;
}

public function star_code_without_imports(code: String) -> String {
    let mutable out: String = "";
    let width: Int = len(code);
    let mutable at: Int = 0;
    while at < width {
        let stop: Int = star_end_of_line(code, at, width);
        let line: String = substring(code, at, stop - at);
        if !star_is_use_line(line) {
            out = out + line + "\n";
        }
        at = stop + 1;
    }
    return out;
}

pure function star_is_use_line(line: String) -> Bool {
    let mutable i: Int = 0;
    while i < len(line) && byte_at(line, i) == 32 {
        i += 1;
    }
    if i + 4 > len(line) {
        return false;
    }
    return byte_at(line, i) == 117 && byte_at(line, i + 1) == 115
        && byte_at(line, i + 2) == 101 && byte_at(line, i + 3) == 32;
}

// ---- attributes ---------------------------------------------------------------------------
//
// `::: a href=/about class=nav` — the head, once `on:` and `key` have been taken off it, is a list
// of `name=value` pairs. Without these star can emit a page and not style it, which is the
// difference between a renderer and something anybody would ship.
//
// **A value ends at a space, or is quoted.** `class="a b"` for a value with spaces. That rule is
// forced rather than chosen: an `on:` expression runs to the end of the head, because expressions
// contain spaces and equals signs and the format does not parse heads. So `on:` is written last and
// everything before it is attributes.
//
// **A value may interpolate.** `href=/posts/{{ to_string(id) }}` becomes a concatenation, with the
// expression going through verbatim exactly as a slot does — so a typo in it is a compile error
// naming what the author wrote, rather than a link to a page that does not exist.
//
// A bare name is a boolean attribute: `::: input disabled` emits `disabled=""`, which is how HTML
// spells true.

// `, x` when x is there, nothing when it is not — so a list can be built by concatenation without
// a trailing comma nobody can see in generated source.
pure function star_joined(term: String) -> String {
    if len(term) == 0 {
        return "";
    }
    return ", " + term;
}

pure function star_attr_list(key_attr: String, written: String) -> String {
    let mutable inner: String = key_attr;
    if len(inner) == 0 {
        inner = written;
    } else {
        inner = inner + star_joined(written);
    }
    return "[" + inner + "]";
}

// The Burxt expression for one attribute value: a String literal, or a concatenation when the value
// interpolates. `/posts/{{ to_string(id) }}` -> `"/posts/" + to_string(id)`.
pure function star_attr_value(raw: String) -> String {
    let mutable out: String = "";
    let mutable literal: String = "";
    let mutable i: Int = 0;
    let width: Int = len(raw);
    while i < width {
        if i + 1 < width && byte_at(raw, i) == 123 && byte_at(raw, i + 1) == 123 {
            let mutable j: Int = i + 2;
            while j + 1 < width && !(byte_at(raw, j) == 125 && byte_at(raw, j + 1) == 125) {
                j += 1;
            }
            if len(literal) > 0 {
                if len(out) > 0 { out = out + " + "; }
                out = out + "\"" + literal + "\"";
                literal = "";
            }
            if len(out) > 0 { out = out + " + "; }
            out = out + "(" + star_trim(substring(raw, i + 2, j - (i + 2))) + ")";
            i = j + 2;
        } else {
            literal = literal + byte_as_string(byte_at(raw, i));
            i += 1;
        }
    }
    if len(literal) > 0 {
        if len(out) > 0 { out = out + " + "; }
        out = out + "\"" + literal + "\"";
    }
    if len(out) == 0 {
        return "\"\"";
    }
    return out;
}

pure function star_trim(text: String) -> String {
    let mutable from: Int = 0;
    while from < len(text) && byte_at(text, from) == 32 {
        from += 1;
    }
    return bmx_strip_end(substring(text, from, len(text) - from));
}

// Every `name=value` in a head, as `html_attr(...)` terms ready to go in a list.
//
// The head handed in has already had `on:` and `key` removed, so what is left is attributes and
// nothing else. Refuses a value it cannot read rather than dropping it — an attribute that silently
// does not appear is the failure this whole project keeps finding.
pure function star_attrs_of(head: String) -> Result<String, String> {
    let mutable out: String = "";
    let width: Int = len(head);
    let mutable i: Int = 0;
    while i < width {
        while i < width && byte_at(head, i) == 32 {
            i += 1;
        }
        if i >= width {
            return Result.Ok(out);
        }
        let name_from: Int = i;
        while i < width && byte_at(head, i) != 32 && byte_at(head, i) != 61 {
            i += 1;
        }
        let name: String = substring(head, name_from, i - name_from);
        let mutable value: String = "\"\"";
        if i < width && byte_at(head, i) == 61 {
            i += 1;
            if i < width && byte_at(head, i) == 34 {
                i += 1;
                let from: Int = i;
                while i < width && byte_at(head, i) != 34 {
                    i += 1;
                }
                if i >= width {
                    return Result.Error("STAR-E009: the value of `" + name + "` opens with a quote"
                        + " and never closes it");
                }
                value = star_attr_value(substring(head, from, i - from));
                i += 1;
            } else {
                let from: Int = i;
                // A `{{ … }}` value may hold spaces, so an interpolation runs to its closing braces
                // rather than to the next space.
                let mutable depth: Int = 0;
                while i < width && (depth > 0 || byte_at(head, i) != 32) {
                    if i + 1 < width && byte_at(head, i) == 123 && byte_at(head, i + 1) == 123 {
                        depth += 1;
                        i += 1;
                    }
                    if i + 1 < width && byte_at(head, i) == 125 && byte_at(head, i + 1) == 125 {
                        depth -= 1;
                        i += 1;
                    }
                    i += 1;
                }
                value = star_attr_value(substring(head, from, i - from));
            }
        }
        if len(name) > 0 {
            if len(out) > 0 { out = out + ", "; }
            out = out + "html_attr(\"" + name + "\", " + value + ")";
        }
    }
    return Result.Ok(out);
}

// ---- the two modes, and the `===bx` section is what chooses between them ----------------------
//
// **Expression mode** — no `===bx`. `on:click=count + 1` says what the next state IS, and a handler
// is a one-line expression. This is what the guide teaches and it stays exactly as it was.
//
// **Component mode** — a `===bx` section. `on:click=Msg.Increment` names a MESSAGE, and the author's
// own `update` decides the next state. That lifts the one-line limit: an update can `match`, call
// helpers, and be read and tested on its own.
//
// The switch is the presence of the section rather than a flag, because a reader can see it. And it
// is not sniffed from whether an `update` exists — a file with `===bx` and no `update` gets a named
// refusal, not a compiler error about a function nobody wrote.
public function star_generate(source: String, name: String) -> Result<StarComponent, String> {
    let code: String = star_section(source, "bx");
    let component_mode: Bool = len(bmx_strip_end(code)) > 0;
    if component_mode && !star_mentions(code, "function update(") {
        return Result.Error("STAR-E008: this document has a `===bx` section, so its `on:` handlers"
            + " are MESSAGES and something has to turn a message into the next state. Add"
            + " `pure function update(msg: Msg, m: Model) -> Model`, or remove the `===bx`"
            + " section to write handlers as expressions.");
    }
    match bmx_parse(star_markup(source)) {
        Error(e) => { return Result.Error(e); }
        Ok(blocks) => {
            let props: String = star_props(blocks);
            if len(props) == 0 {
                return Result.Error("STAR-E003: this document declares no `props` block, so it has"
                    + " no signature and nothing can invoke it. Add `::: props name: Type`");
            }
            let mutable handlers: [StarHandler] = [];
            match star_emit_stmts(blocks, "kids", "0", "    ", handlers, "", false) {
                Error(e) => { return Result.Error(e); }
                Ok(body) => {
                    let mutable view: String = "pure function " + name + "(" + props + ") -> Html allocates \{\n";
                    view = view + "    let mutable kids: [Html] = [];\n" + body;
                    view = view + "    return html_element(\"div\", [html_attr(\"class\", \"star\")], kids);\n\}\n";

                    // The state type is the first prop's, read off the declaration
                    // the author wrote rather than guessed at.
                    let mutable state_type: String = "";
                    let mutable seen_colon: Bool = false;
                    let mutable k: Int = 0;
                    while k < len(props) {
                        let b: Int = byte_at(props, k);
                        if b == 44 { k = len(props); }
                        else {
                            if seen_colon { state_type = state_type + byte_as_string(b); }
                            if b == 58 { seen_colon = true; }
                            k += 1;
                        }
                    }
                    state_type = bmx_strip_end(state_type);
                    let mutable trimmed: String = state_type;
                    while len(trimmed) > 0 && byte_at(trimmed, 0) == 32 {
                        trimmed = substring(trimmed, 1, len(trimmed) - 1);
                    }

                    let mutable dispatch: String = "pure function " + name + "_dispatch(handler: Int, "
                        + props + ") -> " + trimmed + " \{\n";
                    let mutable h: Int = 0;
                    while h < len(handlers) {
                        // Expression mode returns the expression. Component mode hands it to
                        // `update` as a message — the ONE line that separates the two, because
                        // everything else about a handler is the same in both.
                        let mutable answer: String = handlers[h].expression;
                        if component_mode {
                            answer = "update(" + answer + ", " + star_first_prop_name(props) + ")";
                        }
                        dispatch = dispatch + "    if handler == " + to_string(h) + " \{ return "
                            + answer + "; \}\n";
                        h += 1;
                    }
                    // An index the page could not have produced is a bug in the
                    // driver, not in the document — so it holds state rather than
                    // inventing one.
                    dispatch = dispatch + "    return " + star_first_prop_name(props) + ";\n\}\n";

                    return Result.Ok(StarComponent {
                        view: view, dispatch: dispatch, handlers: handlers, code: code,
                        props: props, argument_list: star_argument_list(props),
                    });
                }
            }
        }
    }
}

pure function star_first_prop_name(props: String) -> String {
    let mutable i: Int = 0;
    while i < len(props) {
        if byte_at(props, i) == 58 { return bmx_strip_end(substring(props, 0, i)); }
        i += 1;
    }
    return props;
}

// `count: Int, label: String` -> `count, label`. What the entry point passes on.
pure function star_argument_list(props: String) -> String {
    let mutable out: String = "";
    let mutable name: String = "";
    let mutable seen_colon: Bool = false;
    let mutable i: Int = 0;
    while i < len(props) {
        let b: Int = byte_at(props, i);
        if b == 44 {
            if len(out) > 0 { out = out + ", "; }
            out = out + name;
            name = "";
            seen_colon = false;
        } else {
            if b == 58 { seen_colon = true; }
            if !seen_colon && b != 32 { name = name + byte_as_string(b); }
        }
        i += 1;
    }
    if len(name) > 0 {
        if len(out) > 0 { out = out + ", "; }
        out = out + name;
    }
    return out;
}
