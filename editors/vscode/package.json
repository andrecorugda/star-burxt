{
  "name": "star-burxt",
  "displayName": "star-burxt",
  "description": "Syntax highlighting and diagnostics for .sbmx components.",
  "version": "0.2.0",
  "publisher": "andrecorugda",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sbmx",
        "aliases": [
          "star-burxt component",
          "sbmx"
        ],
        "extensions": [
          ".sbmx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/sbmx-gear-icon-128.png",
          "dark": "./icons/sbmx-gear-icon-128.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "sbmx",
        "scopeName": "source.sbmx",
        "path": "./syntaxes/sbmx.tmLanguage.json",
        "embeddedLanguages": {
          "source.burxt": "burxt",
          "source.css": "css",
          "text.bmx": "bmx"
        }
      },
      {
        "//": "Injected into BMX rather than shipped as a language: a slot's expression and a block's head are Burxt, and BMX leaves both uncoloured on purpose. This colours them wherever BMX is highlighted \u2014 in a .bmx as well as a .sbmx.",
        "scopeName": "star.injection",
        "path": "./syntaxes/star-injection.tmLanguage.json",
        "injectTo": [
          "text.bmx",
          "source.sbmx"
        ]
      }
    ],
    "configuration": {
      "title": "star-burxt",
      "properties": {
        "starBurxt.check": {
          "type": "string",
          "default": "star-check",
          "description": "The star-check binary. Built with: burxt build examples/check.bx -o star-check"
        }
      }
    }
  },
  "main": "./client.js",
  "activationEvents": [
    "onLanguage:sbmx"
  ],
  "icon": "icons/sbmx-gear-icon-128.png"
}
