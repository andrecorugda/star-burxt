===style.local
.row   { display: flex; gap: .5rem; align-items: center; margin: .35rem 0; }
.lift  { font: inherit; padding: .25rem .6rem; }
.field { font: inherit; padding: .3rem .5rem; border: 1px solid #cbd2dd; border-radius: 5px; }
===

:props: model: Model
:!props:

# Rows — {{ to_string(model.moves) }} moves

:for: row in model.rows key to_string(row.id)
    :div: class=row
        :input: class=field value={{ row.text }} on:input=Msg.Typed(string_to_int(key, 0), value)
        :!input:
        :button: class=lift on:click=Msg.Lift(string_to_int(key, 0))
        up
        :!button:
    :!div:
:!for:
