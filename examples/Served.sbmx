===bx
use "std/string.bx";
use "std/json.bx";

class Model { user: String, unread: Int }
enum Msg { Clear }

pure function update(msg: Msg, m: Model) -> Model {
    match msg {
        Clear => { return Model { user: m.user, unread: 0 }; }
    }
}

// **Server only, and its SIGNATURE says so.** A view is `pure` and cannot call this; the compiler
// refuses it. So a page cannot fetch while it renders.
external function db_lookup(who: String) -> CInt touches network;

// **What goes in the page's `<head>`, as a function of the state.** Optional: a component with no
// `head` gets a document with the charset, the viewport and its own stylesheet, which is everything
// star can know by itself. A title is something only the component knows.
pure function head(m: Model) -> [Html] allocates {
    let mutable top: [Html] = [];
    let a: Int = push(top, html_element("title", [], [html_text(m.user + " — unread")]));
    let b: Int = push(top, html_element("meta", [
        html_attr("name", "description"),
        html_attr("content", "Rendered on the server, from the same component the browser runs."),
    ], []));
    return top;
}

function load(request: String) -> Model touches network, files, clock {
    let SECRET_DB_PASSWORD_DO_NOT_SHIP: String = "hunter2-should-never-reach-a-browser";
    let n: Int = db_lookup(SECRET_DB_PASSWORD_DO_NOT_SHIP);
    return Model { user: request, unread: n };
}

pure function to_text(m: Model) -> String allocates {
    let mutable f: [Field] = [];
    let a: Int = push(f, json_field("user", json_text(m.user)));
    let b: Int = push(f, json_field("unread", json_int(m.unread)));
    return json_render(json_object(f));
}

function from_text(text: String) -> Model {
    let mutable user: String = "";
    let mutable unread: Int = 0;
    match json_parse(text) {
        Error(e) => { }
        Ok(v) => {
            match json_at(v, "unread") { None => { } Some(x) => { match json_as_int(x) { None => { } Some(n) => { unread = n; } } } }
        }
    }
    return Model { user: user, unread: unread };
}
