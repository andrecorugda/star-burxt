// `star check` — every problem in a `.sbmx`, in one place, with a position an editor can jump to.
//
//     burxt build examples/check.bx -o star-check
//     ./star-check Page.sbmx
//
// **THREE KINDS OF PROBLEM AND THREE OWNERS, reported by one command.** A person editing a component
// does not care which layer refused them, and until now they had to run three tools to find out:
//
//     BMX-Ennn    the document is not well formed        `bmx_check`
//     STAR-Ennn   the document is not a component        star's own rules
//     the compiler  the code inside it does not typecheck  `burxt check` on what was generated
//
// The third is the one that matters and the one nobody else can do: a slot naming a field that does
// not exist, a handler adding a String to an Int, money rounded without saying how. Those are the
// whole reason star exists, and they are found by generating the component and asking the real
// compiler — not by a linter's imitation of it.
//
// This is what a language server wraps. Written as a program first because a program can be run by
// hand, tested in CI, and used from a Makefile — and because an LSP that disagrees with the command
// line is worse than having only one of them.
use "../star.bx";
use "../resolve.bx";
use "std/os.bx";
use "std/files.bx";

if os_arg_count() < 2 {
    print_error("usage: star-check <document.sbmx>");
    exit(2);
}

let path: String = os_arg(1);

match file_read_maybe(path) {
    None => { print_error("cannot read " + path); exit(2); }
    Some(source) => {
        // **BMX first, because nothing downstream is meaningful on a malformed document.** A missing
        // fence makes every block after it belong somewhere else, so star's refusals would be about
        // a structure the author did not write.
        match bmx_check(star_markup(source)) {
            Some(d) => {
                print_error(path + ":" + to_string(d.line) + ":" + to_string(d.column)
                    + ": " + d.code + " " + d.message);
                exit(1);
            }
            None => { }
        }

        // star's own rules. The generator IS the linter — a second implementation of "which blocks
        // are legal" would be a second thing to keep in step, and the two would disagree on the day
        // it mattered.
        // The SAME resolution the generator does, from the same function. A checker that resolved
        // imports differently would pass documents the generator refuses, and disagree silently.
        // Written, not just measured: a page's generated source says `use "./Badge.bx"`, so the
        // child has to exist for the compiler to read it. Checking a page means checking what it
        // is made of.
        let known: [StarKnown] = star_resolve(path, source, true);
        match star_generate(source, "check", known) {
            Error(message) => {
                print_error(path + ": " + message);
                exit(1);
            }
            Ok(component) => {
                // The generated component, for the compiler to judge. Written beside the source so a
                // relative `use` inside it means what its author meant, and named so it is obvious
                // what it is if anybody finds it.
                let out: String = star_without_extension(path) + ".check.bx";
                let wrote: Int = file_write(out,
                    "// GENERATED by star-check. Delete freely.\n"
                    + star_source_of(component, "check"));

                // **The real compiler, on the real generated code.** A linter that reimplemented
                // the type rules would be a second opinion, and the second opinion is the one that
                // would be wrong — a slot naming a missing field, a handler adding a String to an
                // Int, money rounded without saying how. Those are the whole reason star exists and
                // they are only findable by asking the thing that decides.
                //
                // Errors point into the GENERATED file, which is honest: that is where the code the
                // compiler judged lives, and it is readable on purpose. Mapping them back onto the
                // document needs the slot offsets a language server will carry; a command line has
                // the file to hand.
                let judged: Int = os_run("burxt check " + out);
                let removed: Bool = file_delete(out);
                if judged != 0 {
                    exit(1);
                }
                print(path + ": no problems");
            }
        }
    }
}
