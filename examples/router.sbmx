===bx
enum Route { Home, Post(Int), Search(String) }
class Model { route: Route, hits: Int }
enum Msg { Go(Route) }

pure function update(msg: Msg, m: Model) -> Model {
    match msg {
        Go(r) => { return Model { route: r, hits: m.hits + 1 }; }
    }
}
===

