===bx
// Every form control star can drive, and each one's value means something different.
//
// **And a form now shows its own state.** `checked={{ model.agree }}` is a decision rather than a value,
// because HTML has no false: `checked="false"` is checked, and the only way to say no is for the
// attribute to be absent. Before this, server-rendering this component with `agree: true` produced an
// unticked box and an unselected dropdown — the page disagreeing with the model, silently, which is the
// first thing anybody would try.
//
// **Its dropdown labels were BLANK when it shipped.** `:option: value=small small :!option:` reads the
// second `small` as a boolean attribute, so every option had a value and no text — and the browser test
// I wrote asserted the model rather than the page, so it passed. STAR-E026 refuses that spelling now.
//
// The edge is what arrives as `value`. A text field gives its text; a CHECKBOX gives its checked state
// rather than its value, because `on` is not an answer; a select gives the chosen option; a radio gives
// the value of the one that was clicked. One `on:` per element, so each control carries its own handler.
use "std/string.bx";
use "std/json.bx";

class Model { size: String, tone: String, agree: Bool, note: String }
enum Msg { Size(String), Tone(String), Agree(String), Note(String) }

pure function update(msg: Msg, m: Model) -> Model {
    match msg {
        Size(v)  => { return Model { size: v, tone: m.tone, agree: m.agree, note: m.note }; }
        Tone(v)  => { return Model { size: m.size, tone: v, agree: m.agree, note: m.note }; }
        Agree(v) => { return Model { size: m.size, tone: m.tone, agree: v == "true", note: m.note }; }
        Note(v)  => { return Model { size: m.size, tone: m.tone, agree: m.agree, note: v }; }
    }
}

pure function summary(m: Model) -> String allocates {
    let mutable out: String = m.size + ", " + m.tone;
    if m.agree { out = out + ", agreed"; } else { out = out + ", not agreed"; }
    return out + " — " + to_string(len(m.note)) + " characters";
}

pure function to_text(m: Model) -> String allocates {
    let mutable f: [Field] = [];
    let a: Int = push(f, json_field("size", json_text(m.size)));
    let b: Int = push(f, json_field("tone", json_text(m.tone)));
    let c: Int = push(f, json_field("agree", json_truth(m.agree)));
    let d: Int = push(f, json_field("note", json_text(m.note)));
    return json_render(json_object(f));
}

pure function text_at(v: Json, name: String, fallback: String) -> String {
    match json_at(v, name) {
        None => { return fallback; }
        Some(x) => { match json_as_text(x) { None => { return fallback; } Some(t) => { return t; } } }
    }
}

function from_text(text: String) -> Model {
    match json_parse(text) {
        Error(e) => { return Model { size: "medium", tone: "warm", agree: false, note: "" }; }
        Ok(v) => {
            let mutable agree: Bool = false;
            match json_at(v, "agree") {
                None => { }
                Some(x) => { match json_as_truth(x) { None => { } Some(b) => { agree = b; } } }
            }
            return Model { size: text_at(v, "size", "medium"), tone: text_at(v, "tone", "warm"),
                           agree: agree, note: text_at(v, "note", "") };
        }
    }
}
===

===style.local
/* Only the layout. Everything that makes it look like a product is the page's theme. */
.field  { margin: 0 0 1rem; }
.field:last-child { margin-bottom: 0; }
.tones  { display: flex; gap: 1.2rem; }
===

:props: model: Model
:!props:

:div: class=bx-card
    :div: class=bx-spread
        :h2: class=bx-title child=Preferences :!h2:
        :span: class="bx-badge bx-badge-quiet" child={summary(model)} :!span:
    :!div:

    :hr: class=bx-divider :!hr:

    :div: class=field
        :label: class=bx-label child=Size :!label:
        :select: class=bx-select on:change=Msg.Size(value)
            :option: value=small selected={{ model.size == "small" }} child=Small :!option:
            :option: value=medium selected={{ model.size == "medium" }} child=Medium :!option:
            :option: value=large selected={{ model.size == "large" }} child=Large :!option:
        :!select:
    :!div:

    :fieldset: class="bx-fieldset field"
        :legend: child=Tone :!legend:
        :div: class=tones
            :label: class=bx-check
                :input: type=radio name=tone value=warm checked={{ model.tone == "warm" }} on:change=Msg.Tone(value) :!input:
                :span: child=Warm :!span:
            :!label:
            :label: class=bx-check
                :input: type=radio name=tone value=cool checked={{ model.tone == "cool" }} on:change=Msg.Tone(value) :!input:
                :span: child=Cool :!span:
            :!label:
        :!div:
    :!fieldset:

    :div: class=field
        :label: class=bx-check
            :input: type=checkbox checked={{ model.agree }} on:change=Msg.Agree(value) :!input:
            :span: child={"I agree to the terms"} :!span:
        :!label:
    :!div:

    :div: class=field
        :label: class=bx-label child=Notes :!label:
        :textarea: class=bx-area on:input=Msg.Note(value)
        {{ model.note }}
        :!textarea:
    :!div:
:!div:
