===bx
use "std/string.bx";
use "std/json.bx";

class Task  { id: Int, label: String, done: Bool }
class Model { tasks: [Task], draft: String, view: String, next_id: Int }

enum Msg { Toggle(Int), Add, Draft(String), Show(String), Clear }

pure function toggled(tasks: [Task], id: Int) -> [Task] allocates {
    let mutable out: [Task] = [];
    let mutable i: Int = 0;
    while i < len(tasks) {
        let t: Task = tasks[i];
        if t.id == id {
            let a: Int = push(out, Task { id: t.id, label: t.label, done: !t.done });
        } else {
            let b: Int = push(out, t);
        }
        i += 1;
    }
    return out;
}

pure function kept(tasks: [Task], done: Bool) -> [Task] allocates {
    let mutable out: [Task] = [];
    let mutable i: Int = 0;
    while i < len(tasks) {
        if tasks[i].done == done { let a: Int = push(out, tasks[i]); }
        i += 1;
    }
    return out;
}

pure function open_count(tasks: [Task]) -> Int {
    let mutable n: Int = 0;
    let mutable i: Int = 0;
    while i < len(tasks) {
        if !tasks[i].done { n += 1; }
        i += 1;
    }
    return n;
}

// A class name is a value, so a state can choose one. There is no `class:done={...}` directive
// because there does not need to be — the class attribute takes an expression like any other.
// **Which tab is showing, asked of the state — and the stylesheet was already ready for it.**
// `===style.local` has carried a `.tab.on` rule since this component was written, and the markup never
// set that class, so the rule could not match anything a render produced. Dead styling for a state that
// could not happen: the CSS is valid, the class simply never appears, and nothing reports it. The
// component knew which view was showing and never told the page — every tab looked identical, including
// the one you were looking at.
pure function tab_class(m: Model, which: String) -> String {
    if m.view == which { return "tab on"; }
    return "tab";
}

pure function pick_class(done: Bool) -> String {
    if done { return "pick did"; }
    return "pick";
}

// Which rows this state shows. A view asks for it; it does not decide it.
pure function shown(m: Model) -> [Task] allocates {
    if m.view == "open" { return kept(m.tasks, false); }
    if m.view == "done" { return kept(m.tasks, true); }
    return m.tasks;
}

pure function update(msg: Msg, m: Model) -> Model allocates {
    match msg {
        Toggle(id) => {
            return Model { tasks: toggled(m.tasks, id), draft: m.draft, view: m.view, next_id: m.next_id };
        }
        Draft(text) => {
            return Model { tasks: m.tasks, draft: text, view: m.view, next_id: m.next_id };
        }
        Show(which) => {
            return Model { tasks: m.tasks, draft: m.draft, view: which, next_id: m.next_id };
        }
        Clear => {
            return Model { tasks: kept(m.tasks, false), draft: m.draft, view: m.view, next_id: m.next_id };
        }
        Add => {
            if len(m.draft) == 0 { return m; }
            let mutable out: [Task] = [];
            let mutable i: Int = 0;
            while i < len(m.tasks) { let k: Int = push(out, m.tasks[i]); i += 1; }
            let n: Int = push(out, Task { id: m.next_id, label: m.draft, done: false });
            return Model { tasks: out, draft: "", view: m.view, next_id: m.next_id + 1 };
        }
    }
}

pure function to_text(m: Model) -> String allocates {
    let mutable rows: [Json] = [];
    let mutable i: Int = 0;
    while i < len(m.tasks) {
        let mutable f: [Field] = [];
        let a: Int = push(f, json_field("id", json_int(m.tasks[i].id)));
        let b: Int = push(f, json_field("label", json_text(m.tasks[i].label)));
        let c: Int = push(f, json_field("done", json_truth(m.tasks[i].done)));
        let r: Int = push(rows, json_object(f));
        i += 1;
    }
    let mutable top: [Field] = [];
    let d: Int = push(top, json_field("tasks", json_list(rows)));
    let e: Int = push(top, json_field("draft", json_text(m.draft)));
    let g: Int = push(top, json_field("view", json_text(m.view)));
    let h: Int = push(top, json_field("next_id", json_int(m.next_id)));
    return json_render(json_object(top));
}

function from_text(text: String) -> Model allocates {
    let mutable out: [Task] = [];
    let mutable draft: String = "";
    let mutable view: String = "all";
    let mutable most: Int = 1;
    match json_parse(text) {
        Error(e) => { return Model { tasks: out, draft: draft, view: view, next_id: 1 }; }
        Ok(value) => {
            match json_at(value, "draft") {
                None => { }
                Some(v) => { match json_as_text(v) { None => { } Some(t) => { draft = t; } } }
            }
            match json_at(value, "view") {
                None => { }
                Some(v) => { match json_as_text(v) { None => { } Some(t) => { view = t; } } }
            }
            match json_at(value, "tasks") {
                None => { }
                Some(list) => {
                    match list {
                        Null => { }
                        Truth(b) => { }
                        Number(n) => { }
                        Text(t) => { }
                        Object(f) => { }
                        List(rows) => {
                            let mutable i: Int = 0;
                            while i < len(rows) {
                                let row: Json = rows[i];
                                let mutable id: Int = 0;
                                let mutable label: String = "";
                                let mutable done: Bool = false;
                                match json_at(row, "id") {
                                    None => { }
                                    Some(v) => { match json_as_int(v) { None => { } Some(n) => { id = n; } } }
                                }
                                match json_at(row, "label") {
                                    None => { }
                                    Some(v) => { match json_as_text(v) { None => { } Some(t) => { label = t; } } }
                                }
                                match json_at(row, "done") {
                                    None => { }
                                    Some(v) => { match json_as_truth(v) { None => { } Some(b) => { done = b; } } }
                                }
                                let k: Int = push(out, Task { id: id, label: label, done: done });
                                if id >= most { most = id + 1; }
                                i += 1;
                            }
                        }
                    }
                }
            }
        }
    }
    return Model { tasks: out, draft: draft, view: view, next_id: most };
}
