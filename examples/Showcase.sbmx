===style.local
.card {
  max-width: 30rem; margin: 2.5rem auto; padding: 0;
  font: 15px/1.55 var(--bx-font);
  color: var(--bx-ink); background: var(--bx-surface);
  border: 1px solid var(--bx-line); border-radius: 14px;
  box-shadow: var(--bx-shadow);
  overflow: hidden;
}
.top { padding: 1.15rem 1.3rem .9rem; border-bottom: 1px solid var(--bx-line-soft); }
.top h1 { margin: 0; font-size: 1.15rem; letter-spacing: -.01em; }
.top p { margin: .3rem 0 0; color: var(--bx-ink-soft); font-size: .875rem; }
.count { color: var(--bx-brand); font-weight: 600; margin-right: .3rem; }

.row-add { display: flex; gap: .5rem; padding: .9rem 1.3rem; }
.row-add input {
  flex: 1; padding: .55rem .7rem; font: inherit; color: inherit;
  border: 1px solid var(--bx-line); border-radius: 8px; background: var(--bx-surface);
}
.row-add input:focus { outline: 2px solid #f4b183; outline-offset: 0; border-color: var(--bx-brand); }
.add {
  padding: .55rem .95rem; font: inherit; font-weight: 600; color: #fff;
  background: var(--bx-brand); border: 0; border-radius: 8px; cursor: pointer;
}
.add:hover { background: var(--bx-brand-deep); }

.tabs { display: flex; gap: .35rem; padding: 0 1.3rem .9rem; }
.tab.on { background: var(--bx-brand-wash); color: var(--bx-brand-deep); font-weight: 600; }
.tab {
  padding: .3rem .7rem; font: inherit; font-size: .82rem; color: var(--bx-ink-soft);
  background: var(--bx-line-soft); border: 0; border-radius: 999px; cursor: pointer;
}
.tab:hover { background: var(--bx-line); }

.list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--bx-line-soft); }
.item { display: flex; align-items: center; gap: .7rem; padding: .1rem 1.3rem; border-bottom: 1px solid #f6f7fa; }
.pick {
  flex: 1; display: flex; align-items: center; gap: .65rem;
  padding: .7rem 0; font: inherit; color: inherit; text-align: left;
  background: none; border: 0; cursor: pointer;
}
.box {
  width: 1.05rem; height: 1.05rem; flex: none;
  border: 1.5px solid #cbd2dd; border-radius: 5px;
}
.pick.did .box { background: var(--bx-brand); border-color: var(--bx-brand); }
.pick.did .text { color: var(--bx-ink-faint); text-decoration: line-through; }

.foot { display: flex; justify-content: space-between; align-items: center;
        padding: .8rem 1.3rem; color: #8b919d; font-size: .8rem; }
.clear { font: inherit; font-size: .8rem; color: var(--bx-brand); background: none;
         border: 0; padding: 0; cursor: pointer; }
.clear:hover { text-decoration: underline; }
.empty { padding: 1.6rem 1.3rem; color: var(--bx-ink-faint); text-align: center; border-bottom: 1px solid #f6f7fa; }
===

:props: model: Model
:!props:

:section: class=card

:div: class=top

# Today

:p:
:span: class=count
{{ to_string(open_count(model.tasks)) }} open
:!span:
of {{ to_string(len(model.tasks)) }} — written as a document, compiled to WebAssembly
:!p:

:!div:

:div: class=row-add

:input: value={{ model.draft }} placeholder="What needs doing?" on:input=Msg.Draft(value)
:!input:

:button: class=add on:click=Msg.Add
Add
:!button:

:!div:

:div: class=tabs

:button: class={{ tab_class(model, "all") }} on:click=Msg.Show("all")
All
:!button:

:button: class={{ tab_class(model, "open") }} on:click=Msg.Show("open")
Open
:!button:

:button: class={{ tab_class(model, "done") }} on:click=Msg.Show("done")
Done
:!button:

:!div:

:ul: class=list

:for: task in shown(model) key to_string(task.id)

:li: class=item

:button: class={{ pick_class(task.done) }} on:click=Msg.Toggle(string_to_int(key, 0))

:span: class=box
:!span:

:span: class=text
{{ task.label }}
:!span:

:!button:

:!li:

:!for:

:!ul:

:div: class=foot

:span:
{{ to_string(open_count(model.tasks)) }} left
:!span:

:button: class=clear on:click=Msg.Clear
Clear done
:!button:

:!div:

:!section:
