===bx
use "std/string.bx";
use "std/json.bx";

class Todo { id: Int, label: String, done: Bool }
class Model { todos: [Todo], next_id: Int }

enum Msg { Toggle(Int), Add }

pure function toggled(todos: [Todo], id: Int) -> [Todo] allocates {
    let mutable out: [Todo] = [];
    let mutable i: Int = 0;
    while i < len(todos) {
        let t: Todo = todos[i];
        if t.id == id {
            let a: Int = push(out, Todo { id: t.id, label: t.label, done: !t.done });
        } else {
            let b: Int = push(out, t);
        }
        i += 1;
    }
    return out;
}

// Which class a row wears. A `pure` function rather than a conditional in the markup, because the view
// asks a question and the answer belongs with the state it is about.
pure function mark(done: Bool) -> String {
    if done { return "pick done"; }
    return "pick";
}

pure function update(msg: Msg, m: Model) -> Model allocates {
    match msg {
        Toggle(id) => { return Model { todos: toggled(m.todos, id), next_id: m.next_id }; }
        Add => {
            let mutable out: [Todo] = [];
            let mutable i: Int = 0;
            while i < len(m.todos) { let k: Int = push(out, m.todos[i]); i += 1; }
            let n: Int = push(out, Todo { id: m.next_id, label: "task " + to_string(m.next_id), done: false });
            return Model { todos: out, next_id: m.next_id + 1 };
        }
    }
}

// The state crosses the boundary as text, because nothing here can hold it between calls.
pure function to_text(m: Model) -> String allocates {
    let mutable rows: [Json] = [];
    let mutable i: Int = 0;
    while i < len(m.todos) {
        let mutable f: [Field] = [];
        let a: Int = push(f, json_field("id", json_int(m.todos[i].id)));
        let b: Int = push(f, json_field("label", json_text(m.todos[i].label)));
        let c: Int = push(f, json_field("done", json_truth(m.todos[i].done)));
        let r: Int = push(rows, json_object(f));
        i += 1;
    }
    let mutable top: [Field] = [];
    let d: Int = push(top, json_field("todos", json_list(rows)));
    let e: Int = push(top, json_field("next_id", json_int(m.next_id)));
    return json_render(json_object(top));
}

function from_text(text: String) -> Model allocates {
    let mutable out: [Todo] = [];
    let mutable most: Int = 1;
    match json_parse(text) {
        Error(e) => { return Model { todos: out, next_id: 1 }; }
        Ok(value) => {
            match json_at(value, "todos") {
                None => { }
                Some(list) => {
                    match list {
                        Null => { }
                        Truth(b) => { }
                        Number(n) => { }
                        Text(t) => { }
                        Object(f) => { }
                        List(rows) => {
                            let mutable i: Int = 0;
                            while i < len(rows) {
                                let row: Json = rows[i];
                                let mutable id: Int = 0;
                                let mutable label: String = "";
                                let mutable done: Bool = false;
                                match json_at(row, "id") {
                                    None => { }
                                    Some(v) => { match json_as_int(v) { None => { } Some(n) => { id = n; } } }
                                }
                                match json_at(row, "label") {
                                    None => { }
                                    Some(v) => { match json_as_text(v) { None => { } Some(t) => { label = t; } } }
                                }
                                match json_at(row, "done") {
                                    None => { }
                                    Some(v) => { match json_as_truth(v) { None => { } Some(b) => { done = b; } } }
                                }
                                let k: Int = push(out, Todo { id: id, label: label, done: done });
                                if id >= most { most = id + 1; }
                                i += 1;
                            }
                        }
                    }
                }
            }
        }
    }
    return Model { todos: out, next_id: most };
}
===

===style.local
.list { list-style: none; margin: 0; padding: 0; }
.item { border-top: 1px solid var(--bx-line-soft); }
.item:first-child { border-top: 0; }
.pick { display: flex; align-items: center; gap: .65rem; width: 100%; padding: .6rem .1rem;
        font: inherit; color: inherit; text-align: left; background: none; border: 0; cursor: pointer; }
.pick::before { content: ""; width: 1.05rem; height: 1.05rem; flex: none; border-radius: 5px;
                border: 1.5px solid var(--bx-line); }
.pick.done::before { background: var(--bx-brand); border-color: var(--bx-brand); }
.pick.done { color: var(--bx-ink-faint); text-decoration: line-through; }
===

:props: model: Model
:!props:

:div: class=bx-card
    :div: class=bx-spread
        :h2: class=bx-title child={"Todos"} :!h2:
        :span: class="bx-badge bx-badge-quiet" child={to_string(len(model.todos)) + " items"} :!span:
    :!div:

    :hr: class=bx-divider :!hr:

    :ul: class=list
        :for: todo in model.todos key to_string(todo.id)
            :li: class=item
                :button: class={{ mark(todo.done) }} on:click=Msg.Toggle(string_to_int(key, 0))
                {{ todo.label }}
                :!button:
            :!li:
        :!for:
    :!ul:

    :div: class=bx-row
        :button: class="bx-btn bx-btn-primary" child={"add one"} on:click=Msg.Add :!button:
    :!div:
:!div:
