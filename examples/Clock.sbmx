.face  { font: 600 2.4rem/1 ui-monospace, monospace; color: #1f2430; letter-spacing: .04em; }
.count { font: 15px/1.5 ui-sans-serif, system-ui, sans-serif; color: #6b7280; margin: .3rem 0 .9rem; }
.go    { font: inherit; padding: .35rem .9rem; }
===

:props: model: Model
:!props:

:p: class=face child={label(model)} :!p:
:p: class=count child={to_string(model.ticks) + " ticks, asked of the server"} :!p:

:button: class=go child={button_text(model)} on:click=Msg.Toggle :!button:
