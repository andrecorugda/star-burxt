// examples/star/generate.bx — a BMX document becomes a star-burxt component.
//
//     burxt build examples/star/generate.bx -o star-generate
//     ./star-generate counter.bmx counter > counter.bx
//
// Emits a `pure function <name>(<props>) -> Html` and a
// `pure function <name>_dispatch(handler: Int, <props>) -> <state>`, then the
// COMPILER judges both — a typo in a slot, a wrong type in a handler, or an event
// this host cannot wire are all refused before anything reaches a page.
// A package's own module by relative path; the standard library through `std/`.
use "../star.bx";
use "../resolve.bx";
use "std/os.bx";
use "std/files.bx";

if os_arg_count() < 3 {
    print_error("usage: star-generate <document.bmx> <component-name>");
    exit(2);
}

let path: String = os_arg(1);
let name: String = os_arg(2);

// ---- resolving components ---------------------------------------------------------------------
//
// **This is where file reading lives, and star.bx has none.** A `use "./Badge.sbmx";` in the
// `===bx` section names a component; the driver generates it, learns its props, and hands both to
// `star_generate`. That split is what lets a component call be built in the CALLEE's declared
// order instead of the order the author typed — positional arguments in writing order would swap
// two props of the same type in silence.
//
// Paths resolve relative to the importing document, which is why generated `.bx` files are written
// beside their source: a `use "./types.bx"` in a component has to mean what its author meant.
match file_read_maybe(path) {
    None => { print_error("cannot read " + path); exit(2); }
    Some(source) => {
        // Components resolved and generated by the shared function — see `resolve.bx` for why it is
        // shared rather than written here.
        let known: [StarKnown] = star_resolve(path, source, true);
        match star_generate(source, name, known) {
            Error(message) => { print_error(message); exit(1); }
            Ok(component) => {
                // The page's stylesheet: its own rules, and an `@import` per component it
                // uses, so one <link> loads the tree. Written beside the source like everything
                // else, because a relative `@import` has to mean what its author meant.
                let mutable sheet: String = "";
                let mutable si: Int = 0;
                while si < len(known) {
                    sheet = sheet + "@import \"./" + known[si].name + ".css\";\n";
                    si += 1;
                }
                sheet = sheet + component.style;
                if len(bmx_strip_end(sheet)) > 0 {
                    let wrote_css: Int = file_write(star_without_extension(path) + ".css", sheet);
                }
                print("// GENERATED from " + path + " by star-burxt. Do not edit.");
                print("//");
                print("// The view and the dispatch are both `pure`, so `burxt effects --allow \"\"`");
                print("// confirms this component reaches nothing. A handler is an expression");
                print("// producing the next state — there are no closures to hide it in.");
                // **`use` lines lead the file, so the author's imports are hoisted out of the
                // `===bx` section and emitted first.** Burxt scans only the leading lines for
                // imports — a `use` after a declaration is a syntax error — so a component's
                // `use "./Badge.sbmx"` cannot simply sit where it was written.
                print(star_source_of(component, name));
                // The runtime entry point, emitted rather than hand-written so the
                // per-frame region and the host call cannot be got wrong by a user.
                print("// ---- the runtime entry point, emitted -------------------------------");
                print("//");
                print("// `host_mount` is called INSIDE the frame region, and that is not a style");
                print("// choice: the compiler refuses to let a String built in a region outlive");
                print("// the block, so the host must take the bytes before the close. One region");
                print("// per frame is what keeps a long-lived page inside a 16 MB linear memory —");
                print("// measured at 1,000,000 frames, where a flat render died at 50,000.");
                print("external function host_mount(html: String) -> CInt;");
                print("");
                print("function " + name + "_render(" + component.props + ") -> Int \{");
                print("    region frame \{");
                print("        let html: String = html_render(" + name + "(" + component.argument_list + "));");
                print("        let sent: Int = host_mount(html);");
                print("        return len(html);");
                print("    \}");
                print("\}");

                // ---- the STATEFUL entry point, when the component can carry its own state ------
                //
                // **Nothing in Burxt holds state between two calls** — a function sees its
                // arguments and nothing else, which is what makes `pure` mean anything. So a model
                // that is a record cannot live in the module between events: it has to cross the
                // boundary, and only text does that today.
                //
                // A component that declares `to_text` and `from_text` gets a driver that carries
                // it. One that does not gets exactly what it got before, which is why this is
                // additive rather than a new mode.
                //
                // **The state goes OUT the way HTML does — through a host call, never a return.**
                // A String built in a region cannot outlive the block, so the host takes the bytes
                // before the close. That is the same constraint `host_mount` was written for, and
                // the reason both calls sit inside the region.
                if star_mentions(component.code, "function to_text(")
                    && star_mentions(component.code, "function from_text(") {
                    print("");
                    print("// ---- carrying the state, because nothing here can hold it ----------");
                    print("external function host_state(text: String) -> CInt;");
                    print("");
                    print("function " + name + "_first(state: String) -> Int \{");
                    print("    region frame \{");
                    print("        let m: Model = from_text(state);");
                    print("        let html: String = html_render(" + name + "(m));");
                    print("        let sent: Int = host_mount(html);");
                    print("        return len(html);");
                    print("    \}");
                    print("\}");
                    print("");
                    // ---- commands, subscriptions and the one inbox ------------------------
                    //
                    // Each is emitted only if the component declared the function it needs, so a
                    // document that does not fetch carries no fetching code and the driver finds no
                    // export to call.
                    //
                    // **The step is PER HANDLER, and that is not a style choice.** The obvious shape
                    // is a `handler -> Msg` function the other entry points share — and it cannot be
                    // written, because it would need a `Msg` to return for an index that does not
                    // exist, and no such message exists in the author's enum. So the handler table
                    // produces the message where it already knows it, and everything downstream
                    // takes a `Msg` rather than a number.
                    let has_commands: Bool = star_mentions(component.code, "function commands(");
                    let has_watch: Bool = star_mentions(component.code, "function watch(");
                    let has_arrived: Bool = star_mentions(component.code, "function arrived(");
                    if has_commands {
                        print("");
                        print("external function host_command(line: String) -> CInt;");
                    }
                    if has_watch {
                        print("");
                        print("external function host_watch(line: String) -> CInt;");
                    }
                    print("");
                    print("// The state out and the page out, which every path ends with.");
                    print("function " + name + "_settle(next: Model) -> Int \{");
                    print("    let kept: Int = host_state(to_text(next));");
                    print("    let html: String = html_render(" + name + "(next));");
                    print("    let sent: Int = host_mount(html);");
                    print("    return len(html);");
                    print("\}");
                    print("");
                    print("// One message: the next state, then whatever the driver should go and do.");
                    print("function " + name + "_step(msg: Msg, m: Model) -> Int \{");
                    print("    let next: Model = update(msg, m);");
                    print("    let shown: Int = " + name + "_settle(next);");
                    if has_commands {
                        print("    let list: [StarCmd] = commands(msg, next);");
                        print("    let mutable i: Int = 0;");
                        print("    while i < len(list) \{");
                        print("        let asked: Int = host_command(star_cmd_text(list[i]));");
                        print("        i += 1;");
                        print("    \}");
                    }
                    if has_watch {
                        print("    let watched: [StarWatch] = watch(next);");
                        print("    let mutable w: Int = 0;");
                        print("    while w < len(watched) \{");
                        print("        let asked: Int = host_watch(star_watch_text(watched[w]));");
                        print("        w += 1;");
                        print("    \}");
                    }
                    print("    return shown;");
                    print("\}");
                    if has_arrived {
                        print("");
                        print("// THE ONE INBOX. A fetch completing and a timer firing are the same");
                        print("// kind of event, and the tag is the one the author chose — so nothing");
                        print("// has to know the handler indices star assigns.");
                        print("function " + name + "_arrived(tag: Int, value: String, state: String) -> Int \{");
                        print("    region frame \{");
                        // Bound to a local before returning, not for style: returning the call
                        // directly is refused — *cannot return this Int: it was built inside a
                        // `region` block* — because the analysis reads the expression's origin
                        // rather than its type. A scalar through a `let` is the spelling that says
                        // what is meant.
                        // **`return 0` rather than the length, and that is a WORKAROUND.**
                        // Returning the settle call's `Int` is refused — *cannot return this Int: it
                        // was built inside a `region` block* — because the rule taints the result of
                        // an allocating call regardless of its type, and an `Int` has no storage to
                        // outlive anything. Reported with a 17-line reproduction. The number is a
                        // page length nobody reads, so the workaround costs nothing.
                        print("        let shown: Int = " + name + "_settle(arrived(tag, value, from_text(state)));");
                        print("        return 0;");
                        print("    \}");
                        print("\}");
                    }
                    if has_watch {
                        print("");
                        print("// What to listen to, asked without an event — the driver calls this");
                        print("// once at startup so the first frame's subscriptions exist.");
                        print("function " + name + "_watch(state: String) -> Int \{");
                        print("    region frame \{");
                        print("        let list: [StarWatch] = watch(from_text(state));");
                        print("        let mutable i: Int = 0;");
                        print("        while i < len(list) \{");
                        print("            let asked: Int = host_watch(star_watch_text(list[i]));");
                        print("            i += 1;");
                        print("        \}");
                        print("        return len(list);");
                        print("    \}");
                        print("\}");
                    }
                    // ---- the server half ---------------------------------------------------
                    //
                    // A component that declares `load` gets a native entry point: a request in, a
                    // whole page out, with the state embedded so the client picks up the SAME value
                    // rather than fetching it again.
                    //
                    // **`load` may reach the network and the view may not**, and that is a signature
                    // rather than a convention. `pure function view` cannot call anything impure —
                    // the compiler refuses it — so a page cannot fetch while it renders, which is
                    // the bug class every server-rendering framework has.
                    if star_mentions(component.code, "function load(") {
                        print("");
                        print("// ---- served on the server, where `load` may reach things --------");
                        print("//");
                        print("// The state travels WITH the page. A client that had to fetch it again");
                        print("// would render twice and could render differently the second time —");
                        print("// which is the hydration mismatch this design does not have, because");
                        print("// both sides run the same compiled component over the same value.");
                        // **A WHOLE DOCUMENT, not a fragment.** The first version returned the
                        // root div and the state, which left the reader to hand-write the page
                        // around it — a `<head>`, a `<link>` to the stylesheet star itself wrote,
                        // and the four lines that mount the driver. Andre asked why a page needed
                        // hand-written HTML at all when star knows every one of those answers, and
                        // the honest reply was that it did not.
                        //
                        // So the head is emitted here: the component's own stylesheet, whatever its
                        // `head` function returns, and nothing else. A component that wants a title,
                        // a description or an Open Graph tag writes them in `head` as markup, which
                        // is the point of having one.
                        print("function " + name + "_serve(request: String) -> String touches network, files, clock \{");
                        print("    let m: Model = load(request);");
                        print("    let state: String = to_text(m);");
                        print("    let body: String = html_render(" + name + "(m));");
                        // `head` returns a LIST, for the same reason `commands` and `watch` do:
                        // there is nothing to wrap a title and three meta tags in. A single-node
                        // signature forced the component to invent a wrapper element, and the
                        // wrapper is then in the page.
                        print("    let mutable top: String = \"\";");
                        if star_mentions(component.code, "function head(") {
                            print("    let tags: [Html] = head(m);");
                            print("    let mutable ti: Int = 0;");
                            print("    while ti < len(tags) \{ top = top + html_render(tags[ti]) + \"\\n\"; ti += 1; \}");
                        }
                        print("    return \"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n\"");
                        print("        + \"<meta charset=\\\"utf-8\\\">\\n\"");
                        print("        + \"<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n\"");
                        print("        + top");
                        print("        + \"<link rel=\\\"stylesheet\\\" href=\\\"./" + name + ".css\\\">\\n\"");
                        print("        + \"</head>\\n<body>\\n\"");
                        print("        + \"<div id=\\\"root\\\">\" + body + \"</div>\\n\"");
                        print("        + \"<script type=\\\"application/json\\\" id=\\\"star-state\\\">\"");
                        print("        + state + \"</script>\\n\"");
                        print("        + \"<script type=\\\"module\\\">\\n\"");
                        print("        + \"import \\\{ mount \\\} from './app.js';\\n\"");
                        print("        + \"import \\\{ reconcile \\\} from './reconcile.js';\\n\"");
                        print("        + \"await mount(\\\{ wasm: new URL('./" + name + ".wasm', import.meta.url),\\n\"");
                        print("        + \"  root: document.getElementById('root'), component: '" + name + "',\\n\"");
                        print("        + \"  initial: document.getElementById('star-state').textContent.trim(), reconcile \\\});\\n\"");
                        print("        + \"</script>\\n</body>\\n</html>\\n\";");
                        print("\}");
                    }
                    print("// One event: the state in as text, the next state and the page out.");
                    print("function " + name + "_frame(handler: Int, key: String, value: String, state: String) -> Int \{");
                    print("    region frame \{");
                    print("        let m: Model = from_text(state);");
                    let mutable hi: Int = 0;
                    while hi < len(component.handlers) {
                        print("        if handler == " + to_string(hi) + " \{ let shown: Int = " + name
                            + "_step(" + component.handlers[hi].expression + ", m); return 0; \}");
                        hi += 1;
                    }
                    print("        return 0;");
                    print("    \}");
                    print("\}");
                }
            }
        }
    }
}
